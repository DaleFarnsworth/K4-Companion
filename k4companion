        self.server = caller.server

        font = options['font']
        width = options['width']
        bg = options['bg']
        fg = options['fg']
        abg = options['abg']
        afg = options['afg']

        text = str(options.get('text', ''))
        cmd = options.get('cmd', None)
        justify = options.get('justify', 'center')

        if cmd != None:
            command = lambda: self.server.expand_and_send_cmds(cmd)
        else:
            command = None

        button = QPushButton(text)
        button.setFont(font)
        if width:
            button.setMinimumWidth(width * QFontMetrics(font).averageCharWidth())
        button.setStyleSheet(qt_button_stylesheet(bg, fg, abg, afg))
        if command != None:
            button.clicked.connect(command)

        frame.layout().addWidget(button, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        self.button = button

