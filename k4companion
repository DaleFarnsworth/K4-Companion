_qt_font_weights = {'normal': QFont.Weight.Normal, 'bold': QFont.Weight.Bold}

def qt_font(family, size, weight='normal'):
    font = QFont(family, size)
    if isinstance(weight, str):
        weight = _qt_font_weights.get(weight, QFont.Weight.Normal)
    font.setWeight(weight)
    return font

def font_unit():
    family = QFontDatabase.systemFont(QFontDatabase.SystemFont.FixedFont).family()
    font = qt_font(family, 10)
    return QFontMetrics(font).averageCharWidth() / 8

class CompactStyle(QProxyStyle):
    # Every QGridLayout/QVBoxLayout/QHBoxLayout created without explicit
    # setContentsMargins()/setSpacing() falls back to these pixelMetric()
    # values from the current style. The stock margins/spacing (~11px and
    # ~6px) add up fast across the dozens of nested frames this app uses
    # (every qt_group_box(), every Container/Group/Page), producing far
    # more whitespace than tk's tightly-packed originals had. Tightening
    # the metrics here affects every layout in the app at once, instead
    # of hunting down each construction site individually.
    _compact_metrics = {
        QStyle.PixelMetric.PM_LayoutLeftMargin: 2,
        QStyle.PixelMetric.PM_LayoutRightMargin: 2,
        QStyle.PixelMetric.PM_LayoutTopMargin: 2,
        QStyle.PixelMetric.PM_LayoutBottomMargin: 2,
        QStyle.PixelMetric.PM_LayoutHorizontalSpacing: 2,
        QStyle.PixelMetric.PM_LayoutVerticalSpacing: 2,
    }

    def pixelMetric(self, metric, option=None, widget=None):
        compact = self._compact_metrics.get(metric)
        if compact is not None:
            return compact
        return super().pixelMetric(metric, option, widget)

class _TightComboBoxDelegate(QStyledItemDelegate):
    # A combobox popup's default per-item height is far more generous
    # than plain text needs -- same idea as CompactStyle above, but
    # that can't fix this one: this height comes from QStyle's
    # CT_ItemViewItem contents sizing, which (at least on the styles
    # this app has been tested against) doesn't route through the
    # widget's own stylesheet at all -- so QSS's ::item { padding: }
    # (or even min-height:) on a combobox has no effect whatsoever on
    # the popup's actual row height, confirmed against real values, not
    # just theory. Overriding sizeHint() directly, bypassing the style
    # entirely, is the one thing that reliably works.
    def sizeHint(self, option, index):
        size = super().sizeHint(option, index)
        # No added constant -- just the font's own line height, exactly
        # enough for one line of text and nothing more. An earlier
        # version added a few px on top of this, which (on at least
        # some platforms/styles) turned out to be *more* than several
        # comboboxes' own previous native height, making things worse
        # rather than better for them.
        size.setHeight(QFontMetrics(option.font).height())
        return size

_tight_combobox_delegate = _TightComboBoxDelegate()

def qt_tighten_combobox_popup(combobox):
    combobox.setItemDelegate(_tight_combobox_delegate)

def qt_tight_groupbox_stylesheet(title, font):
    # QGroupBox's native title area reserves far more vertical space than
    # the title text needs (independent of the layout's own
    # contentsMargins -- it comes from the style's own subControlRect
    # computation for CC_GroupBox). Qt only exposes control over that via
    # a stylesheet, which switches the box to the CSS box model -- so the
    # border/radius have to be spelled out here too, to keep the same
    # look. margin-top reserves the room *above* the border that QSS
    # paints the title into (subcontrol-origin: margin); too little clips
    # it against the widget's own top edge. Multi-line titles (e.g.
    # "K4-Companion\nVersion") measure and clip unpredictably under the
    # CSS box model, so those are left with Qt's native (more generous,
    # but reliably uncropped) title rendering instead.
    if '\n' in title:
        return ''
    title_height = QFontMetrics(font).height()
    margin_top = max(2, title_height - 2)
    return (
        'QGroupBox { border: 1px solid palette(mid); border-radius: 3px; '
        f'margin-top: {margin_top}px; padding-top: 0px; }}'
        'QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; '
        'left: 4px; top: 0px; padding: 0 2px; }'
    )

def qt_size_tight_groupbox_title(frame, title, font):
    # Once qt_tight_groupbox_stylesheet() switches a QGroupBox to the CSS
    # box model, its sizeHint() no longer widens to fit the title the way
    # native title rendering did -- a box whose content is narrower than
    # its title (e.g. "QSK" wrapping a small toggle, or a long label:
    # like "K4-Companion Version") then clips the title on its right
    # edge. Force a minimum width covering the title text plus the
    # stylesheet's own "left: 4px" title offset, "padding: 0 2px" on the
    # title, and 1px border on each side.
    fm = QFontMetrics(font)
    frame.setMinimumWidth(fm.horizontalAdvance(title) + 12)

def qt_top_level_parent():
    # On Windows, any top-level widget created with a Qt parent becomes a
    # native "owned window", which Windows always keeps above its owner
    # in Z-order -- unlike X11 window managers, this isn't affected by
    # the Qt.WindowType passed in. Dropping the parent there is the only
    # way to get a genuinely independent window; elsewhere, keeping
    # Page.top as parent is harmless (and is relied on by the
    # Qt.WindowType.Window workaround for transient-for-parent window
    # managers).
    if sys.platform == 'win32':
        return None
    return Page.top

def qt_group_box(title, font):
    # Factors out the "tk.LabelFrame(text=, font=, labelanchor='nw', ...)"
    # pattern repeated dozens of times in ServerSettings_widget /
    # AppSettings_widget.
    frame = QGroupBox(title)
    frame.setFont(font)
    style = qt_tight_groupbox_stylesheet(title, font)
    if style:
        frame.setStyleSheet(style)
        qt_size_tight_groupbox_title(frame, title, font)
    grid = QGridLayout(frame)
    grid.setContentsMargins(0, 0, 0, 0)
    grid.setSpacing(0)
    return frame, grid

def qt_labeled_readonly_combobox(title, font, box_font, values, current_value, bg, fg, selectbg, selectfg, on_changed, justify='left'):
    frame, grid = qt_group_box(title, font)
    combobox = QComboBox()
    combobox.addItems([str(v) for v in values])
    combobox.setFont(box_font)
    combobox.view().setFont(box_font)
    if combobox.lineEdit() != None:
        combobox.lineEdit().setAlignment(qt_justify(justify))
    combobox.setStyleSheet(
        f'QComboBox {{ background-color: {bg}; color: {fg}; }}'
        f'QComboBox QAbstractItemView {{ background-color: {selectbg}; color: {selectfg}; }}')
    qt_tighten_combobox_popup(combobox)
    combobox.setCurrentText(str(current_value))
    grid.addWidget(combobox, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
    combobox.currentTextChanged.connect(on_changed)
    return frame, combobox

