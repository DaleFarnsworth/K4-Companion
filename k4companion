class Bargraph(Widget):
    def __init__(self, config_info, container):
        required = ['item']
        optional = ['cmd', 'response', 'evalresponse', 'orient', 'maximum',
            'evalmaximum', 'length', 'lengthpercent', 'thicknesspercent',
            'lefttext', 'bottomtext', 'evalbottomtext', 'label', 'leading',
            'bg', 'abg', 'fg', 'afg', 'font', 'id', 'padx', 'pady']
        validate_options(config_info, required, optional)

        super().__init__(config_info, container)

        self.cmd = config_info.get('cmd', None)
        self.response = config_info.get('response', self.cmd)
        self.evalresponse = config_info.get('evalresponse', self.response)
        orient = config_info.get('orient', 'horizontal')
        self.maximum = config_info.get('maximum', 100)
        self.evalmaximum = config_info.get('evalmaximum', None)
        self.length = config_info.get('length', 100)
        self.length_percent = config_info.get('lengthpercent', None)
        # Scales the bar's thickness (the dimension perpendicular to its
        # length -- height for horizontal, width for vertical) relative
        # to Qt's natural style-driven size, the same way lengthpercent
        # scales its length relative to the bottomtext width. None
        # (the default) leaves the natural thickness untouched.
        self.thickness_percent = config_info.get('thicknesspercent', None)

        self.left_text = config_info.get('lefttext', '')
        self.bottomtext = config_info.get('bottomtext', '')
        self.evalbottomtext = config_info.get('evalbottomtext', None)

        bar_frame = QWidget()
        bar_grid = QGridLayout(bar_frame)
        bar_grid.setContentsMargins(0, 0, 0, 0)

        self.left_frame = QWidget()
        left_grid = QGridLayout(self.left_frame)
        left_grid.setContentsMargins(0, 2, 0, 2)
        if self.left_text != '':
            left_label = QLabel(self.left_text)
            left_label.setFont(self.font())
            left_label.setStyleSheet(f'QLabel {{ color: {self.fg}; background-color: {self.bg}; }}')
            left_grid.addWidget(left_label, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        bar_grid.addWidget(self.left_frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        orientation = Qt.Orientation.Horizontal if orient == 'horizontal' else Qt.Orientation.Vertical
        self.progressbar = QProgressBar()
        self.progressbar.setOrientation(orientation)
        self.progressbar.setTextVisible(False)
        self.progressbar.setMaximum(round((self.maximum + .001) * 1000))
        if self.thickness_percent != None:
            if orientation == Qt.Orientation.Horizontal:
                natural = self.progressbar.sizeHint().height()
                self.progressbar.setFixedHeight(max(1, round(natural * self.thickness_percent / 100.0)))
            else:
                natural = self.progressbar.sizeHint().width()
                self.progressbar.setFixedWidth(max(1, round(natural * self.thickness_percent / 100.0)))
        if orientation == Qt.Orientation.Horizontal:
            self.progressbar.setFixedWidth(self.length)
        else:
            self.progressbar.setFixedHeight(self.length)

        bar_grid.addWidget(self.progressbar, 0, 1, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.frame.layout().addWidget(bar_frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.bottom_frame = QWidget()
        bottom_grid = QGridLayout(self.bottom_frame)
        bottom_grid.setContentsMargins(0, 2, 0, 2)
        if self.bottomtext != None or self.evalbottomtext != None:
            self.bottom_label = QLabel(self.bottomtext)
            self.bottom_label.setFont(self.font())
            self.bottom_label.setStyleSheet(f'QLabel {{ color: {self.fg}; background-color: {self.bg}; }}')
            bottom_grid.addWidget(self.bottom_label, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.frame.layout().addWidget(self.bottom_frame, 1, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.server.subscribe_connect(self.on_server_connect)
        self.server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def on_server_connect(self):
        self.server.expand_and_send_cmds(self.cmd)

    def on_received_initial_parameters(self, response):
        self.server.subscribe_response(self.response, self.on_response_received)

    def on_response_received(self, response):
        value = float(self.eval_value(self.evalresponse, response))
        self.progressbar.setValue(round(value * 1000))
        if self.server.connected:
            self.configure()

    def configure(self):
        bottomtext = self.bottomtext
        if self.evalbottomtext != None:
            bottomtext = self.eval_value(self.evalbottomtext, None)
        if hasattr(self, 'bottom_label'):
            self.bottom_label.setText(str(bottomtext))
        bottom_width = self.bottom_frame.sizeHint().width()
        left_width = self.left_frame.sizeHint().width()
        length = self.length
        if self.length_percent != None:
            length = (bottom_width - left_width) * self.length_percent / 100.0
            length = max(1, round(length))
        maximum = self.maximum
        if self.evalmaximum != None:
            maximum = float(self.eval_value(self.evalmaximum, None)) + .001
        if self.progressbar.orientation() == Qt.Orientation.Horizontal:
            self.progressbar.setFixedWidth(length)
        else:
            self.progressbar.setFixedHeight(length)
        self.progressbar.setMaximum(round(maximum * 1000))

