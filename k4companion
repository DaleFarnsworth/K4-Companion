    def on_tab_changed(self, index):
        super().on_tab_changed(index)
        if self.current_tabname == 'Configure':
            self.save_geometry()
            self.set_geometry()
        self.previous_tabname = self.current_tabname

    def set_geometry(self):
        Server.settings.load()
        geometry = Server.settings.get('Window', 'Macros.geometry')
        if geometry == None:
            return
        w, h, x, y = split_geometry(geometry)
        screen = QApplication.primaryScreen().availableGeometry()
        screen_width, screen_height = screen.width(), screen.height()
        x_offset = screen_width - (x + w)
        y_offset = screen_height - (y + h)
        if x_offset < 0:
            x += x_offset
        if y_offset < 0:
            y += y_offset
        if x < 0:
            x = 0
        if y < 0:
            y = 0
        self.top_level.move(x, y)

    def hide(self):
        if self.is_open:
            if self.k4param('!MACROS') != 'DISABLE':
                self.server.update_k4_parameter('!MACROS', 'DISABLE')
            self.top_level.hide()

    def show(self):
        if not self.is_open:
            self.open()
        if self.k4param('!MACROS') != 'ENABLE':
            self.server.update_k4_parameter('!MACROS', 'ENABLE')
        self.top_level.show()
        if self._geometry_needs_recheck:
            # See open()'s matching comment: this is the first real
            # show() after open()'s pre-show set_geometry(), so redo it
            # now that the WM has actually attached a frame -- deferred
            # to the next event loop iteration since the WM's reparent/
            # decorate happens asynchronously after show() returns, not
            # immediately. One-time only -- a later show() (after the
            # user's own hide()) must not re-snap back to the persisted
            # position.
            self._geometry_needs_recheck = False
            for geo_delay in (100, 250, 500, 1000):
                QTimer.singleShot(geo_delay, self.set_geometry)
        self.top_level.raise_()
        self.top_level.activateWindow()

    def close(self):
        if self.k4param('!MACROS') != 'DISABLE':
            self.server.update_k4_parameter('!MACROS', 'DISABLE')
        if not self.is_open:
            return
        self.is_open = False
        self.save_geometry()
        self.top_level.deleteLater()

    def save_geometry(self):
        top = self.top_level
        geometry = f'{top.width()}x{top.height()}{top.x():+}{top.y():+}'
        Server.settings.put_save('Window', 'Macros.geometry', geometry)

    def add_buttons(self, buttons, parent_frame, edit):
        if not edit:
            for shortcut in self._fkey_shortcuts:
                shortcut.setParent(None)
            self._fkey_shortcuts = []
        super().add_buttons(buttons, parent_frame, edit)

    def load_button_value(self, buttons, index, edit=False):
        super().load_button_value(buttons, index, edit=edit)
        if not edit:
            button = buttons[index]
            button.mousePressEvent = lambda event, index=index: self.send_button(index)
            if index < 12:
                # These are global shortcuts (bound to the main window, not
                # just this dialog) -- matches the tkinter version binding
                # the F-key on both its own top_level and on Page.top.
                shortcut = QShortcut(QKeySequence(f'F{index+1}'), Page.top)
                shortcut.activated.connect(lambda index=index: self.send_button(index))
                self._fkey_shortcuts.append(shortcut)

    def store_button_value(self, buttons, index):
        super().store_button_value(buttons, index)
        self.save_settings()

    def send_button(self, index):
        value = self.button_values[index]
        label = self.button_labels[index]
        if label == '':
            label = value
        if label != '':
            Popup.popup(label, timeout=500, color='white')

        if value == '':
            return
        if not value.endswith(';'):
            value += ';'
        self.server.send_cmds(value)

    def on_save_button(self):
        super().on_save_button()
        self.save_settings()
        self.select_tab('Macros')

    def on_cancel_button(self):
        super().on_cancel_button()
        self.select_tab('Macros')

    def load_settings(self):
        self.enabled = Server.settings.getbool(self.section, 'enabled', True)

        self.rows = Server.settings.getint(self.section, 'button_rows', 3, minimum=1, maximum=20)
        self.columns = Server.settings.getint(self.section, 'button_columns', 4, minimum=1, maximum=20)
        self.button_width = Server.settings.getint(self.section, 'button_width', 15, minimum=5, maximum=60)

        self.button_values = []
        self.button_labels = []
        buttons = Server.settings.get(self.section, 'buttons')
        if buttons != None:
            values = buttons.split('\n')
        else:
            values = ('Clear RIT/XIT & RC;RT0;XT0;', 'XIT +5 kHz & XT1;RO+5000;')
        for value in values:
            value = value.strip()
            fields = value.split('&', 1)
            if len(fields) == 2:
                label, value = fields
                label = label.strip()
                value = value.strip()
            else:
                label = ''
            self.button_values.append(value)
            self.button_labels.append(label)
        total_buttons = self.rows * self.columns
        while len(self.button_values) < total_buttons:
            self.button_values.append('')
            self.button_labels.append('')

    def save_settings(self):
        previous_settings = Server.settings.get_section(self.section)
        Server.settings.clear_section(self.section)

        Server.settings.put(self.section, 'button_rows', self.rows)
        Server.settings.put(self.section, 'button_columns', self.columns)
        Server.settings.put(self.section, 'button_width', self.button_width)

        values = []
        for i, value in enumerate(self.button_values):
            label = self.button_labels[i]
            if label != '':
                value = f'{label} & {value}'
            values.append(value)
        while True:
            ln = len(values)
            if ln <= 0:
                break
            if values[ln-1] != '':
                break
            values.pop()
        buttons = '\n '.join(values)
        Server.settings.put(self.section, 'buttons', buttons)

        settings = Server.settings.get_section(self.section)
        if settings != previous_settings:
            Server.settings.save()

class MidiInput():
    singleton = None
    poll_interval = 1000        # check for new devices every 1 seconds
    midiin = None
    port_names = None
    port_name = 'None'
    port_updater = None
    port_serial_number = 0
    previous_port_serial_number = -1
    message_callback = None

    @classmethod
    def get_singleton(cls):
        if cls.singleton == None:
            cls.singleton = MidiInput()

        return cls.singleton

    @classmethod
    def open(cls):
        cls.get_singleton()

    @classmethod
    def close(cls):
        if not cls.singleton:
            return
        Poll.remove(cls.singleton.poll_new_device)
        cls.midiin.close_port()
        cls.singleton = None

    @classmethod
    def set_port_name(cls, name):
        cls.port_name = name
        cls.port_serial_number += 1
        Settings.main().put_save('Keyer', 'midi_input_device', name)

    @classmethod
    def available_ports(cls):
        return cls.port_names

    @classmethod
    def set_port_updater(cls, port_updater):
        cls.port_updater = port_updater

    @classmethod
    def set_message_callback(cls, callback):
        cls.message_callback = callback
        self = cls.get_singleton()
        self.midiin.set_callback(cls.message_callback)

    @classmethod
    def cancel_message_callback(cls):
        self = cls.get_singleton()
        if self:
            self.midiin.cancel_callback()

    @classmethod
    def get_message(cls):
        return cls.midiin.get_message()

    def __init__(self):
        self.__class__.midiin = rtmidi.MidiIn()
        port_name = Settings.main().get('Keyer', 'midi_input_device', 'None')
        self.__class__.set_port_name(port_name)
        self.warned = False
        Poll.add(self.poll_interval, self.poll_new_device)

    def poll_new_device(self):
        if not Keyer.device_type_MoMIDI:
            return

        # Do we need to close/reopen if the port_index changes?
        cls = self.__class__

        port_names = self.midiin.get_ports()
        if port_names != self.port_names:
            cls.port_names = port_names
            if cls.port_updater != None:
                cls.port_updater()

        if self.port_name == 'None':
            cls.previous_port_serial_number = -1
            self.midiin.close_port()
            return

        port_index = -1
        try:
            port_index = self.port_names.index(self.port_name)
        except:
            self.midiin.close_port()
            cls.previous_port_serial_number = -1
            if not self.warned:
                self.warned = True
                Popup.warning("Midi device {name} not found".format(name=self.port_name))

        if port_index >= 0 and cls.port_serial_number != cls.previous_port_serial_number:
            self.warned = False
            self.midiin.close_port()
            self.midiin.open_port(port_index)
            cls.previous_port_serial_number = cls.port_serial_number

            if Keyer.device_type_vail_adapter:
                VailAdapter.open_output(self.port_name)
            else:
                VailAdapter.close_output()

            self.midiin.set_callback(self.message_callback)

class VailAdapter():
    midiout = None

    keyer_modes = (
        'Passthrough',
        'Straight Key (cootie)',
        'Bug (semi-automatic)',
        'Electric Bug',
        'Single Dot',
        'Ultimatic',
        'Plain Iambic',
        'Iambic A',
        'Iambic B',
        'Keyahead',
    )

    @classmethod
    def open_output(cls, devname):
        if cls.midiout:
            cls.close_output()

        cls.midiout = rtmidi.MidiOut()
        ports = cls.midiout.get_ports()
        for port, name in enumerate(ports):
            if name == devname:
                cls.midiout.open_port(port)
                while True:
                    cls.send_initial_state()
                    time.sleep(.1)
                    if MidiInput.get_message():
                        break
                return
        Popup.warning(f'Vail Adapter {devname} not found')
        del cls.midiout
        cls.midiout = None

    @classmethod
    def close_output(cls):
        if cls.midiout:
            del cls.midiout
        cls.midiout = None

    @classmethod
    def send_message(cls, msg):
        if cls.midiout:
            cls.midiout.send_message(msg)

    @classmethod
    def send_set_midi_mode(cls):
        cls.send_message([0xB0, 0, 0])

    @classmethod
    def send_pitch(cls):
        pitch = Server.k4_server.k4_parameter('CW')
        if not pitch:
            return
        pitch = int(pitch) * 10
        note = round(69 + 12 * math.log2(pitch/440))
        cls.send_message([0xB0, 2, note])

    @classmethod
    def send_keyer_speed(cls):
        wpm = Server.k4_server.k4_parameter('KS')
        if not wpm:
            return
        wpm = int(wpm)
        dit_len = 1200/wpm
        val = round(dit_len/2)
        cls.send_message([0xB0, 1, val])

    @classmethod
    def send_keyer_mode(cls):
        for i, mode in enumerate(cls.keyer_modes):
            if mode == Keyer.keyer_mode:
                keyer_mode = i
                break
        else:
            keyer_mode = 0

        cls.send_message([0xC0, keyer_mode])

    @classmethod
    def send_request_midi_timing(cls):
        cls.send_message([0xB0, 3, 0x7f])

    @classmethod
    def send_initial_state(cls):
        cls.send_set_midi_mode()
        cls.send_pitch()
        cls.send_keyer_speed()
        cls.send_keyer_mode()
        cls.send_request_midi_timing()

class SerialInput():
    singleton = None
    poll_interval = 1000        # check for new devices every 1 seconds
    port_infos = None
    port_names = None
    bad_port_name_dict = {}
    port_name = 'None'
    port = None
    port_updater = None
    port_serial_number = 0
    previous_port_serial_number = -1
    message_callback = None
    dit_state = False
    dah_state = False
    dit_time = None
    dah_time = None
    previous_dit_time = None
    previous_dah_time = None

    @classmethod
    def get_singleton(cls):
        if cls.singleton == None:
            cls.singleton = SerialInput()

        return cls.singleton

    @classmethod
    def open(cls):
        cls.get_singleton()

    @classmethod
    def close(cls):
        self = cls.singleton
        if not self:
            return
        cls.singleton = None
        Poll.remove(self.poll_new_device)
        self.close_port()

    @classmethod
    def set_port_name(cls, name):
        cls.port_name = name
        cls.port_serial_number += 1
        Settings.main().put_save('Keyer', 'serial_input_device', name)

    @classmethod
    def available_ports(cls):
        if not cls.port_names:
            return None
        names = []
        for name in cls.port_names:
            if name not in cls.bad_port_name_dict:
                names.append(name)

        return names

    @classmethod
    def set_port_updater(cls, port_updater):
        cls.port_updater = port_updater

    @classmethod
    def set_message_callback(cls, callback):
        cls.message_callback = callback

    @classmethod
    def cancel_message_callback(cls):
        cls.message_callback = None

    def __init__(self):
        port_name = Settings.main().get('Keyer', 'serial_input_device', 'None')
        self.__class__.set_port_name(port_name)
        self.warned = False
        self.mark_bad_devices()
        Poll.add(self.poll_interval, self.poll_new_device)

    def mark_bad_devices(self):
        port_infos = serial.tools.list_ports.comports()
        port_names = [info.device for info in sorted(port_infos)]
        for port_name in port_names:
            try:
                port = serial.Serial(port_name, rtscts=False, dsrdtr=False)
                port.close()
            except serial.SerialException:
                self.__class__.bad_port_name_dict[port_name] = True

    def open_port(self, name):
        try:
            self.port = serial.Serial(self.port_name, rtscts=False, dsrdtr=False)
        except serial.SerialException:
            if not self.warned:
                self.warned = True
                Popup.warning("Serial device {name} open failed".format(name=self.port_name))
                return

        self.warned = False
        self.signal_thread = threading.Thread(target=self.signal_loop, name='serial_signal_thread')
        self.signal_thread.start()

    def poll_new_device(self):
        if not Keyer.device_type_serial:
            return
        # Do we need to close/reopen if the port_index changes?
        cls = self.__class__

        port_infos = serial.tools.list_ports.comports()
        if port_infos != self.port_infos:
            cls.port_infos = port_infos
            cls.port_names = [info.device for info in sorted(port_infos)]
            if cls.port_updater != None:
                cls.port_updater()

        if self.port_name == 'None':
            return

        port_index = -1
        try:
            port_index = cls.port_names.index(self.port_name)
        except:
            cls.previous_port_serial_number = -1
            if not self.warned:
                self.warned = True
                Popup.warning("Serial device {name} not found".format(name=self.port_name))

        if port_index >= 0 and cls.port_serial_number != cls.previous_port_serial_number:
            self.warned = False
            self.close_port()
            self.open_port(self.port_name)
            cls.previous_port_serial_number = cls.port_serial_number

    def close_port(self):
        if self.port != None:
            self.port.close()
            self.port = None
            self.signal_thread.join()

    def rts(self):
        return self.port.rts

    def cts(self):
        return self.port.cts

    def dtr(self):
        return self.port.dtr

    def dsr(self):
        return self.port.dsr

    def ri(self):
        return self.port.ri

    def cd(self):
        return self.port.cd

    def signal_loop(self):
        signal_funcs = {
            'CTS': self.cts,
            'DCD': self.cd,
            'DSR': self.dsr,
            'RI': self.ri,
        }

        port_name = self.port_name

        debounce_time = 0
        if Keyer.straight_keying:
            debounce_time = .020

        while port_name == self.port_name and self.port:
            try:
                dit_state = signal_funcs[Keyer.dit_paddle_signal]()
                dah_state = signal_funcs[Keyer.dah_paddle_signal]() and not Keyer.straight_keying
            except (OSError, AttributeError):
                return              # port was closed just before reading the signal

            if dit_state != self.dit_state:
                self.dit_time = time.perf_counter()
                self.dit_state = dit_state
            if dah_state != self.dah_state:
                self.dah_time = time.perf_counter()
                self.dah_state = dah_state
            if self.dit_time:
                now = time.perf_counter()
                if now - self.dit_time >= debounce_time:
                    if self.previous_dit_time:
                        delta_time = self.dit_time - self.previous_dit_time
                    else:
                        delta_time = 0
                    if self.message_callback:
                        message = (Keyer.dit_paddle_signal, dit_state)
                        self.message_callback((message, delta_time))
                    self.previous_dit_state = dit_state
                    self.previous_dit_time = self.dit_time
                    self.dit_time = None
            if self.dah_time:
                now = time.perf_counter()
                if now - self.dah_time >= debounce_time:
                    if self.previous_dah_time:
                        delta_time = self.dah_time - self.previous_dah_time
                    else:
                        delta_time = 0
                    if self.message_callback:
                        message = (Keyer.dah_paddle_signal, dah_state)
                        self.message_callback((message, delta_time))
                    self.previous_dah_state = dah_state
                    self.previous_dah_time = self.dah_time
                    self.dah_time = None

            time.sleep(.001)

