        self.set_k4_equalizer()
        self.save_settings()

    def on_tr_mode_changed(self, text):
        self.configure()
        self.set_k4_equalizer()
        self.save_settings()

    def on_k4_mode_changed(self, response):
        mode = self.k4_mode()
        if mode == None or mode == '':
            return

        self.active_tr_label.setText(self.k4_tr())
        self.active_mode_label.setText(mode)
        self.set_k4_equalizer()
        self.configure()

    def on_set_flat(self):
        alt, tr, mode = self.alt_tr_mode()
        self.values[alt][tr][mode] = [0, 0, 0, 0, 0, 0, 0, 0]

        self.set_k4_equalizer()
        self.configure()
        self.save_settings()

    def on_add_alt(self):
        alt = self.add_entry.text()
        if alt in self.alternates + ['Flat']:
            return
        self.alternates.append(alt)
        self.values[alt] = {}
        for tr in self.trs:
            self.values[alt][tr] = {}
            for mode in self.modes:
                self.values[alt][tr][mode] = [0, 0, 0, 0, 0, 0, 0, 0]
        self._reload_combobox_items(self.alt_combobox, self.alternates)
        self.alt_combobox.setCurrentText(alt)
        self.add_entry.setText('')
        self.configure()
        self.save_settings()

    def on_remove_alt(self):
        alt = self.alt_combobox.currentText()
        if alt == 'Main':
            return

        self.alternates.remove(alt)
        del self.values[alt]

        alt = self.alternates[0]
        self._reload_combobox_items(self.alt_combobox, self.alternates)
        self.alt_combobox.setCurrentText(alt)

        self.configure()
        self.set_k4_equalizer()
        self.save_settings()

    def on_vfo_changed(self, text):
        self.set_k4_equalizer()
        self.configure()
        self.save_settings()

    def configure(self):
        self.enabled_button.setText('Enabled' if self.enabled() else 'Disabled')

        alts = self.alternates + ['Flat']
        self._reload_combobox_items(self.active_alt_combobox, alts)

        alt, tr, mode = self.alt_tr_mode()
        for i, value in enumerate(self.values[alt][tr][mode]):
            if value != self.scales[i].value():
                self.scales[i].setValue(value)

        if alt == 'Main' or alt == self.active_alt_combobox.currentText():
            self.remove_button.setText('')
            self.remove_button.setEnabled(False)
        else:
            text = 'Remove: ' + alt
            self.remove_button.setText(text)
            self.remove_button.setEnabled(True)

        alt_tr_mode = self.join_alt_tr_mode(alt, tr, mode)
        self.equalizer_frame.setTitle(alt_tr_mode)

        self._reload_combobox_items(self.alt_combobox, self.alternates)

        tr_modes = [self.join_tr_mode(tr, mode) for tr in self.trs for mode in self.modes]
        self._reload_combobox_items(self.tr_mode_combobox, tr_modes)

    def save_settings(self):
        section = 'Equalizers'
        previous_settings = Server.settings.get_section(section)
        Server.settings.clear_section(section)

        Server.settings.put(section, 'enabled', str(int(self.enabled())))
        Server.settings.put(section, 'active', self.active_alt_combobox.currentText())
        Server.settings.put(section, 'alternates', ', '.join(self.alternates))
        Server.settings.put(section, 'alt.tr.mode', '.'.join(self.alt_tr_mode()))

        for alt in self.alternates:
            for tr in self.trs:
                for mode in self.modes:
                    setting = '.'.join((alt, tr, mode))
                    values = self.values[alt][tr][mode]
                    values_str = self.values_str(values)
                    Server.settings.put(section, setting, values_str)

        settings = Server.settings.get_section(section)
        if settings != previous_settings:
            Server.settings.save()

    def load_settings(self):
        section = 'Equalizers'
        enabled = Server.settings.get(section, "enabled")
        if enabled == None:
            enabled = 0
        self.enabled_val = int(enabled)

        active = Server.settings.get(section, 'active')
        if active == None:
            active = self.alternates[0]
        self.active_alt = active

        vfo = Server.settings.get(section, 'follows_vfo')
        if vfo == None:
            vfo = 'A'
        self.vfo = vfo

        alternates = Server.settings.get(section, 'alternates')
        if alternates == None:
            alternates = 'Main'
        self.alternates = alternates.split(', ')

        alt_tr_mode = Server.settings.get(section, 'alt.tr.mode')
        if alt_tr_mode == None:
            alt = self.alternates[0]
            tr = self.trs[0]
            mode = self.modes[0]
        else:
            alt, tr, mode = alt_tr_mode.rsplit('.', 2)
        self.alt = alt
        self.initial_tr_mode = self.join_tr_mode(tr, mode)

        for alt in self.alternates + ['Flat']:
            self.values[alt] = {}
            for tr in self.trs:
                self.values[alt][tr] = {}
                for mode in self.modes:
                    setting = '.'.join((alt, tr, mode))
                    values_str = Server.settings.get(section, setting)
                    if values_str != None:
                        self.values[alt][tr][mode] = self.str_values(values_str)
                    else:
                        self.values[alt][tr][mode] = [0, 0, 0, 0, 0, 0, 0, 0]

def cmd_base(cmd):
    ucmd = cmd.upper()
    base = ucmd[0:2]
    if base in Server.k4_long_cmd_bases:
        for long_base in Server.k4_long_cmd_bases[base]:
            if ucmd.startswith(long_base):
                base = long_base
                break

    if len(cmd) > len(base):
        if cmd[len(base)] == '$':
            base += '$'

    if len(cmd) > len(base):
        if cmd[len(base)] == '!':
            base += '!'

    return base

def cmd_parameter(response):
    i = len(cmd_base(response))
    return response[i:].rstrip(';').upper()

def true_values(v):
    if v == True or v == 1:
        return True

    if not isinstance(v, str):
        return False

    v = v.lower()
    return v == 'true' or v == 'on' or v == '1' or v == 'yes'

