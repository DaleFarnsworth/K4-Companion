    def _size_cw_text(self, cw_text, height_lines):
        cw_text.max_lines = height_lines
        fm = QFontMetrics(self.monospaced_font)
        cw_text.setFixedHeight(height_lines * fm.height() + 10)
        cw_text.setFixedWidth(self.text_width * fm.averageCharWidth() + 10)

    def _widget_overflowing(self, cw_text, max_lines):
        total_lines = 0
        block = cw_text.document().firstBlock()
        while block.isValid():
            layout = block.layout()
            n = layout.lineCount() if layout != None and layout.lineCount() > 0 else 1
            total_lines += n
            block = block.next()
        return total_lines > max_lines

    def _set_underline_position(self, cw_text, position):
        doc = cw_text.document()
        clear_fmt = QTextCharFormat()
        clear_fmt.setFontUnderline(False)
        cursor = QTextCursor(doc)
        cursor.select(QTextCursor.SelectionType.Document)
        cursor.mergeCharFormat(clear_fmt)

        text_len = len(cw_text.toPlainText())
        if position < 0 or position >= text_len:
            return
        underline_fmt = QTextCharFormat()
        underline_fmt.setFontUnderline(True)
        cursor = QTextCursor(doc)
        cursor.setPosition(position)
        cursor.setPosition(position + 1, QTextCursor.MoveMode.KeepAnchor)
        cursor.mergeCharFormat(underline_fmt)

