class DigitEntry(QLineEdit):
    # VFO/RIT display a fixed-width, right-justified numeric string where
    # each character column corresponds to a tuning step size: clicking a
    # digit selects that step, and the digit under the current step is
    # underlined. The tkinter version built this by abusing a tk.Text
    # widget's tag system (tag_bind per column, an 'underline' tag). Qt has
    # no equivalent widget, so this reimplements the same interaction
    # model directly: mousePressEvent maps a click x-position to a
    # character column via cumulative font-metric widths, and paintEvent
    # draws the underline at that column's position.
    LEFT_MARGIN = 2
    RIGHT_MARGIN = 2

    def __init__(self, width, parent=None):
        super().__init__(parent)
        self.digit_width = width
        self.step_columns = {}       # step -> set of character column indices
        self.underline_column = None
        self.on_step_click = None
        self.on_change_step = None
        self.on_bump = None
        self.on_jump = None
        self.on_wheel = None
        self.on_validate = None      # called as on_validate(send: bool)
        self.on_space = None
        self.setAlignment(Qt.AlignmentFlag.AlignRight)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setTextMargins(self.LEFT_MARGIN, 0, self.RIGHT_MARGIN, 0)

    def sizeHint(self):
        # Plain QLineEdit's sizeHint() assumes ~17 generic characters --
        # far more than this widget ever displays (digit_width, e.g. 9 for
        # "14100.000"). At VFO's large point size that mismatch is huge,
        # so size to what's actually shown instead.
        fm = self.fontMetrics()
        text_width = fm.horizontalAdvance('0' * self.digit_width)
        frame = 2 * self.style().pixelMetric(QStyle.PixelMetric.PM_DefaultFrameWidth)
        width = text_width + self.LEFT_MARGIN + self.RIGHT_MARGIN + frame + 8
        return QSize(width, super().sizeHint().height())

    def set_step_columns(self, step_columns):
        self.step_columns = step_columns

    def set_underline_column(self, column):
        self.underline_column = column
        self.update()

    def _char_widths(self):
        fm = self.fontMetrics()
        text = self.text()
        return text, [fm.horizontalAdvance(c) for c in text]

    def _char_rect(self, column):
        text, widths = self._char_widths()
        total = sum(widths)
        x0 = self.rect().right() - self.RIGHT_MARGIN - total
        x = x0 + sum(widths[:column])
        w = widths[column] if column < len(widths) else self.fontMetrics().horizontalAdvance(' ')
        return x, w

    def _column_at(self, x_pos):
        text, widths = self._char_widths()
        total = sum(widths)
        x = self.rect().right() - self.RIGHT_MARGIN - total
        for i, w in enumerate(widths):
            if x_pos < x + w:
                return i
            x += w
        return max(0, len(text) - 1)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            # Selecting a tuning step and placing the text cursor are
            # independent effects of the same click (matching the tkinter
            # version, where a tag_bind on the step ran alongside the Text
            # widget's own click handling) -- so fall through to super()
            # below to also position the cursor for editing.
            column = self._column_at(event.position().x())
            for step, columns in self.step_columns.items():
                if column in columns:
                    if self.on_step_click != None:
                        self.on_step_click(step)
                    break
        elif event.button() == Qt.MouseButton.MiddleButton:
            if self.on_validate != None:
                self.on_validate(False)
            event.accept()
            return
        super().mousePressEvent(event)

    def keyPressEvent(self, event):
        key = event.key()
        if key in (Qt.Key.Key_Left, Qt.Key.Key_Right):
            if self.on_change_step != None:
                self.on_change_step(key)
            event.accept()
            return
        if key in (Qt.Key.Key_Up, Qt.Key.Key_Down):
            if self.on_bump != None:
                self.on_bump(key)
            event.accept()
            return
        if key in (Qt.Key.Key_PageUp, Qt.Key.Key_PageDown):
            if self.on_jump != None:
                self.on_jump(key)
            event.accept()
            return
        if key in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            if self.on_validate != None:
                self.on_validate(True)
            event.accept()
            return
        if key == Qt.Key.Key_Space:
            if self.on_space != None:
                self.on_space()
            event.accept()
            return
        text = event.text()
        allowed_keys = (Qt.Key.Key_Backspace, Qt.Key.Key_Delete, Qt.Key.Key_Period)
        if text.isdigit() or key in allowed_keys:
            super().keyPressEvent(event)
            return
        event.ignore()

    def focusOutEvent(self, event):
        if self.on_validate != None:
            self.on_validate(True)
        super().focusOutEvent(event)

    def wheelEvent(self, event):
        if self.on_wheel != None:
            self.on_wheel(event)
        event.accept()

    def paintEvent(self, event):
        super().paintEvent(event)
        if self.underline_column == None:
            return
        x, w = self._char_rect(self.underline_column)
        painter = QPainter(self)
        painter.setPen(QPen(self.palette().color(self.foregroundRole())))
        y = self.rect().bottom() - 3
        painter.drawLine(x, y, x + w, y)
        painter.end()

class VFO(Widget):
    step = (1, 10, 100, 1000, 10000)
    step_index = {1: 0, 10: 1, 100: 2, 1000: 3, 10000:4}
    low_frequency_limit=100000
    high_frequency_limit=54000000
    instances = {}                # AorB ('A'/'B') -> VFO instance, so
                                   # PanadapterProcess can relay the
                                   # panadapter's arrow-key/wheel input to
                                   # the real widget -- see
                                   # PanadapterProcess.on_vfo_action_requested.

    def __init__(self, config_info, container):
        required = ['item', 'AorB']
        optional = ['width', 'activecolor', 'transmitcolor', 'label', 'leading',
            'bg', 'abg', 'fg', 'afg', 'blink', 'font', 'padx', 'pady']
        validate_options(config_info, required, optional)

        super().__init__(config_info, container)

        self.AorB = config_info.get('AorB', 'A').upper()
        VFO.instances[self.AorB] = self

        self.width = config_info.get('width', 9)

        # step_column: the single character column that gets underlined
        # for a given step. step_columns: the (possibly larger) set of
        # columns that select that step when clicked -- the leftmost
        # columns beyond the explicit per-step positions all select the
        # coarsest step, matching the tkinter version's extra tag_add loop.
        self.step_column = {}
        for i, step in enumerate(VFO.step):
            self.step_column[step] = self.width - i - (1 if i < 3 else 2)

        step_columns = {step: {column} for step, column in self.step_column.items()}
        last_step = VFO.step[-1]
        for i in range(0, self.width - len(VFO.step) - 1):
            step_columns[last_step].add(i)

        self.active_color = config_info.get('activecolor', self.bg)
        self.transmit_color = config_info.get('transmitcolor', self.bg)

        self.freq = 14100000
        self.step = 100

        frame = QWidget()
        frame_grid = QGridLayout(frame)
        frame_grid.setContentsMargins(0, 0, 0, 0)
        self.frame.layout().addWidget(frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.tb = DigitEntry(self.width)
        self.tb.setFont(self.font())
        self.tb.setStyleSheet('QLineEdit { background-color: pink; color: black; }')
        self.tb.set_step_columns(step_columns)
        frame_grid.addWidget(self.tb, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.tb.on_step_click = self.on_button_one
        self.tb.on_change_step = self.on_change_step
        self.tb.on_bump = self.on_bump_frequency
        self.tb.on_jump = self.on_jump_frequency
        self.tb.on_wheel = self.on_mouse_wheel
        self.tb.on_validate = self.validate_frequency
        self.tb.on_space = lambda: self.validate_frequency(False, space=True)

        self.add_tags()

        step_cmd = f'VT{"$" if self.AorB == "B" else ""};'
        self.server.subscribe_response(step_cmd, self.on_step_received)
        self.server.subscribe_response(f'F{self.AorB};', self.on_frequency_received)
        # subscribe to split and transmit on/off changes
        self.server.subscribe_responses('FT;TR;', self.set_vfo_bg)
        self.server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def on_received_initial_parameters(self, response):
        self.set_vfo_bg()

    def on_button_one(self, step):
        self.set_step(step)

    def add_tags(self):
        self.add_underline_tag()

    def add_underline_tag(self):
        self.tb.set_underline_column(self.step_column[self.step])

    def validate_frequency(self, send=False, space=False):
        try:
            freq = round(float(self.tb.text()) * 1000)
        except:
            freq = self.freq
            self.set_frequency(freq, send=False, space=space)
            return
        self.set_frequency(freq, send=send, space=space)

    def set_frequency(self, freq, send=False, space=False):
        if freq < VFO.low_frequency_limit:
            freq = VFO.low_frequency_limit
        if freq > VFO.high_frequency_limit:
            freq = VFO.high_frequency_limit
        freq_str = f'{freq / 1000:12.3f}'[12-self.width:]
        if freq_str != self.tb.text():
            self.tb.setText(freq_str)
            self.add_tags()
        if send and freq != self.freq:
            cmd = f'F{self.AorB}{freq:011.0f};'
            self.server.send_cmds(cmd)
        self.freq = freq
        self.set_vfo_bg()

    def on_frequency_received(self, response):
        freq = cmd_parameter(response)
        self.set_frequency(float(freq))

    def set_step(self, step):
        self.step = step
        self.add_underline_tag()
        suffix = '$' if self.AorB == 'B' else ''
        index = VFO.step_index[step]
        mode = self.current_mode_index()
        cmd = f'VT{suffix}{index}{mode};'
        self.server.send_cmds(cmd)

    def on_step_received(self, response):
        step_str = cmd_parameter(response)
        step_index = int(step_str[0])
        if step_index == 5:                             # Work around an apparent K4 bug
            cmd = f'VT{"$" if self.AorB == "B" else ""}2;'
            self.server.send_cmds(cmd)
            step_index = 2
        self.set_step_index(step_index)

    def set_step_index(self, step_index):
        if step_index < 0:
            step_index = 0
        elif step_index > 4:
            step_index = 4
        self.step = VFO.step[step_index]
        self.add_underline_tag()

    def on_change_step(self, key):
        step_index = VFO.step_index[self.step]
        if key == Qt.Key.Key_Left:
            step_index += 1
        else:
            step_index -= 1
        self.set_step_index(step_index)

    def adjust_frequency(self, step):
        freq = self.freq + step
        mod = freq % self.step
        freq -= mod
        if mod != 0 and step < 0:
            freq -= step
        self.set_frequency(freq, send=True)

    def nudge_frequency(self, delta_hz):
        # Same rounding as adjust_frequency, but snapped to delta_hz's
        # own grid rather than self.step -- used by the panadapter's
        # cursor-position-dependent arrow-key nudging (see
        # Panadapter._PanControlFilter), which always moves by a fixed
        # 1 kHz (trace/waterfall) or 10 Hz (mini-pan) regardless of
        # whatever tuning step happens to be selected.
        grid = abs(delta_hz)
        freq = self.freq + delta_hz
        mod = freq % grid
        freq -= mod
        if mod != 0 and delta_hz < 0:
            freq -= delta_hz
        self.set_frequency(freq, send=True)

    def on_bump_frequency(self, key):
        step = self.step
        if key == Qt.Key.Key_Down:
            step = -step
        self.adjust_frequency(step)

    def on_jump_frequency(self, key):
        orig_step = self.step
        step_index = VFO.step_index[self.step]
        if step_index < 4:
            step_index += 1
        step = VFO.step[step_index]
        if key == Qt.Key.Key_PageDown:
            step = -step
        self.set_frequency(self.freq + step, send=True)
        self.add_underline_tag()

    def on_mouse_wheel(self, event):
        step = self.step * mouse_wheel_mult(event)
        self.adjust_frequency(step)

    def current_mode_index(self):
        base = f'MD{"$" if self.AorB == "B" else ""}'
        return self.k4param(base)

    def transmit_vfo(self):
        split = self.k4param('FT') == '1'
        return 'B' if split else 'A'

    def set_vfo_bg(self, arg=None):
        if self.AorB == self.transmit_vfo():
            if self.k4param('TR') == 'T':
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.transmit_color}; color: black; }}')
            else:
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.active_color}; color: black; }}')
        else:
            self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.bg}; color: black; }}')

