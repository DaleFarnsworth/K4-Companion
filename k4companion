class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        # Continuously resizes the window to fit its current content
        # (Menu's listbox, AppSettings' dynamic keyer panels, etc. are
        # populated after the window is first shown) while still blocking
        # user drag-resize -- the Qt equivalent of tkinter's
        # resizable(False, False), which only blocks *user* resizing and
        # still lets the window grow automatically as content changes.
        layout.setSizeConstraint(QLayout.SizeConstraint.SetFixedSize)
        self.stack = QStackedWidget()
        layout.addWidget(self.stack)
        self.close_callback = None

    def closeEvent(self, event):
        if self.close_callback != None:
            self.close_callback()
        event.accept()

def _qt_message_handler(msg_type, context, message):
    # Silently drops "QThreadStorage: entry N destroyed before end of
    # thread ..." -- Qt's own qWarning(), not a Python exception, so
    # there's no call site to catch it at. It fires specifically when a
    # panadapter window is closed directly by the user (rather than the
    # main window's Pan togglebutton, or the whole app quitting): the
    # child process's reader thread (PanadapterChannel.thread) is
    # deliberately still parked in a blocking stdin read at that point
    # (see panadapter_child_main's own comment on why os._exit() is used
    # instead of waiting for it), so the process exits out from under
    # that still-running thread instead of it finishing normally first,
    # and Qt's per-thread bookkeeping for it gets torn down by the OS
    # rather than by Qt itself. Harmless -- the process is exiting
    # either way -- but noisy, and Windows-only (not seen on Linux/
    # macOS, where thread teardown ordering happens to work out).
    # Everything else still prints normally, same as Qt's default
    # handler.
    if 'QThreadStorage' in message and 'destroyed before end of thread' in message:
        return
    sys.stderr.write(message + '\n')

def main():
    qInstallMessageHandler(_qt_message_handler)
    # remove obsolete settings file
    obsolete_settings_file = Settings.settings_pathname(-1)
    if os.path.isfile(obsolete_settings_file):
        os.remove(obsolete_settings_file)

    close_splash_screen()

    Options.Parse()

    if Options.panadapter_receiver != None:
        # Started by PanadapterProcess: draw only the panadapter window,
        # with no connection, config, or audio of its own.
        panadapter_child_main(Options.panadapter_receiver)
        return

    app = QApplication(sys.argv)
    app.setStyle(CompactStyle(app.style()))

    top = MainWindow()
    Page.top = top
    Page.stack = top.stack

    Page.space_shortcut = QShortcut(QKeySequence(Qt.Key.Key_Space), top)
    Page.space_shortcut.activated.connect(
        lambda: Page.current().toggle_tr() if Page.current() != None else None)
    Page.space_shortcut.setEnabled(False)

    Server.settings = Settings()
    geometry = Server.settings.get('Window', 'root.geometry')
    if geometry != None:
        w, h, x, y = split_geometry(geometry)
        top.resize(w, h)
        top.move(x, y)

    top.close_callback = exit

    start()

    top.show()
    if geometry != None:
        # move() before show() targets the *content* position, but the
        # window manager doesn't reparent this into a decorated frame
        # until it's actually mapped -- so at that pre-show move(), Qt
        # doesn't yet know the frame's size and the WM ends up placing
        # the whole (content + decoration) rectangle at the requested
        # position instead, shifting the actual content down/right by
        # the title bar/border size. Re-issuing the same move() right
        # after show() isn't enough either: show() only requests the
        # map, it doesn't wait for the WM to actually reparent/decorate
        # the window, which happens asynchronously over the X11
        # connection -- a move() issued before that completes just
        # races the WM's own placement. Deferring it to the next event
        # loop iteration (singleShot(100, ...)) runs it after that
        # reparenting has actually landed.
        for geo_delay in (100, 250, 500, 1000):
            QTimer.singleShot(geo_delay, lambda: top.move(x, y))
    app.exec()

