            f'QComboBox QAbstractItemView {{ background-color: {self.selectbg}; color: {self.selectfg}; }}')
        qt_tighten_combobox_popup(combobox)

    def _reload_combobox_items(self, combobox, items):
        items = list(items)
        current = combobox.currentText()
        combobox.blockSignals(True)
        combobox.clear()
        combobox.addItems(items)
        if current in items:
            combobox.setCurrentText(current)
        combobox.blockSignals(False)

    def on_received_initial_parameters(self, response):
        self.server.subscribe_responses('TR;MD;MD$;FT;', self.on_k4_mode_changed)
        self.set_k4_equalizer()
        self.configure()

    def on_enabled_changed(self, checked):
        self.set_k4_equalizer()
        self.configure()
        self.save_settings()

    def enabled(self):
        return self.enabled_button.isChecked()

    def tr_mode(self):
        tr_mode = self.tr_mode_combobox.currentText()
        return self.split_tr_mode(tr_mode)

    def join_tr_mode(self, tr, mode):
        return f'{tr} - {mode}'

    def split_tr_mode(self, tr_mode):
        return tr_mode.rsplit(' - ', 1)

    def alt_tr_mode(self):
        alt = self.alt_combobox.currentText()
        tr, mode = self.tr_mode()
        return alt, tr, mode

    def join_alt_tr_mode(self, alt, tr, mode):
        return f'{alt} - {tr} - {mode}'

    def k4_tr(self):
        tr_index = 1 if self.k4param('TR') == 'T' else 0
        return self.trs[tr_index]

    def k4_mode(self):
        tr = self.k4_tr()
        base = 'MD'
        if tr == 'Receive':
            # Called once during __init__ before vfo_combobox exists yet
            # (mirrors the original: self.vfo_var held this value
            # independently of the not-yet-created combobox bound to it).
            vfo_combobox = getattr(self, 'vfo_combobox', None)
            vfo = vfo_combobox.currentText() if vfo_combobox != None else self.vfo
            if vfo == 'B':
                base += '$'
        else:
            split = self.k4param('FT') == '1'
            if split:
                base += '$'

        k4_modes = ('', 'SSB', 'SSB', 'CW', 'FM', 'AM', '', 'CW', '', '')
        k4_mode = self.k4param(base)
        if k4_mode ==  None or k4_mode == '':
            return None
        mode = k4_modes[int(k4_mode)]
        return mode

    def values_str(self, values):
        strs = []
        for value in values:
            strs.append('{value:+03d}'.format(value=value))
        return ''.join(strs)

    def str_values(self, s):
        values = []
        for offset in range(0, 24, 3):
            values.append(int(s[offset:offset+3]))
        return values

    def set_k4_equalizer(self):
        if not self.enabled():
            return

        mode = self.k4_mode()
        if mode == None or mode == '':
            return

        alt = self.active_alt_combobox.currentText()
        tr = self.k4_tr()
        if tr == 'Receive':
            base = 'RE'
        else:
            base = 'TE'
        values = self.values[alt][tr][mode]
        cmd = base + self.values_str(values) + ';'
        self.server.send_cmds(cmd)

    def on_active_alt_changed(self, text):
        self.set_k4_equalizer()
        self.configure()
        self.save_settings()

    def on_value_changed(self, value, i):
        alt, tr, mode = self.alt_tr_mode()
        self.values[alt][tr][mode][i] = value
        self.value_labels[i].setText(format_slider_value(value, 1))
        self.set_k4_equalizer()
        self.save_settings()

