        self.default_button.setFont(self.menu.font())
        self.default_button.setStyleSheet(
            qt_button_stylesheet(self.menu.bg, self.menu.fg, self.menu.abg, self.menu.afg))
        self.default_button.clicked.connect(self.on_default_clicked)
        locked_grid.addWidget(self.default_button, 1, 0)

    def null_update(self, current=None):
        pass

    def on_locked_changed(self):
        if self.locked == 'Locked':
            if self.changeable == 'Locked':
                self.changeable = 'Unlocked'
            else:
                self.changeable = 'Locked'

        self.update()

    def update(self, locked=None, current=None):
        self.update_widget(current=current)

        if locked != None:
            self.changeable = locked

        locked_grid = self.locked_frame.layout()
        if self.changeable == 'Unmodifiable':
            locked_grid.removeWidget(self.default_button)
            self.default_button.hide()
        elif self.changeable == 'Unlocked':
            locked_grid.addWidget(self.default_button, 1, 0)
            self.default_button.show()
            self.default_button.setEnabled(True)
        else:
            locked_grid.addWidget(self.default_button, 1, 0)
            self.default_button.show()
            self.default_button.setEnabled(False)

        self.locked_button.setText(self.changeable)

        self.update_desc()

    def update_desc(self):
        desc = self.updated_desc
        if self.area == 'XV':
            if self.type == 'DEC':
                self.menu.xv_band = int(self.current)
            else:
                self.updated_desc = self.desc.replace('<n>', str(self.menu.xv_band))

            if self.updated_desc != desc:
                item = self.menu.listbox.item(self.position)
                if item != None:
                    item.setText(self.updated_desc)

        if self.type == 'ms':
            self.updated_desc = self.desc + "\n(ms)"

        if self.type == 'ZMON':
            self.updated_desc = self.desc + "\n(-1 = OFF, 0 = MON)"

        if self.type == 'ZOFF':
            self.updated_desc = self.desc + "\n(0 = OFF)"

        if self.type == 'MHz':
            self.updated_desc = self.updated_desc + "\n(MHz)"

        if self.type == 'D10mW':
            self.updated_desc = self.updated_desc + "\n(mW)"

        if self.type == 'Hz':
            self.updated_desc = self.updated_desc + "\n(Hz)"

        if self.updated_desc != desc:
            self.frame.setTitle(self.updated_desc)

    def current_desc(self):
        return self.updated_desc

    def on_default_clicked(self):
        if self.changeable == 'Unlocked':
            self.update(current=self.default)
            self.send_command()

    def show(self):
        self.update(locked=self.locked)
        self.menu.frame.layout().addWidget(self.frame, 0, 2,
            Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        self.frame.show()

    def hide(self):
        self.menu.frame.layout().removeWidget(self.frame)
        self.frame.hide()

    def listbox(self):
        self.update_widget = self.listbox_update
        self.widget = QListWidget()
        self.widget.setFont(self.menu.font())
        self.widget.setStyleSheet(
            f'QListWidget {{ background-color: {self.menu.bg}; color: {self.menu.fg}; }}'
            f'QListWidget::item:selected {{ background-color: {self.menu.selectbg}; color: {self.menu.selectfg}; }}')

        if self.low != 0:
            raise Exception('Unexpected listbox low ', self.low)

        high = self.high + 1
        if high < len(self.values):
            self.values = self.values[:high]

        for value in self.values:
            self.widget.addItem(str(value))

        row_height = QFontMetrics(self.menu.font()).height() + 2
        self.widget.setFixedHeight(len(self.values) * row_height + 4)

        fm = QFontMetrics(self.menu.font())
        text_width = max((fm.horizontalAdvance(str(value)) for value in self.values), default=0)
        frame = 2 * self.widget.frameWidth()
        scrollbar_width = self.widget.verticalScrollBar().sizeHint().width()
        self.widget.setFixedWidth(text_width + frame + scrollbar_width + 12)

        self.widget.setCurrentRow(self.current)

        self.frame_grid.addWidget(self.widget, 0, 0)
        self.widget.currentRowChanged.connect(self.on_listbox_selected)

    def on_listbox_selected(self, index):
        if index < 0:
            return
        if self.changeable != 'Unlocked':
            self.widget.blockSignals(True)
            self.widget.setCurrentRow(self.current)
            self.widget.blockSignals(False)
            return

        self.current = index
        self.send_command()

    def listbox_update(self, current=None):
        if current != None:
            self.current = current
        self.widget.blockSignals(True)
        self.widget.setCurrentRow(self.current)
        self.widget.blockSignals(False)

    def vfocrs(self):
        self.values = ('0.1 kHz', '0.5 kHz', '1.0 kHz', '2.5 kHz')
        self.listbox()

    def m50hz(self):
        self.values = ('150 Hz', '200 Hz', '250 Hz', '300 Hz', '350 Hz', '400 Hz', '450 Hz', '500 Hz', '550 Hz', '600 Hz', '650 Hz', '700 Hz')
        self.high -= self.low
        self.low = 0
        self.listbox()
        self.send_command = self.m50hz_send_command
        self.update_widget = self.m50hz_update

    def m50hz_send_command(self):
