def qt_justify(justify):
    return {
        'left': Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
        'right': Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
        'center': Qt.AlignmentFlag.AlignCenter,
    }.get(justify, Qt.AlignmentFlag.AlignCenter)

def format_slider_value(value, resolution):
    # tk.Scale's built-in showvalue readout derives its decimal precision
    # from the slider's resolution; QSlider has no such readout, so this
    # reproduces the same formatting for the value labels added next to
    # ported sliders.
    try:
        resolution = abs(float(resolution))
    except (TypeError, ValueError):
        resolution = 1
    if resolution == 0 or resolution >= 1:
        return f'{value:.0f}'
    decimals = max(0, -int(math.floor(math.log10(resolution))))
    return f'{value:.{decimals}f}'

def qt_button_stylesheet(bg, fg, abg, afg):
