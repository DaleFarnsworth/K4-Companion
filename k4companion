    def adjust_offset(self, step):
        offset = self.offset + step
        mod = offset % self.step
        offset -= mod
        if mod != 0 and step < 0:
            offset -= step
        self.set_offset(offset)

    def on_bump_offset(self, key):
        step = self.step
        if key == Qt.Key.Key_Down:
            step = -step
        self.adjust_offset(step)

    def on_jump_offset(self, key):
        orig_step = self.step
        step_index = RIT.step_index[self.step]
        if step_index < 3:
            step_index += 1
        step = RIT.step[step_index]
        if key == Qt.Key.Key_PageDown:
            step = -step
        self.set_offset(self.offset + step)
        self.add_underline_tag()

    def on_mouse_wheel(self, event):
        step = self.step * mouse_wheel_mult(event)
        self.adjust_offset(step)

    def current_mode_index(self):
        base = f'MD{self.suffix}'
        return self.k4param(base)

    def transmit_vfo(self):
        split = self.k4param('FT') == '1'
        return 'B' if split else 'A'

    def set_rit_bg(self, arg=None):
        rit_on = self.k4param(f'RT{self.suffix}') == '1'
        xit_on = self.k4param(f'XT') == '1'

        if rit_on:
            if xit_on and self.AorB == self.transmit_vfo():
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.ritxit_color}; color: black; }}')
            else:
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.rit_color}; color: black; }}')
        else:
            if xit_on and self.AorB == self.transmit_vfo():
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.xit_color}; color: black; }}')
            else:
                self.tb.setStyleSheet(f'QLineEdit {{ background-color: {self.bg}; color: black; }}')

class SliderWidget():
    def __init__(self, caller, frame, options):
        self.caller = caller
        self.server = caller.server

        self.bg = options['bg']
        self.fg = options['fg']
        font = options['font']

        self.from_ = options['from']
        self.to = options['to']
        self.evalcmd = options['evalcmd']
        self.evalresponse = options['evalresponse']
        orient = Qt.Orientation.Horizontal if options.get('orient', 'horizontal') == 'horizontal' \
            else Qt.Orientation.Vertical
        self.evalincrement = options.get('evalincrement', 1.0)
        length = round(options.get('length', 100) * font_unit())
        self.label = options.get('label', None)
        self.showvalue = true_values(options.get('showvalue', True))

        self.value = 0.0
        self.previous_value = 0.0
        self.received_value = False

        from_ = self.caller.eval_value(self.from_, self.value)
        to = self.caller.eval_value(self.to, self.value)
        self.resolution = abs(self.caller.eval_value(self.evalincrement, self.value))

        # QSlider only understands integer steps, so the slider works in
        # units of "resolution" internally and value()/setValue() convert
        # to/from the real (float) value at the resolution's granularity.
        self.scale = QSlider(orient)
        self.orient = orient
        self._set_range(orient, from_, to)
        if orient == Qt.Orientation.Horizontal:
            self.scale.setFixedWidth(length)
        else:
            self.scale.setFixedHeight(length)
        self.scale.setStyleSheet(f'QSlider {{ background-color: {self.bg}; }}')
        self.scale.valueChanged.connect(self.value_changed)

        frame.layout().addWidget(self.scale, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.value_label = None
        if self.showvalue:
            self.value_label = QLabel(format_slider_value(self.value, self.resolution))
            self.value_label.setFont(font)
            self.value_label.setStyleSheet(f'QLabel {{ color: {self.fg}; background-color: {self.bg}; }}')
            if orient == Qt.Orientation.Horizontal:
                self.value_label.setAlignment(Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignTop)
                frame.layout().addWidget(self.value_label, 1, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
            else:
                self.value_label.setAlignment(Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignTop)
                frame.layout().addWidget(self.value_label, 0, 1, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.scale.wheelEvent = self.on_mouse_wheel

        self.server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def _set_range(self, orient, from_, to):
        # tk.Scale lets from_/to be given in either order and always
        # displays from_ at the left (horizontal) or top (vertical),
        # regardless of which is numerically larger -- e.g. AF Limiter
        # uses from: 30, to: 1. QSlider instead requires minimum <=
        # maximum; calling setMinimum()/setMaximum() with the raw
        # from_/to values in that case (minimum=30, maximum=1) is an
        # invalid range that Qt silently collapses, leaving the slider
        # stuck. Feed Qt the numeric lo/hi instead, and only flip
        # setInvertedAppearance/setInvertedControls when Qt's own default
        # placement (min at left/bottom, max at right/top) wouldn't
        # already put from_ where tk expects it.
        lo, hi = min(from_, to), max(from_, to)
        if orient == Qt.Orientation.Horizontal:
            inverted = from_ > to
        else:
            inverted = from_ < to
        self.scale.setInvertedAppearance(inverted)
        self.scale.setInvertedControls(inverted)
        self.scale.setMinimum(round(lo / self.resolution))
        self.scale.setMaximum(round(hi / self.resolution))
        # QSlider defaults to a pageStep of 10 (the jump a click on the
        # groove, rather than the handle, produces) -- tk.Scale's trough
        # click instead moves by exactly one resolution unit, same as a
        # single step. Match that so groove clicks behave consistently.
        self.scale.setPageStep(1)

    def on_received_initial_parameters(self, response):
        cmd = self.caller.eval_value(self.evalcmd, self.value)
        if cmd != "":
            self.server.subscribe_response(cmd, self.on_response_received)

    def on_mouse_wheel(self, event):
        incr = self.resolution * mouse_wheel_mult(event)
        value = round(self.value + incr, 10)
        self.set_value(value)

    def set_value(self, value):
        self.scale.blockSignals(True)
        self.scale.setValue(round(value / self.resolution))
        self.scale.blockSignals(False)
        self.value_changed(self.scale.value())

    def value_changed(self, scale_position):
        value = scale_position * self.resolution
        next_value = value
        if self.previous_value == value:
            return
        if self.previous_value < value:
            next_value = value + self.caller.eval_value(self.evalincrement, value)
        self.resolution = abs(self.caller.eval_value(self.evalincrement, next_value))
        self.value = value
        if self.value_label != None:
            self.value_label.setText(format_slider_value(value, self.resolution))
        if not self.received_value:
            cmd = self.caller.eval_value(self.evalcmd, value)
            self.previous_value = value
            self.server.send_cmds(cmd)

    def on_response_received(self, response):
        value = float(self.caller.eval_value(self.evalresponse, response))
        if value < 0:
            return
        self.resolution = abs(self.caller.eval_value(self.evalincrement, value))
        self.received_value = True
        # setMinimum()/setMaximum() can clamp the slider's *current*
        # position if it now falls outside the new range, which fires
        # valueChanged just like a user drag would. Blocking signals here
        # (tk.Scale's from_/to reconfiguration has no such side effect,
        # so the original code didn't need this) stops that from echoing
        # a just-received value straight back to the K4 as a send_cmds().
        self.scale.blockSignals(True)
        self._set_range(self.orient,
                         self.caller.eval_value(self.from_, value),
                         self.caller.eval_value(self.to, value))
        self.scale.blockSignals(False)
        self.set_value(value)
        self.previous_value = value
        self.received_value = False

