            self.current = current - 1
        self.slider_update()

    def d10mw(self):
        self.low = float(self.low) / 10
        self.high = float(self.high) / 10
        self.increment = float(self.increment) / 10
        self.slider()
        self.send_command = self.d10mw_send_command
        self.update_widget = self.d10mw_update

    def d10mw_send_command(self):
        value = int(self.current * 10)
        self.server.send_str('ME{index:04d}.{value:04d};'.format(index=self.index, value=value))

    def d10mw_update(self, current=None):
        if current != None:
            self.current = float(current) / 10
        self.slider_update()

    def range_listbox(self):
        for i in range(self.low, self.high+1, self.increment):
            self.values.append(i)
        self.high -= self.low
        self.low = 0
        self.listbox()
        self.send_command = self.range_listbox_send_command
        self.update_widget = self.range_listbox_update

    def range_listbox_update(self, current=None):
        if current != None:
            self.current = self.values.index(current)
        self.widget.blockSignals(True)
        self.widget.setCurrentRow(self.current)
        self.widget.blockSignals(False)

    def range_listbox_send_command(self):
        value = int(self.values[self.current])
        self.server.send_str('ME{index:04d}.{value:04d};'.format(index=self.index, value=value))

    def slider(self):
        self.update_widget = self.slider_update
        # QSlider only takes integer steps, so (as with SliderWidget
        # elsewhere) the widget works in units of "resolution" internally.
        self.slider_resolution = float(self.increment) if self.increment else 1

        self.widget = QSlider(Qt.Orientation.Vertical)
        # low/high/current stay whatever typed_value() gave them (still a
        # raw str for menu type 'REF', since widget_send_command() must
        # echo that string back to the K4 unmodified) -- float() here only
        # to give the widget the numbers it needs, without mutating them.
        self.widget.setMinimum(round(float(self.low) / self.slider_resolution))
        self.widget.setMaximum(round(float(self.high) / self.slider_resolution))
        # tk's from_=high (top)/to=low (bottom) is what a vertical QSlider
        # already does by default with setMinimum(low)/setMaximum(high) --
        # no setInverted*() needed (see the matching fix in Equalizers).
        # QSlider's default pageStep of 10 makes a groove click jump 10
        # resolution units instead of tk.Scale's one-unit trough click.
        self.widget.setPageStep(1)
        self.widget.setFixedHeight(font_height(self.menu.font()) * 9)
        self.widget.setStyleSheet(f'QSlider {{ background-color: {self.menu.bg}; }}')
        self.widget.setValue(round(float(self.current) / self.slider_resolution))
        self.widget.valueChanged.connect(self.slider_value_changed)

        self.frame_grid.addWidget(self.widget, 0, 0)

        self.slider_value_label = QLabel(format_slider_value(float(self.current), self.slider_resolution))
        self.slider_value_label.setFont(self.menu.font())
        self.slider_value_label.setAlignment(Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignTop)
        self.slider_value_label.setStyleSheet(f'QLabel {{ color: {self.menu.fg}; background-color: {self.menu.bg}; }}')
        self.frame_grid.addWidget(self.slider_value_label, 1, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

    def slider_value_changed(self, position):
        if self.changeable != 'Unlocked':
            self.widget.blockSignals(True)
            self.widget.setValue(round(float(self.current) / self.slider_resolution))
            self.widget.blockSignals(False)
            return

        value = position * self.slider_resolution
        if isinstance(self.low, int) and isinstance(self.high, int):
            value = int(value)
        self.current = value
        self.slider_value_label.setText(format_slider_value(value, self.slider_resolution))
        self.send_command()

    def slider_update(self, current=None):
        if current != None:
            if isinstance(current, str) and current.find('-') > 0:
                current = current.lstrip('0')
            self.current = current
        self.widget.blockSignals(True)
        self.widget.setValue(round(float(self.current) / self.slider_resolution))
        self.widget.blockSignals(False)
        self.slider_value_label.setText(format_slider_value(float(self.current), self.slider_resolution))

    def fixed_text(self):
        self.update_widget = self.fixed_text_update
        self.widget = QLabel(str(self.current))
        self.widget.setFont(self.menu.font())
        self.widget.setStyleSheet(f'QLabel {{ color: {self.menu.fg}; background-color: {self.menu.bg}; padding: 2px; }}')
        self.frame_grid.addWidget(self.widget, 0, 0)

    def fixed_text_update(self, current=None):
        if current != None:
            self.current = current
        self.locked = 'Unmodifiable'
        self.widget.setText(str(self.current))

    def text(self):
        self.update_widget = self.text_update
        self.widget = QLineEdit(str(self.current))
        self.widget.setFont(self.menu.font())
        self.widget.setStyleSheet(f'QLineEdit {{ color: {self.menu.fg}; background-color: {self.menu.bg}; }}')
        self.frame_grid.addWidget(self.widget, 0, 0)
        self.widget.editingFinished.connect(self.set_text)

    def set_text(self):
        self.current = self.widget.text()
        self.send_command()

    def text_update(self, current=None):
        if current != None:
            self.current = current
        self.widget.setText(str(self.current))

    def widget_send_command(self):
        if isinstance(self.current, str) or self.type == 'REF':
            self.server.send_str('ME{index:04d}.{value};'.format(index=self.index, value=self.current))
        else:
            value = int(round(self.current))
            self.server.send_str('ME{index:04d}.{value:04d};'.format(index=self.index, value=value))

    def typed_value(self, n):
        if self.type == 'REF':
            return n
        try:
            n = float(n)
            if int(n) == n:
                n = int(n)
        except:
            pass
        return n

    def print(self):
        dprint('index', self.index)
        dprint('desc', self.desc)
        dprint('area', self.area)
        dprint('type', self.type)
        dprint('locked', self.locked)
        dprint('low', self.low)
        dprint('high', self.high)
        dprint('default', self.default)
        dprint('current', self.current)
        dprint('increment', self.increment)
        dprint('values', self.values)

class Menu(Widget):
    entries_displayed = 15
    singleton = None

    @classmethod
    def entry(cls, index):
        return cls.singleton.lookup_definitions.get(index, None)

    def __init__(self, config_info, container):
        required = ['item']
        optional = ['entries_displayed', 'label', 'leading', 'bg', 'abg',
            'fg', 'afg', 'selectbg', 'selectfg', 'font', 'label_font',
            'padx', 'pady']
        validate_options(config_info, required, optional)

        super().__init__(config_info, container)

        Menu.singleton = self

        entries_displayed = config_info.get('entries_displayed', Menu.entries_displayed)

        self.current_md = None

        self.selectbg = config_info.get('selectbg', self.bg)
        self.selectfg = config_info.get('selectfg', self.fg)

        self.definitions = []
        self.lookup_definitions = {}

        self.xv_band = 0

        old_frame = self.frame
        self.frame = QWidget()
        grid = QGridLayout(self.frame)
        grid.setContentsMargins(0, 0, 0, 0)
        old_frame.layout().addWidget(self.frame, 0, 0,
            Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.listbox = QListWidget()
        self.listbox.setFont(self.font())
        self.listbox.setStyleSheet(
            f'QListWidget {{ background-color: {self.bg}; color: {self.fg}; }}'
            f'QListWidget::item:selected {{ background-color: {self.selectbg}; color: {self.selectfg}; }}')
        row_height = QFontMetrics(self.font()).height() + 2
        self.listbox.setFixedHeight(entries_displayed * row_height + 4)
        # QListWidget scrolls internally, so no separate scrollbar widget
        # is needed (unlike the tkinter Listbox + Scrollbar pair).

        self.listbox.currentRowChanged.connect(self.on_listbox_selected)
        self.server.subscribe_response('MEDF;', self.on_received_definition, send=False)

    def update_definition_list(self):
        self.listbox.clear()

        for i, md in enumerate(self.definitions):
            md.position = i
            self.listbox.addItem(md.desc)

        # Size to the widest item (mirrors the tkinter version's
        # listbox.configure(width=...) based on the longest description)
        # instead of the QListWidget default, which stretches to fill
        # whatever space the layout offers.
        fm = QFontMetrics(self.font())
        text_width = max((fm.horizontalAdvance(md.desc) for md in self.definitions), default=0)
        frame = 2 * self.listbox.frameWidth()
        scrollbar_width = self.listbox.verticalScrollBar().sizeHint().width()
        self.listbox.setFixedWidth(text_width + frame + scrollbar_width + 12)

    def received_all_definitions(self):
        self.server.subscribe_response('ME;', self.on_received_current, send=False)

        self.definitions = sorted(self.definitions, key=lambda d:d.current_desc().casefold())
        self.update_definition_list()

        self.server.send_str('ME0043;')         # request updated IP address. We know this has changed.
        self.server.send_str('ME0086;ME0078;ME0076;ME0079;ME0098;ME0077;')   # request current transverter band menu settings

        self.frame.layout().addWidget(self.listbox, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

    def on_received_current(self, response):
        index, current_value = response[2:].split('.', 1)
        current_value = current_value.rstrip(';')
        index = int(index)
        md = self.lookup_definitions[index]
        current_value = md.typed_value(current_value)
        md.update(current=current_value)

    def on_listbox_selected(self, index):
        if index < 0:
            return

        if self.current_md != None and self.current_md.widget != None:
            self.current_md.hide()

        md = self.definitions[index]
        self.current_md = md

        md.show()

    def on_received_definition(self, response):
        if response[4:8] == '0000':
            self.received_all_definitions()
            return

        definition_values = response[4:].rstrip(';').split(',')
        if len(definition_values) < 3 or definition_values[3] == 'NULL':                      # md.type
            return

        md = Menu_definition(self, definition_values)
        found = self.lookup_definitions.get(md.index, None)
        if found != None:
            return

        self.lookup_definitions[md.index] = md
        self.definitions.append(md)

def le_int(data, signed=False):
    value = 0
    for byte in reversed(data):
        value = (value << 8) | byte
    if signed:
        bits = len(data) * 8
        if value >= (1 << (bits - 1)):
            value -= (1 << bits)
    return value

def parse_pan_frame(data, decode_offset=160):
    # PAN payload (multi-byte fields little-endian -- unlike the outer
    # packet's length field, which is explicitly big-endian per the
    # K4-Remote protocol draft; only these PAN sub-header fields are
    # little-endian), per the draft:
    #   offset 0        subtype (unused here)
    #   offset 1        RX (0=main, 1=sub)
    #   offset 2-3      pan data length, uint16
    #   offset 4-7      reserved
    #   offset 8-15     center frequency, signed int64
    #   offset 16-19    sample rate, signed int32
    #   offset 20-23    noise floor, signed int32 (deci-dB -- divide by
    #                    10 to get dB, confirmed against real hardware)
    #   offset 24+      compressed spectrum samples, 1 byte each
    # Decompression: decoded = byte - decode_offset (dB). The draft's
    # formula multiplies by 10 as well, but that's confirmed too large
    # by 10x against real hardware, matching the noise floor field's
    # own deci-dB scaling.
    #
    # MINI-PAN (see parse_minipan_frame) uses this identical sub-header
    # -- confirmed against real hardware: a MINI-PAN payload initially
    # assumed to be a headerless raw byte array decoded, byte for byte,
    # into exactly this layout (pan_len=1024 at offset 2-3, all-zero
    # reserved bytes at offset 4-7, RX at offset 1 alternating 0/1 in
    # sync with center_hz's low byte between interleaved main/sub
    # frames) -- just with decode_offset=0 rather than PAN's 160.
    if len(data) < 24:
        return None
    rx = data[1]
    pan_len = le_int(data[2:4])
    center_hz = le_int(data[8:16], signed=True)
    sample_rate = le_int(data[16:20], signed=True)
    noise_floor = le_int(data[20:24], signed=True) / 10
    samples = data[24:24 + pan_len]
    if len(samples) != pan_len:
        return None
    bins = [b - decode_offset for b in samples]
    receiver = 'sub' if rx == 1 else 'main'
    return receiver, center_hz, sample_rate, noise_floor, bins

def parse_minipan_frame(data):
    return parse_pan_frame(data, decode_offset=0)

def format_freq_tick(hz, round_to=100, drop_digits=2):
    # Round to the nearest round_to Hz, zero-pad to always include a
    # megahertz digit even when it's 0, group digits in 3s with '.',
    # then drop the trailing drop_digits digits (always zero after that
    # rounding). E.g. defaults (round_to=100, drop_digits=2):
    # 1234567 -> "1.234.6", 550000 -> "0.550.0". round_to=1000,
    # drop_digits=3 (used for the non-center ticks): 1234567 -> "1.235".
    rounded = round(hz / round_to) * round_to
    digits = f'{rounded:07d}'
    groups = []
    while digits:
        groups.insert(0, digits[-3:])
        digits = digits[:-3]
    # rstrip('.'): when drop_digits lands exactly on a group boundary
    # (e.g. drop_digits=3), the slice below leaves a trailing separator
    # from the now-fully-removed last group.
    return '.'.join(groups)[:-drop_digits].rstrip('.')

class _PanControlFilter(QObject):
    # Arrow keys and the mouse wheel are meant to behave the same way
    # anywhere in the panadapter window as they do on the corresponding
    # VFO control -- not just while some particular child widget (e.g.
    # the trace plot) happens to have focus/be under the cursor. An
    # application-wide event filter (same pattern as CW's _CWKeyFilter)
    # sidesteps that: it sees every event before the widget it's headed
    # for does, so it works regardless of focus and isn't affected by
    # e.g. PlotWidget's own default arrow-key/wheel handling.
    #
    # Left/Right and each wheel notch all nudge the frequency by a fixed
    # amount that depends on where the cursor is -- finest over the
    # button area (1 Hz) and coarser over each successively wider/less
    # zoomed-in display (10 Hz over the mini-pan, 100 Hz over the trace,
    # 1 kHz over the waterfall) -- rather than the VFO's current tuning
    # step, so the panadapter's own resolution controls the nudge size,
    # not whatever the VFO widget happens to be set to. Nothing happens
    # over the window's own margins or the splitter handle between the
    # trace and waterfall -- those aren't any of the four areas above,
    # so _nudge_size_hz returns None there (see its own comment) rather
    # than falling back to some default rate. Up/Down are swallowed and
    # do nothing -- there's no vertical (dB scale) control here worth
    # binding them to, and left unhandled they'd fall through to
    # PlotWidget's own default arrow-key handling.
    def __init__(self, window):
        super().__init__()
        self.window = window

    def _nudge_size_hz(self):
        # None (not 0) for "not over a recognized area" -- 0 would be a
        # valid-looking nudge size that just happens to do nothing;
        # None lets the caller tell "no nudge here" apart from "nudge by
        # zero" and skip calling request_vfo_action at all.
        if self.window.minipan_plot.underMouse():
            return 10
        if self.window.trace_plot.underMouse():
            return 100
        if self.window.waterfall_plot.underMouse():
            return 1000
        # The whole upper-right area, not just controls_frame's own
        # widget bounds -- includes minipan_row's stretch to the right
        # of it, so the button rate covers that empty space too, not
        # just the buttons/comboboxes themselves. minipan_plot (checked
        # above) is the only other thing in this row, so this can't
        # double-count it.
        if self.window.minipan_row.underMouse():
            return 1
        return None

    def eventFilter(self, obj, event):
        event_type = event.type()
        if event_type == QEvent.Type.KeyPress:
            key = event.key()
            if key in (Qt.Key.Key_Up, Qt.Key.Key_Down):
                if not isinstance(obj, QWidget):
                    return False
                if not (obj is self.window or self.window.isAncestorOf(obj)):
                    return False
                return True
            if key in (Qt.Key.Key_Left, Qt.Key.Key_Right):
                if not isinstance(obj, QWidget):
                    return False
                if not (obj is self.window or self.window.isAncestorOf(obj)):
                    return False
                delta_hz = self._nudge_size_hz()
                if delta_hz != None:
                    if key == Qt.Key.Key_Left:
                        delta_hz = -delta_hz
                    self.window.request_vfo_action(f'nudge {delta_hz}')
                return True
        elif event_type == QEvent.Type.Wheel:
            if not isinstance(obj, QWidget):
                return False
            if not (obj is self.window or self.window.isAncestorOf(obj)):
                return False
            mult = mouse_wheel_mult(event)
            if mult != 0:
                delta_hz = self._nudge_size_hz()
                if delta_hz != None:
                    self.window.request_vfo_action(f'nudge {delta_hz * mult}')
            return True
        return False

class Panadapter(QDialog):
    # Driven by PAN frames only; MINI-PAN is ignored (see push_minipan).
    windows = {}                 # receiver ('main'/'sub') -> Panadapter
    waterfall_seconds = 10       # Depth of scroll history, in seconds.
                                  # One PAN frame is one row, so the row
                                  # count below is derived from the K4's
                                  # reported frame rate (#FPS) to keep
                                  # that depth constant regardless of
                                  # how fast frames arrive.
    frames_per_second = 12       # updated from #FPS
    fps_min = 1                  # #FPS's valid range per the K4
    fps_max = 30                 # Programmer's Reference (#FPSnn;, 01-30)
    waterfall_rows = 120         # = waterfall_seconds * frames_per_second
    frozen = False                # updated from #FRZ; (0=running, 1=frozen)
    fxa = None                    # updated from #FXA; (DDC Fixed Tune Mode,
                                  # 0-4) -- see on_fxa_changed/on_fxt_changed.
    fxt = None                    # updated from #FXT; ('0'=track, '1'=fixed)
    display_span_hz = {'main': 100000, 'sub': 100000}
                                  # K4 sends more spectrum than this is
                                  # useful to show; crop to the center
                                  # of it (see push_frame). Kept in sync,
                                  # independently per receiver, with the
                                  # K4's own span via #SPN;/#SPN$. Seeded
                                  # with a plausible default so push_frame
                                  # has something to crop to even before
                                  # the first #SPN;/#SPN$; is seen -- see
                                  # span_seen for tracking that instead.
    span_seen = {'main': False, 'sub': False}
                                  # Whether #SPN;/#SPN$; has actually been
                                  # received yet, per receiver -- since
                                  # display_span_hz itself always holds a
                                  # number (see above), this is what lets
                                  # on_span_changed tell its first real
                                  # value apart from a later, genuine
                                  # change (see _trigger_auto_ref).
    span_min_khz = 6              # #SPN;/#SPN$;'s own documented range
    span_max_khz = 368            # (6000 to 368000 Hz) -- see the Span
                                  # combobox and PanadapterProcess.
                                  # on_span_requested.
    span_choices_khz = (6, 10, 20, 50, 100, 150, 200, 250, 300, 350, 368)
    colormap = None               # built once, shared by every window
    child_mode = False            # True in the panadapter subprocess
    child_geometry = None         # see save_geometry()
    child_splitter_sizes = None   # see save_splitter_sizes()
    mode = {'main': None, 'sub': None}
                                  # K4 mode digit ('3'=CW, '7'=CW-R, etc,
                                  # see the MD/MD$ selections in the
                                  # yaml), kept in sync via MD;/MD$;.
                                  # Used for the mini-pan's bandwidth
                                  # (see is_cw_mode) and to trigger an
                                  # automatic Ref capture on change --
                                  # see on_mode_changed.
    antenna = {'main': None, 'sub': None}
                                  # RX antenna selection, from AR;/AR$;
                                  # (deprecated AR8/AR$8 changelog entry
                                  # confirms AR/AR$ split main/sub the
                                  # same as BW/BW$ etc). Used only to
                                  # trigger an automatic Ref capture on
                                  # change -- see on_antenna_changed.
    tx_antenna = None
                                  # TX antenna selection, from AN; --
                                  # shared between main/sub (there is no
                                  # AN$). A receiver whose own AR/AR$ is
                                  # 2 ("RX USES TX ANT" per the K4
                                  # Programmer's Reference) doesn't emit
                                  # its own AR/AR$ when the antenna it's
                                  # actually using changes -- only AN
                                  # does, since AR's value (2) stays the
                                  # same. See on_tx_antenna_changed.
    sub_receiver_on = None
                                  # Sub receiver on/off, from SB; -- only
                                  # meaningful to the sub panadapter (the
                                  # main receiver is always on). Used
                                  # only to trigger an automatic Ref
                                  # capture on change -- see
                                  # on_sub_receiver_changed.
    bandwidth_hz = {'main': None, 'sub': None}
                                  # Receiver bandwidth in Hz, from
                                  # BW;/BW$; (format BWnnnn, nnnn =
                                  # bandwidth in kHz * 100). Used to
                                  # shade the trace around the
                                  # receiver's current frequency.
    rx_freq_hz = {'main': None, 'sub': None}
                                  # The receiver's actual tuned
                                  # frequency, from FA;/FB;. This is
                                  # NOT always the same as a given PAN
                                  # frame's center_hz (the display
                                  # center of that frame's spectrum) --
                                  # used for the frequency line, the
                                  # bandwidth shading, and the mini-pan's
                                  # centering, all of which must track
                                  # where the receiver is actually tuned.
    scale_db = None               # Panadapter vertical scale (dB span
                                  # of the trace's Y axis), from #SCL;
                                  # -- see on_scale_changed. A single
                                  # value with no per-receiver
                                  # ($) variant in the protocol, like
                                  # #FPS, so it's shared by both windows.
    scale_min = 10                # #SCL's valid range per the K4
    scale_max = 150               # Programmer's Reference (#SCLn;, 10-150)
    scale_choices_db = tuple(range(scale_min, scale_max + 1, 5))
                                  # Listed in steps of 5 rather than every
                                  # single value, same reasoning as Span's
                                  # preset list -- see _set_scale_combobox
                                  # for how a radio-reported value outside
                                  # this list (still valid -- #SCL isn't
                                  # actually restricted to multiples of 5)
                                  # is still shown.

    # This class now only ever runs in the panadapter subprocess; the
    # main process talks to it through PanadapterProcess, which owns
    # opening, closing, and the persisted "was open" flag.

    @classmethod
    def on_span_changed(cls, response):
        # #SPN reports the span as a plain Hz value.
        receiver = 'sub' if cmd_base(response).endswith('$') else 'main'
        try:
            new_span_hz = float(cmd_parameter(response))
        except ValueError:
            return
        old_span_hz = cls.display_span_hz[receiver] if cls.span_seen[receiver] else None
        cls.span_seen[receiver] = True
        cls.display_span_hz[receiver] = new_span_hz
        window = cls.windows.get(receiver)
        if window != None:
            window.on_span_hz_changed(new_span_hz)
            # Same "a change happened, not just the initial seed" logic
            # as the shared _trigger_auto_ref (mode/antenna change), but
            # via schedule_ref_reset rather than on_ref_button directly
            # -- unlike those, a span change needs the K4's PAN stream a
            # moment to actually settle at the new resolution first (see
            # _ref_reset_timer's comment in Panadapter.__init__).
            if old_span_hz != None and old_span_hz != new_span_hz:
                window.schedule_ref_reset()

    @classmethod
    def on_mode_changed(cls, response):
        receiver = 'sub' if cmd_base(response).endswith('$') else 'main'
        # Mode changes no longer auto-reset Ref -- only span and
        # antenna changes do (see _trigger_auto_ref).
        cls.mode[receiver] = cmd_parameter(response)
        window = cls.windows.get(receiver)
        if window != None:
            window._update_autospot_enabled()

    @classmethod
    def on_antenna_changed(cls, response):
        receiver = 'sub' if cmd_base(response).endswith('$') else 'main'
        old = cls.antenna[receiver]
        cls.antenna[receiver] = cmd_parameter(response)
        cls._trigger_auto_ref(receiver, old, cls.antenna[receiver])

    @classmethod
    def on_tx_antenna_changed(cls, response):
        # AN (TX antenna) -- see tx_antenna's own comment for why this
        # needs to be its own auto-Ref trigger, distinct from AR/AR$:
        # a receiver parked on AR/AR$ value 2 ("RX USES TX ANT") keeps
        # reporting that same "2" when AN changes underneath it, so
        # on_antenna_changed's old-vs-new AR comparison never fires
        # even though the antenna actually feeding that receiver did
        # change.
        old = cls.tx_antenna
        cls.tx_antenna = cmd_parameter(response)
        if old == None or old == cls.tx_antenna:
            return
        for receiver in ('main', 'sub'):
            if cls.antenna[receiver] == '2':
                window = cls.windows.get(receiver)
                if window != None:
                    window.schedule_ref_reset()

    @classmethod
    def on_sub_receiver_changed(cls, response):
        # SB (sub receiver on/off) -- only the sub panadapter cares,
        # since the main receiver is always on. Turning the sub
        # receiver on or off changes what its PAN stream actually
        # shows (no signal path at all while off), so it's an auto-Ref
        # trigger the same as an antenna or span change.
        old = cls.sub_receiver_on
        cls.sub_receiver_on = cmd_parameter(response)
        if old == None or old == cls.sub_receiver_on:
            return
        window = cls.windows.get('sub')
        if window != None:
            window.schedule_ref_reset()

    @classmethod
    def _trigger_auto_ref(cls, receiver, old, new):
        # Skip the first value ever received for a receiver (old is
        # None) -- that's just the initial cache populating, not an
        # actual change, and would otherwise fire redundantly right
        # alongside the "first displayed" trigger in panadapter_child_main.
        if old == None or old == new:
            return
        window = cls.windows.get(receiver)
        if window != None:
            # Debounced (like span/center), not on_ref_button directly:
            # switching antennas changes the signal path, and the PAN
            # stream's displayed levels take the same kind of moment to
            # settle to the new antenna's actual noise floor that a
            # span change does -- see schedule_ref_reset's own comment.
            window.schedule_ref_reset()

    @classmethod
    def is_cw_mode(cls, receiver):
        # '3' = CW, '7' = CW-R (see the yaml's mode dropdown selections).
        return cls.mode[receiver] in ('3', '7')

    @classmethod
    def is_am_mode(cls, receiver):
        # '5' = AM (see the yaml's mode dropdown selections).
        return cls.mode[receiver] == '5'

    @classmethod
    def on_bandwidth_changed(cls, response):
        # BW/BW$ report bandwidth as a 4-digit string, kHz * 100 (e.g.
        # "0500" = 5.00 kHz -- see the yaml's bandwidth dropdown
        # buttons, which build/parse the same command).
        receiver = 'sub' if cmd_base(response).endswith('$') else 'main'
        try:
            cls.bandwidth_hz[receiver] = int(cmd_parameter(response)) * 10
        except ValueError:
            pass

    @classmethod
    def on_frequency_changed(cls, response):
        # FA = VFO A = main receiver, FB = VFO B = sub receiver (the
        # same A/B split the yaml's own vfo/rit widgets use). Reported
        # as a plain Hz value, same as VFO.on_frequency_received.
        # NOT an auto-Ref trigger -- fires continuously while tuning,
        # and the genuine "panadapter center frequency changed" trigger
        # is push_frame's own center_hz comparison instead (a real
        # re-center, not ordinary tuning -- see its comment).
        receiver = 'main' if cmd_base(response) == 'FA' else 'sub'
        try:
            cls.rx_freq_hz[receiver] = float(cmd_parameter(response))
        except ValueError:
            pass

    @classmethod
    def on_fps_changed(cls, response):
        # #FPS reports PAN frames per second, as a plain number. Shared
        # -- no per-receiver ($) variant -- so this updates the FPS
        # combobox on every open window (main and sub alike), not just
        # one, same as #FPS itself has no receiver to restrict it to.
        try:
            fps = float(cmd_parameter(response))
        except ValueError:
            return
        if fps <= 0:
            return
        cls.frames_per_second = fps
        for window in cls.windows.values():
            window._set_fps_combobox(fps)
        rows = max(2, round(fps * cls.waterfall_seconds))
        if rows == cls.waterfall_rows:
            return
        cls.waterfall_rows = rows
        for window in cls.windows.values():
            window.resize_waterfall()

    @classmethod
    def on_frz_changed(cls, response):
        # #FRZ reports panadapter/waterfall freeze state, 0 (running) or
        # 1 (frozen). Shared -- no per-receiver ($) variant, same as
        # #FPS -- so this updates the Freeze button on every open
        # window, not just one.
        param = cmd_parameter(response)
        if param not in ('0', '1'):
            return
        frozen = param == '1'
        cls.frozen = frozen
        for window in cls.windows.values():
            window._set_freeze_button(frozen)

    @classmethod
    def on_fxa_changed(cls, response):
        # #FXA reports DDC Fixed Tune Mode (0-4, see the Fixed Tune
        # combobox's own comment). Shared -- no per-receiver ($)
        # variant. Only reflected in the combobox when fixed tune is
        # actually active (fxt == '1') -- while tracking ('0'), the
        # combobox shows "Track" regardless of whatever #FXA last was
        # (see on_fxt_changed), so there's nothing to update here yet;
        # the cached value is picked up once #FXT1; arrives.
        param = cmd_parameter(response)
        try:
            value = int(param)
        except ValueError:
            return
        cls.fxa = value
        if cls.fxt == '1':
            for window in cls.windows.values():
                window._set_fixed_tune_combobox(value)

    @classmethod
    def on_fxt_changed(cls, response):
        # #FXT is the track/fixed toggle (0=track, 1=fixed) -- see the
        # Fixed Tune combobox's own comment. Shared, no per-receiver
        # ($) variant.
        param = cmd_parameter(response)
        if param not in ('0', '1'):
            return
        cls.fxt = param
        if param == '0':
            for window in cls.windows.values():
                window._set_fixed_tune_combobox(5)
        elif cls.fxa != None:
            for window in cls.windows.values():
                window._set_fixed_tune_combobox(cls.fxa)

    @classmethod
    def on_scale_changed(cls, response):
        # #SCL reports the panadapter's vertical scale (dB span of the
        # Y axis) as a plain number, 10-150 per the protocol -- used
        # as-is, unclamped. Shared -- no per-receiver ($) variant -- so
        # this updates the Scale combobox on every open window, same as
        # #FPS.
        try:
            cls.scale_db = float(cmd_parameter(response))
        except ValueError:
            return
        for window in cls.windows.values():
            window._set_scale_combobox(cls.scale_db)

    def __init__(self, receiver):
        # Page.top is None in the panadapter subprocess (see
        # panadapter_child_main): there is no main window there, so the
        # dialog is parentless and titles itself.
        super().__init__(Page.top, Qt.WindowType.Window)
        self.receiver = receiver
        self.bin_count = 0
        self.waterfall_buf = None
        self.axis_key = None    # forces the axis setup in push_frame to
        self.xs = None          # run on the first frame
        self.trace_history = [] # last up to 3 frames' bin data, averaged
                                  # per bin for the trace display -- see
                                  # _trace_average/push_frame

        # "Ref" button: captures a 0.5-second average of the displayed
        # trace, then pins that average as the bottom of the trace's Y
        # range -- see on_ref_button/_accumulate_ref. Once set,
        # ref_bottom overrides _update_vscale's own bottom (its top
        # keeps auto-adjusting as before) until the next Ref click.
        self.ref_capturing = False
        self.ref_sum = 0.0
        self.ref_count = 0
        self.ref_start_time = None
        self.ref_bottom = None

        # A span/antenna/center-frequency change doesn't take effect in
        # the K4's PAN stream immediately -- frames captured right
        # after one still reflect the old span, antenna's noise floor,
        # or center for roughly a moment, so an auto-Ref triggered
        # immediately (see schedule_ref_reset) ends up averaging that
        # stale/transitional data, producing a bottom barely different
        # from the old one. Delaying the actual capture lets the stream
        # settle first; single-shot and restarted (not stacked) on each
        # call so a rapid run of changes (e.g. holding an arrow key, or
        # stepping through antennas) only captures once, after things
        # stop moving.
        self._ref_reset_timer = QTimer()
        self._ref_reset_timer.setSingleShot(True)
        self._ref_reset_timer.timeout.connect(self.on_ref_button)

        # Vertical (dB) scale of the trace plot: averaged over a rolling
        # window rather than auto-ranged to the current frame's min/max
        # every frame (pyqtgraph's default), which made the scale jitter
        # continuously as the noise floor fluctuated. See push_frame.
        self.vscale_low_sum = 0.0
        self.vscale_high_sum = 0.0
        self.vscale_count = 0
        self.vscale_last_update = time.perf_counter()

        # Mini-pan: driven by the K4's actual MINI-PAN messages (see
        # push_minipan), which carry the identical PAN sub-header --
        # including their own RX field, confirmed against real
        # hardware -- so it's routed exactly like PAN data (see
        # Server.received_minipan). Cropped to a span picked from the
        # receiver's current mode.
        self.minipan_axis_key = None
        self.minipan_xs = None
        self.minipan_history = [] # last up to 3 frames' bin data,
                                  # averaged per bin for display -- same
                                  # idea as trace_history/_trace_average
        self.last_center_hz = None

        # Receiver bandwidth (BW;/BW$;), for shading the trace -- see
        # the bw_region setup below and push_frame.
        self.bw_key = None

        # Frequency line positions -- see _update_freq_line.
        self.freq_line_a_hz = None
        self.freq_line_b_hz = None

        label = 'Sub' if receiver == 'sub' else 'Main'
        if Page.top != None:
            prefix = Page.top.windowTitle()
        else:
            prefix = f'K4-Companion {version}'
        self.setWindowTitle(f'{prefix} {label} Panadapter')

        layout = QVBoxLayout(self)
        layout.setContentsMargins(4, 4, 4, 4)

        self.minipan_plot = pyqtgraph.PlotWidget()
        self.minipan_plot.setBackground('k')
        self.minipan_plot.showGrid(x=True, y=True, alpha=0.25)
        self.minipan_plot.getPlotItem().hideAxis('left')
        self.minipan_plot.getPlotItem().hideAxis('bottom')
        self.minipan_plot.setMouseEnabled(x=False, y=False)
        # pyqtgraph's own auto-range ('A') button would otherwise appear
        # on hover -- pointless here since the axes are always set
        # explicitly (see the Y range below/push_minipan) and never left
        # to pyqtgraph's auto-range.
        self.minipan_plot.getPlotItem().hideButtons()
        # Bandwidth shading, same as the trace's bw_region below (see
        # _update_bw_region) -- added before the curve so the
        # (translucent) shading renders behind it rather than over it.
        self.minipan_bw_region = pyqtgraph.LinearRegionItem(values=(0, 0),
            movable=False, brush=pyqtgraph.mkBrush(100, 180, 255, 90),
            pen=pyqtgraph.mkPen(None))
        self.minipan_bw_region.setVisible(False)
        self.minipan_plot.addItem(self.minipan_bw_region)
        self.minipan_curve = self.minipan_plot.plot(pen=pyqtgraph.mkPen(color=(220, 180, 80), width=1))
        # Y range is set explicitly (see push_minipan) rather than left
        # to pyqtgraph's default per-frame auto-range, which would fit
        # the peak exactly to the top of the plot -- disable that and
        # seed a plausible starting range so the plot isn't empty before
        # the first mini-pan frame lands.
        self.minipan_plot.enableAutoRange(axis='y', enable=False)
        self.minipan_plot.setYRange(-160, 0, padding=0)
        # Frequency-delta overlay, top corners -- plain child widgets
        # rather than pyqtgraph items, so their screen position doesn't
        # need to track the mini-pan's data (X/Y range) at all, only its
        # pixel size (see _position_minipan_labels).
        self.minipan_left_label = self._make_overlay_label(self.minipan_plot)
        self.minipan_right_label = self._make_overlay_label(self.minipan_plot)
        # Center-frequency marker, same idea as freq_line_a/freq_line_b below.
        # Starts hidden, matching minipan_enabled's own initial False --
        # otherwise it defaults to visible at its unset (0 Hz) position
        # until the first enable/disable message arrives from the
        # parent (see set_minipan_enabled).
        self.freq_line_minipan_hz = None
        self.freq_line_minipan = pyqtgraph.InfiniteLine(angle=90,
            pen=pyqtgraph.mkPen(color=(60, 140, 255), width=1))
        self.freq_line_minipan.setVisible(False)
        self.minipan_plot.addItem(self.freq_line_minipan)
        # Click to tune, same as the trace below -- the mini-pan's own
        # axis is in real Hz too (centered on _rx_freq_hz), so the same
        # scene-to-frequency mapping works unchanged. Its narrow span
        # makes this the finer of the two adjustments.
        self.minipan_plot.scene().sigMouseClicked.connect(self.on_minipan_clicked)
        # 1/3 the window width, left justified: setFixedWidth (kept
        # current in resizeEvent) pins both min and max width, which is
        # what makes it sit at the left of the row below rather than
        # pyqtgraph's default expanding size policy stretching it to
        # fill the row.
        # Blank (not hidden -- see set_minipan_enabled) until the parent
        # says otherwise (see panadapter_msg_minipan_enabled /
        # PanadapterProcess._update_dpm_state) -- the K4 has only one
        # mini-pan hardware stream, so whether this window's mini-pan
        # has real data depends on #DPM select and, when both
        # panadapters are open, whether the sub receiver (SB;) is
        # actually on. Staying visible (just blank) rather than being
        # hidden keeps the mini-pan's reserved width in this row, so the
        # Ref button (and anything added after it) doesn't shift
        # position when the mini-pan is enabled/disabled.
        self.minipan_enabled = False

        # Scale (#SCL;) selector -- a preset list in steps of 5 (10-150,
        # per the K4 Programmer's Reference), like Span: #SCL isn't
        # actually restricted to multiples of 5, so a radio-reported
        # value outside this list still needs to be shown -- see
        # _set_scale_combobox, same dynamic-item mechanism as Span's own
        # _set_span_combobox_khz. Shared between main/sub (no #SCL$
        # variant), so a change here updates every open window's
        # combobox the same way -- see on_scale_changed.
        scale_frame, scale_grid = qt_group_box('Scale', qt_font('Helvetica', 9))
        self.scale_combobox = QComboBox()
        self.scale_combobox.addItems([str(v) for v in Panadapter.scale_choices_db])
        # Tracks a dynamically-added item for whatever the radio's actual
        # scale is when it isn't one of the preset choices above -- same
        # reasoning as Span's _span_dynamic_khz.
        self._scale_dynamic_db = None
        self.scale_combobox.setFont(qt_font('Helvetica', 9))
        self.scale_combobox.view().setFont(qt_font('Helvetica', 9))
        self.scale_combobox.activated.connect(self.on_scale_selected)
        self.scale_combobox.setStyleSheet(
            'QComboBox { background-color: white; color: black; }'
            'QComboBox QAbstractItemView { background-color: #ccc; color: black; }')
        qt_tighten_combobox_popup(self.scale_combobox)
        if Panadapter.scale_db != None:
            self._set_scale_combobox(Panadapter.scale_db)
        scale_grid.addWidget(self.scale_combobox, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        # Span (#SPN;/#SPN$;) selector -- a plain preset-list dropdown,
        # like FPS/Fixed Tune: not editable, not steppable via Up/Down
        # or the mouse wheel, and not focusable, so those all fall
        # through to _PanControlFilter's normal VFO-nudge handling
        # instead (same as hovering anywhere else in the window) rather
        # than changing the span. Bidirectional: a local pick sends
        # #PANSPAN to the parent (see PanadapterProcess.on_span_requested),
        # and the resulting #SPN;/#SPN$; response -- from this window's
        # own request, another window, or the radio's own front panel --
        # comes back through on_span_changed/on_span_hz_changed to keep
        # the display in sync.
        span_frame, span_grid = qt_group_box('Span', qt_font('Helvetica', 9))
        self.span_combobox = QComboBox()
        self.span_combobox.addItems([str(v) for v in Panadapter.span_choices_khz])
        # Tracks the last-applied span independently of the combobox's
        # own displayed text -- see request_span for why. Starts at the
        # combobox's own initial (index-0) item; corrected immediately
        # once the real value arrives via on_span_hz_changed, same as
        # the combobox's displayed text is.
        self.span_khz = Panadapter.span_choices_khz[0]
        # Tracks a dynamically-added item for whatever the radio's
        # actual span is when it isn't one of the preset choices above
        # -- see _set_span_combobox_khz for why that's needed, and why
        # this is tracked (so a later value replaces it instead of
        # leaving stale extra entries piled up in the list).
        self._span_dynamic_khz = None
        self.span_combobox.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.span_combobox.setFont(qt_font('Helvetica', 9))
        self.span_combobox.view().setFont(qt_font('Helvetica', 9))
        self.span_combobox.activated.connect(self.on_span_selected)
        self.span_combobox.setStyleSheet(
            'QComboBox { background-color: white; color: black; }'
            'QComboBox QAbstractItemView { background-color: #ccc; color: black; }')
        qt_tighten_combobox_popup(self.span_combobox)
        span_grid.addWidget(self.span_combobox, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        # FPS (#FPS;) selector -- every valid value (1-30, per the K4
        # Programmer's Reference) enumerated, so unlike Span there's no
        # need for an editable/steppable combobox to reach values outside
        # a preset list. Shared between main/sub (no #FPS$ variant), so
        # a change here updates every open window's combobox the same
        # way -- see on_fps_changed/_set_fps_combobox.
        fps_frame, fps_grid = qt_group_box('FPS', qt_font('Helvetica', 9))
        self.fps_combobox = QComboBox()
