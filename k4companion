    def _make_overlay_label(self, parent):
        # Plain child widget rather than a pyqtgraph item, so its screen
        # position only needs to track the parent plot's pixel size, not
        # its data (X/Y range) at all -- see _position_overlay_labels.
        overlay_label = QLabel('', parent)
        overlay_label.setFont(qt_font('Helvetica', 9))
        overlay_label.setStyleSheet('QLabel { color: #ffff99; background: transparent; }')
        overlay_label.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
        return overlay_label

    @staticmethod
    def _position_overlay_labels(widget, left_label, right_label, center_label=None):
        margin = 2
        left_label.adjustSize()
        left_label.move(margin, margin)
        right_label.adjustSize()
        right_label.move(widget.width() - right_label.width() - margin, margin)
        if center_label != None:
            center_label.adjustSize()
            center_label.move((widget.width() - center_label.width()) // 2, margin)

    def _update_minipan_width(self):
        self.minipan_plot.setFixedWidth(max(1, self.width() // 2))
        self._position_minipan_labels()

    def _position_minipan_labels(self):
        self._position_overlay_labels(self.minipan_plot,
            self.minipan_left_label, self.minipan_right_label)

    def _position_trace_labels(self):
        # Unlike the mini-pan (whose axes are fully hidden), the trace
        # keeps its left (dB) axis -- so the left label sits just to the
        # right of it, past its reserved pixel width, rather than
        # overlapping the axis's own tick numbers.
        margin = 2
        left_offset = self.trace_plot.getPlotItem().getAxis('left').width()
        self.trace_left_label.adjustSize()
        self.trace_left_label.move(int(left_offset) + margin, margin)
        self.trace_right_label.adjustSize()
        self.trace_right_label.move(
            self.trace_plot.width() - self.trace_right_label.width() - margin, margin)
        self.trace_center_label.adjustSize()
        self.trace_center_label.move(
            (self.trace_plot.width() - self.trace_center_label.width()) // 2, margin)

    def set_geometry(self):
        Server.settings.load()
        geometry = Server.settings.get('Window', f'Panadapter.{self.receiver}.geometry')
        if geometry == None:
            return
        w, h, x, y = split_geometry(geometry)
        screen = QApplication.primaryScreen().availableGeometry()
        screen_width, screen_height = screen.width(), screen.height()
        x_offset = screen_width - (x + w)
        y_offset = screen_height - (y + h)
        if x_offset < 0:
            x += x_offset
        if y_offset < 0:
            y += y_offset
        if x < 0:
            x = 0
        if y < 0:
            y = 0
        self.resize(w, h)
        self.move(x, y)

    def save_geometry(self):
        geometry = f'{self.width()}x{self.height()}{self.x():+}{self.y():+}'
        if Panadapter.child_mode:
            # Only the parent writes the settings file. Two processes
            # doing configparser read-modify-write on it would race, and
            # this runs on every move and resize. Remember it instead;
            # panadapter_child_main() reports it to the parent on exit.
            Panadapter.child_geometry = geometry
            return
        Server.settings.put_save('Window', f'Panadapter.{self.receiver}.geometry', geometry)

    def set_splitter_sizes(self):
        Server.settings.load()
        sizes_str = Server.settings.get('Window', f'Panadapter.{self.receiver}.splitter')
        if sizes_str == None:
            return
        try:
            sizes = [int(size) for size in sizes_str.split(':')]
        except ValueError:
            return
        if len(sizes) != 2:
            return
        self.trace_waterfall_splitter.setSizes(sizes)

    def save_splitter_sizes(self):
        sizes = self.trace_waterfall_splitter.sizes()
        sizes_str = f'{sizes[0]}:{sizes[1]}'
        if Panadapter.child_mode:
            # Same reasoning as save_geometry(): only the parent writes
            # the settings file, so this is remembered here and reported
            # to the parent on exit instead (see panadapter_child_main).
            Panadapter.child_splitter_sizes = sizes_str
            return
        Server.settings.put_save('Window', f'Panadapter.{self.receiver}.splitter', sizes_str)

    def moveEvent(self, event):
        super().moveEvent(event)
        self.save_geometry()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._update_minipan_width()
        self._position_trace_labels()
        self.save_geometry()

    def closeEvent(self, event):
        # Closing the window ends the subprocess, and the parent takes
        # that exit as the user having closed it (see
        # PanadapterProcess.on_exited) -- it owns the settings file and
        # the persisted "was open" flag.
        Panadapter.windows.pop(self.receiver, None)
        super().closeEvent(event)

    def raise_to_front(self):
        # The Pan button was clicked while this window was already open
        # (see PanadapterProcess.open_window). showNormal() first so a
        # minimized window comes back rather than just being restacked
        # while still minimized; raise_() restacks it, and
        # activateWindow() gives it focus. Which of the last two
        # actually takes effect is up to the window manager -- some
        # refuse focus stealing from a process that has no window with
        # focus, which is exactly the case here since the click landed
        # on the main window, in the parent process.
        if self.isMinimized():
            self.showNormal()
        self.raise_()
        self.activateWindow()

    def push_frame(self, center_hz, sample_rate, bins):
        # sample_rate is the complex sample rate in kHz -- NOT Hz per
        # bin, which is what this assumed until the frequency scale was
        # found to be stretched about the center (correct at center_hz,
        # progressively wrong toward both edges). The units aren't
        # apparent from the protocol draft, which just calls the field a
        # sample rate; what settles it is that the frame's full bin set
        # is one FFT across exactly that rate, making the real
        # resolution sample_rate * 1000 / full_bin_count. For the values
        # seen from real hardware (full_bin_count=1024, sample_rate=192)
        # that is a standard 192 kHz rate over a 1024-point FFT =
        # 187.5 Hz/bin spanning 192 kHz, not the 192 Hz/bin spanning
        # ~197 kHz assumed before.
        #
        # Reading it as Hz/bin stretched every offset from the center by
        # 1024/1000 = 2.4%, which measured as ~2.3 kHz at the edges of a
        # 200 kHz span, ~1.2 kHz at 100 kHz, and put a signal truly at
        # 740 kHz (per the mini-pan, too narrow for the error to show)
        # at 740.96 kHz on the trace. Confirmed on the air after the
        # fix: the trace and the mini-pan agree across a full span, not
        # just at the center -- which is the check that distinguishes a
        # wrong resolution (a stretch, zero error at center_hz and
        # growing with distance from it) from a wrong center.
        full_bins = bins
        if len(full_bins) == 0:
            return
        hz_per_bin = sample_rate * 1000 / len(full_bins)
        # The K4 oversamples beyond what's useful to display, so crop to
        # the center display_span_hz of that full span rather than
        # showing all of it.
        display_span_hz = Panadapter.display_span_hz[self.receiver]
        bins = self._crop_bins(full_bins, hz_per_bin, display_span_hz)

        self._ensure_bin_count(len(bins))
        data = numpy.array(bins, dtype=numpy.float32)
        span_hz = hz_per_bin * self.bin_count

        # Everything below that depends only on the X axis (and not on
        # this frame's samples) is recomputed only when the axis
        # actually changes -- normally never, since the radio sits on
        # one frequency. It is not just redundant work: setXRange
        # cascades through the waterfall's XLink into both axes'
        # updateAutoSIPrefix/_updateLabel, re-rendering the axis label
        # HTML every frame. Skipping it when nothing moved cuts the
        # main-thread time per frame by about a third, which matters
        # because that time is held with the GIL and starves the audio
        # output thread (see Audio.output_loop) into dropouts.
        # center_hz is this frame's display center, not necessarily the
        # receiver's actual tuned frequency (they can diverge) -- kept
        # as a fallback for the frequency line/mini-pan centering below,
        # for use only until the real frequency arrives via FA;/FB;.
        #
        # A genuine center move (re-center, click-to-tune, VFO tracking
        # onto a new frequency) is also one of the auto-Ref triggers --
        # see _trigger_auto_ref/on_span_changed for the others. Detected
        # here, by comparing this frame's center_hz against the last
        # one, rather than from FC;/FC$; or the tune/VFO request paths,
        # because none of those guarantee the PAN stream's own center
        # actually moved (or by how much) -- this is the one source
        # that can't be wrong about it. Same "skip the first frame ever
        # seen" guard as span/mode/antenna (old None means just-opened,
        # not a change), and same debounced schedule_ref_reset (not
        # on_ref_button directly) as span, since a center move shares
        # the same "stream needs a moment to settle" issue.
        old_center_hz = self.last_center_hz
        self.last_center_hz = center_hz
        if old_center_hz != None and old_center_hz != center_hz:
            self.schedule_ref_reset()
        # Anchored to THIS FRAME'S OWN center_hz, not _rx_freq_hz() --
        # tried that (matching push_minipan/freq_line_a/freq_line_b/bw_region's
        # use of the receiver's real tuned frequency, FA;/FB;), reasoning
        # that center_hz "can diverge" from it (see the mini-pan's own
        # comment). That broke live tracking: the PAN stream's displayed
        # center isn't guaranteed to follow the VFO in real time the way
        # FA;/FB; does, so anchoring on _rx_freq_hz() relabeled the axis
        # immediately on a frequency change while the bin *content*
        # still reflected wherever the PAN stream itself was centered --
        # the curve's shape stayed visually frozen under new labels
        # instead of moving. center_hz always matches what the bins
        # actually contain, so the trace tracks correctly; the earlier
        # ~1kHz mismatch against the mini-pan is the PAN stream's own
        # center precision, not something fixable by relabeling it.
        axis_key = (center_hz, span_hz, self.bin_count, Panadapter.waterfall_rows)
        axis_changed = axis_key != self.axis_key
        if axis_changed:
            self.axis_key = axis_key
            left_edge = center_hz - span_hz / 2
            right_edge = center_hz + span_hz / 2
            # Bin i's center frequency -- NOT numpy.linspace(left_edge,
            # right_edge, bin_count), which divides the span into
            # bin_count-1 intervals for bin_count points, so each point
            # lands span/(bin_count-1) apart rather than the true
            # hz_per_bin apart, and forces the two outermost bins out to
            # sit exactly on the nominal edges instead of correctly
            # inset by half a bin.
            self.xs = left_edge + (numpy.arange(self.bin_count) + 0.5) * hz_per_bin
            # The view/labels still span the full nominal edges, same
            # as before -- only the bin positions within it changed.
            self.trace_plot.setXRange(left_edge, right_edge, padding=0)
            self._update_trace_labels(center_hz, span_hz)
            # bin_count changed, so any frames already in trace_history
            # are the wrong shape to average against this one.
            self.trace_history.clear()

        self._update_freq_line()
        self._update_bw_region()
        # The trace displays each bin averaged over the last 3 frames
        # received for it, rather than this frame's value alone -- the
        # waterfall and the Y-scale averaging below still use this
        # frame's own full-resolution data.
        trace_data = self._trace_average(data)
        self.trace_curve.setData(self.xs, trace_data)
        if self.ref_capturing:
            self._accumulate_ref(trace_data)
        self._push_waterfall_row(data)
        self._update_vscale(data)
        if axis_changed:
            # setRect() must come after the setImage() above (inside
            # _push_waterfall_row), not before: pyqtgraph's ImageItem
            # silently discards a rect set before it has any image data,
            # which on the very first frame -- the only frame this runs
            # on, since the axis normally never changes again -- left
            # the waterfall's Y axis auto-ranging against a meaningless
            # bounding rect instead of the real 0..waterfall_rows one.
            # The visible symptom was the whole scrolling history being
            # squeezed into a handful of banded rows, with the trace
            # panel (which never touches ImageItem) unaffected. Without
            # this, the image also sits at its own pixel-index
            # coordinates (0..bin_count) while waterfall_plot's X view
            # (XLink'd to trace_plot) shows real Hz values -- entirely
            # off-screen, so nothing appeared to display at all.
            # left_edge/right_edge (not self.xs, which is now the inset
            # bin centers -- see above) so the image spans the same
            # nominal edges as the trace's own view range.
            self.waterfall_img.setRect(left_edge, 0, right_edge - left_edge, Panadapter.waterfall_rows)
            self.waterfall_plot.setYRange(0, Panadapter.waterfall_rows, padding=0)

    def _update_vscale(self, data):
        # Averaged over 5 seconds rather than fit to every single
        # frame (pyqtgraph's default auto-range): the noise floor
        # fluctuates enough frame to frame that auto-ranging made the
        # trace's dB scale visibly jitter/rescale continuously.
        self.vscale_low_sum += float(data.min())
        self.vscale_high_sum += float(data.max())
        self.vscale_count += 1
        now = time.perf_counter()
        if now - self.vscale_last_update < 5.0:
            return
        avg_low = self.vscale_low_sum / self.vscale_count
        avg_high = self.vscale_high_sum / self.vscale_count
        margin = max((avg_high - avg_low) * 0.1, 1.0)
        # A pinned Ref bottom (see on_ref_button) overrides the
        # auto-computed one here so it stays put across these periodic
        # updates instead of being overwritten a few seconds later --
        # the top still auto-adjusts as usual. If the signal then drops
        # well below a high-pinned Ref bottom, avg_high + margin could
        # otherwise end up below it -- pyqtgraph silently swaps an
        # inverted min/max, which would visibly un-pin the bottom, so
        # the top is always kept above it.
        low = self.ref_bottom if self.ref_bottom != None else avg_low - margin
        # A known #SCL sets the range's total height (see
        # on_scale_changed) directly rather than fitting the top to the
        # data -- the radio's own vertical-scale setting, not something
        # derived from what's currently on screen.
        if Panadapter.scale_db != None:
            high = low + Panadapter.scale_db
        else:
            high = max(avg_high + margin, low + 1.0)
        self.trace_plot.setYRange(low, high, padding=0)
        self.vscale_low_sum = 0.0
        self.vscale_high_sum = 0.0
        self.vscale_count = 0
        self.vscale_last_update = now

    @staticmethod
    def _crop_bins(bins, hz_per_bin, span_hz):
        full_bin_count = len(bins)
        crop_count = min(full_bin_count, max(1, round(span_hz / hz_per_bin)))
        start = (full_bin_count - crop_count) // 2
        return bins[start:start + crop_count]

    def _trace_average(self, data):
        return self._rolling_average(self.trace_history, data)

    def _minipan_average(self, data):
        return self._rolling_average(self.minipan_history, data)

    @staticmethod
    def _rolling_average(history, data):
        # Rolling per-bin average over the last 3 frames received,
        # oldest dropped as each new one arrives -- smooths the display
        # over time rather than across neighboring bins. Fewer than 3
        # frames collected yet (right after startup or an axis change)
        # just averages however many there are so far.
        history.append(data)
        if len(history) > 3:
            history.pop(0)
        return numpy.mean(history, axis=0)

    def on_ref_button(self):
        self.ref_capturing = True
        self.ref_sum = 0.0
        self.ref_count = 0
        self.ref_start_time = time.perf_counter()

    def schedule_ref_reset(self):
        # See _ref_reset_timer's own comment (in __init__) for why
        # span/antenna/center-frequency changes need this delay
        # instead of just calling on_ref_button() directly, unlike the
        # panadapter's initial display (panadapter_child_main), which
        # has no prior data to still be settling from.
        self._ref_reset_timer.start(300)

    def on_center_button(self):
        # Relayed to the parent, which owns the actual K4 connection
        # (see PanadapterProcess.on_center_requested) -- same channel
        # as request_tune, for the same reason: it has to reach the
        # radio right away.
        self._write_to_parent('#PANCENTER')

    def on_autospot_button(self):
        # Relayed to the parent, same channel and reason as
        # on_center_button -- see PanadapterProcess.on_spot_requested
        # for the actual SP3;/SP$3; split.
        self._write_to_parent('#PANSPOT')

    def _update_autospot_enabled(self):
        # SP3;/SP$3; only makes sense in CW/CW-R -- see
        # Panadapter.on_mode_changed, which calls this on every MD;/MD$;
        # change, and __init__, which calls it once for the receiver's
        # initial (possibly still-unknown, i.e. disabled) mode.
        self.autospot_button.setEnabled(Panadapter.is_cw_mode(self.receiver))

    def on_freeze_button(self):
        self.request_freeze(not Panadapter.frozen)

    def request_freeze(self, frozen):
        # Updated locally right away, same reasoning as request_span/
        # request_fps -- otherwise this button would lag until the
        # round trip through the radio (via #FRZ;) comes back. Other
        # open windows pick it up from that round trip instead, same as
        # they do for Span/FPS.
        self._set_freeze_button(frozen)
        self._write_to_parent(f'#PANFRZ {1 if frozen else 0}')

    def _set_freeze_button(self, frozen):
        # Also updates the shared class-level flag (not just this
        # window's own button) -- otherwise on_freeze_button's "not
        # Panadapter.frozen" would keep reading the stale value between
        # clicks and this window's own repeated clicks would toggle the
        # same way every time instead of alternating, until a #FRZ;
        # response happened to come back and correct it.
        Panadapter.frozen = frozen
        self.freeze_button.setText('Unfreeze' if frozen else 'Freeze')

    def on_fixed_tune_selected(self, index):
        self.request_fixed_tune(self.fixed_tune_combobox.itemData(index))

    def request_fixed_tune(self, value):
        # Updated locally right away, same reasoning as request_span/
        # request_fps/request_freeze -- otherwise this combobox would
        # lag until the round trip through the radio comes back.
        self._set_fixed_tune_combobox(value)
        self._write_to_parent(f'#PANFXA {value}')

    def _set_fixed_tune_combobox(self, value):
        # Also updates the shared class-level cache (not just this
        # window's own combobox) -- same reasoning as
        # _set_freeze_button: on_fxa_changed/on_fxt_changed both read
        # Panadapter.fxa/fxt to decide what a future #FXA;/#FXT;
        # response should do, so a local selection here needs to keep
        # that cache current too, not just this window's display.
        Panadapter.fxt = '0' if value == 5 else '1'
        if value != 5:
            Panadapter.fxa = value
        index = self.fixed_tune_combobox.findData(value)
        if index >= 0 and self.fixed_tune_combobox.currentIndex() != index:
            self.fixed_tune_combobox.setCurrentIndex(index)

    def request_vfo_action(self, action):
        # Relayed to the parent (see
        # PanadapterProcess.on_vfo_action_requested), same channel and
        # reason as request_tune -- see _PanControlFilter for what
        # triggers this and the 'action' strings it sends.
        self._write_to_parent(f'#PANVFO {action}')

    def on_span_selected(self, index):
        span_khz = self._current_span_combobox_khz()
        if span_khz != None:
            self.request_span(span_khz)

    def _current_span_combobox_khz(self):
        try:
            return int(round(float(self.span_combobox.currentText())))
        except ValueError:
            return None

    def request_span(self, span_khz):
        span_khz = max(Panadapter.span_min_khz, min(Panadapter.span_max_khz, span_khz))
        # Triggered locally right away, the same as clicking Ref, rather
        # than relying solely on the #SPN;/#SPN$; response's own
        # old-vs-new comparison (see on_span_changed/_trigger_auto_ref)
        # -- that path still exists for a span change originating
        # elsewhere (the radio's front panel, say), but this window's
        # own request is the common case and shouldn't depend on a round
        # trip through the radio to visibly reset.
        #
        # Compared against self.span_khz, NOT the combobox's own
        # currentText() -- picking an item from the dropdown list
        # updates the combobox's displayed text as part of Qt's normal
        # handling *before* on_span_selected (and so this method) ever
        # runs, so by the time this runs, currentText() already shows
        # the new value and a same-vs-new comparison against it would
        # always see "no change" and skip the Ref reset.
        if span_khz != self.span_khz:
            self.schedule_ref_reset()
        self.span_khz = span_khz
        # Updated locally right away rather than waiting on the round
        # trip through the radio (see on_span_hz_changed for that side).
        self._set_span_combobox_khz(span_khz)
        self._write_to_parent(f'#PANSPAN {span_khz}')

    def on_span_hz_changed(self, span_hz):
        # Called for any #SPN;/#SPN$; response for this receiver --
        # this window's own request, another source's, or the radio's
        # own front panel -- see Panadapter.on_span_changed. Keeps
        # self.span_khz in sync too (see request_span) so a later local
        # request compares against the radio's actual last-known span,
        # not a stale value from before this update.
        self.span_khz = round(span_hz / 1000)
        self._set_span_combobox_khz(self.span_khz)

    def _set_span_combobox_khz(self, span_khz):
        # Now that the combobox isn't editable, setCurrentText() can
        # only ever select an item that's actually in the list -- it
        # silently does nothing otherwise -- but the radio's actual
        # span isn't limited to the preset choices, so a value outside
        # that list needs to be added (once, replacing any previous
        # such addition rather than piling up) for it to be reflected
        # here at all.
        if span_khz in Panadapter.span_choices_khz:
            if self._span_dynamic_khz != None:
                index = self.span_combobox.findText(str(self._span_dynamic_khz))
                if index >= 0:
                    self.span_combobox.removeItem(index)
                self._span_dynamic_khz = None
        elif span_khz != self._span_dynamic_khz:
            if self._span_dynamic_khz != None:
                index = self.span_combobox.findText(str(self._span_dynamic_khz))
                if index >= 0:
                    self.span_combobox.removeItem(index)
            self.span_combobox.addItem(str(span_khz))
            self._span_dynamic_khz = span_khz
        text = str(span_khz)
        if self.span_combobox.currentText() != text:
            self.span_combobox.setCurrentText(text)

    def on_fps_selected(self, index):
        try:
            fps = int(self.fps_combobox.itemText(index))
        except ValueError:
            return
        self.request_fps(fps)

    def request_fps(self, fps):
        fps = max(Panadapter.fps_min, min(Panadapter.fps_max, fps))
        # Updated locally right away, same reasoning as request_span --
        # otherwise the combobox would visibly lag until the round trip
        # through the radio (via #FPS;) comes back.
        self._set_fps_combobox(fps)
        self._write_to_parent(f'#PANFPS {fps}')

    def _set_fps_combobox(self, fps):
        text = str(round(fps))
        if self.fps_combobox.currentText() != text:
            self.fps_combobox.setCurrentText(text)

    def on_scale_selected(self, index):
        try:
            scale_db = int(self.scale_combobox.itemText(index))
        except ValueError:
            return
        self.request_scale(scale_db)

    def request_scale(self, scale_db):
        scale_db = max(Panadapter.scale_min, min(Panadapter.scale_max, scale_db))
        # Updated locally right away, same reasoning as request_fps --
        # otherwise the combobox would visibly lag until the round trip
        # through the radio (via #SCL;) comes back.
        self._set_scale_combobox(scale_db)
        self._write_to_parent(f'#PANSCL {scale_db}')

    def _set_scale_combobox(self, scale_db):
        # Same dynamic-item mechanism as _set_span_combobox_khz: the
        # combobox only lists multiples of 5, but #SCL isn't actually
        # restricted to those, so a value outside that list needs to be
        # added (once, replacing any previous such addition rather than
        # piling up) for it to be reflected here at all.
        scale_db = round(scale_db)
        if scale_db in Panadapter.scale_choices_db:
            if self._scale_dynamic_db != None:
                index = self.scale_combobox.findText(str(self._scale_dynamic_db))
                if index >= 0:
                    self.scale_combobox.removeItem(index)
                self._scale_dynamic_db = None
        elif scale_db != self._scale_dynamic_db:
            if self._scale_dynamic_db != None:
                index = self.scale_combobox.findText(str(self._scale_dynamic_db))
                if index >= 0:
                    self.scale_combobox.removeItem(index)
            self.scale_combobox.addItem(str(scale_db))
            self._scale_dynamic_db = scale_db
        text = str(scale_db)
        if self.scale_combobox.currentText() != text:
            self.scale_combobox.setCurrentText(text)

    def _write_to_parent(self, line):
        try:
            sys.stdout.write(line + '\n')
            sys.stdout.flush()
        except (BrokenPipeError, ValueError, OSError):
            pass

    def _accumulate_ref(self, trace_data):
        self.ref_sum += float(trace_data.sum())
        self.ref_count += trace_data.size
        if time.perf_counter() - self.ref_start_time < 0.5:
            return
        self.ref_capturing = False
        self.ref_bottom = self.ref_sum / self.ref_count
        if Panadapter.scale_db != None:
            top = self.ref_bottom + Panadapter.scale_db
        else:
            # The current top is whatever the last auto/Ref update left
            # it at, with no guarantee it's above this newly captured
            # average -- passing an inverted range to setYRange gets
            # silently swapped by pyqtgraph, which would visibly un-pin
            # the bottom.
            top = max(self.trace_plot.viewRange()[1][1], self.ref_bottom + 1.0)
        self.trace_plot.setYRange(self.ref_bottom, top, padding=0)

    def _update_bw_region(self):
        mode = Panadapter.mode[self.receiver]
        if mode == '4':
            # FM's channel bandwidth is a fixed 12.5 kHz, not the
            # user-adjustable filter every other mode reports via
            # BW;/BW$; -- so this doesn't wait on (or need) bandwidth_hz.
            bw_hz = 12500
        else:
            bw_hz = Panadapter.bandwidth_hz[self.receiver]
            if bw_hz == None:
                return
            # Shade twice the reported bandwidth in AM mode.
            if Panadapter.is_am_mode(self.receiver):
                bw_hz *= 2
        freq_hz = self._rx_freq_hz()
        bw_key = (freq_hz, bw_hz, mode)
        if bw_key == self.bw_key:
            return
        self.bw_key = bw_key
        if mode in ('2', '6'):        # USB, DATA: passband is above center.
            region = (freq_hz, freq_hz + bw_hz)
        elif mode in ('1', '9'):      # LSB, DATA-R: passband is below center.
            region = (freq_hz - bw_hz, freq_hz)
        else:                         # CW/CW-R/AM/FM: centered.
            region = (freq_hz - bw_hz / 2, freq_hz + bw_hz / 2)
        self.bw_region.setRegion(region)
        self.bw_region.setVisible(True)
        # Same shading on the mini-pan -- both plots are centered on the
        # same _rx_freq_hz(), so no separate calculation is needed, only
        # gated by minipan_enabled the same way freq_line_minipan is
        # (see set_minipan_enabled, which copies this across immediately
        # on enable rather than waiting for the next recompute here).
        self.minipan_bw_region.setRegion(region)
        self.minipan_bw_region.setVisible(self.minipan_enabled)

    def _rx_freq_hz(self):
        # The receiver's real tuned frequency (FA;/FB;), falling back
        # to the last PAN frame's own display center only until that
        # has arrived -- see the rx_freq_hz comment.
        freq_hz = Panadapter.rx_freq_hz[self.receiver]
        return freq_hz if freq_hz != None else self.last_center_hz

    def _update_freq_line(self):
        vfo_a_hz = Panadapter.rx_freq_hz['main']
        if vfo_a_hz != self.freq_line_a_hz:
            self.freq_line_a_hz = vfo_a_hz
            visible = vfo_a_hz != None
            self.freq_line_a.setVisible(visible)
            self.freq_line_a_waterfall.setVisible(visible)
            if visible:
                self.freq_line_a.setPos(vfo_a_hz)
                self.freq_line_a_waterfall.setPos(vfo_a_hz)
        vfo_b_hz = Panadapter.rx_freq_hz['sub']
        if vfo_b_hz != self.freq_line_b_hz:
            self.freq_line_b_hz = vfo_b_hz
            visible = vfo_b_hz != None
            self.freq_line_b.setVisible(visible)
            self.freq_line_b_waterfall.setVisible(visible)
            if visible:
                self.freq_line_b.setPos(vfo_b_hz)
                self.freq_line_b_waterfall.setPos(vfo_b_hz)

    def on_trace_clicked(self, event):
        freq_hz = self._clicked_frequency(self.trace_plot, event)
        if freq_hz != None:
            self.request_tune(freq_hz, round_to_hz=100)

    def on_waterfall_clicked(self, event):
        freq_hz = self._clicked_frequency(self.waterfall_plot, event)
        if freq_hz != None:
            self.request_tune(freq_hz, round_to_hz=1000)

    def on_minipan_clicked(self, event):
        if not self.minipan_enabled:
            # Blank rather than hidden while disabled (see
            # set_minipan_enabled), so it can still be clicked -- but
            # there is nothing displayed to have been aiming at, and its
            # axis is frozen at whatever was last shown, so a click here
            # would tune to a stale frequency.
            return
        freq_hz = self._clicked_frequency(self.minipan_plot, event)
        if freq_hz != None:
            self.request_tune(freq_hz, round_to_hz=1)

    @staticmethod
    def _clicked_frequency(plot, event):
        # Returns the frequency the click landed on, or None if it isn't
        # a tuning click at all.
        if event.button() != Qt.MouseButton.LeftButton:
            return None
        view_box = plot.getPlotItem().getViewBox()
        if not view_box.sceneBoundingRect().contains(event.scenePos()):
            return None  # e.g. a click that landed on the axis/label margin
        return view_box.mapSceneToView(event.scenePos()).x()

    def request_tune(self, freq_hz, round_to_hz):
        # Relayed to the parent, which owns the actual K4 connection
        # (see PanadapterProcess.on_tune_requested) -- over the same
        # stdout channel save_geometry/save_splitter_sizes report
        # through at exit, except this has to reach the radio right
        # away, which is why monitor_loop processes lines as they
        # arrive rather than only once at exit.
        #
        # round_to_hz is the granularity the parent should round the
        # clicked frequency to: exact Hz on the mini-pan (the finer
        # placement is the whole point of clicking there), 100 Hz on the
        # trace, and 1 kHz on the waterfall -- each coarser than the
        # last, matching how much wider a pixel is on that plot (see
        # on_trace_clicked/on_waterfall_clicked/on_minipan_clicked).
        self._write_to_parent(f'#PANTUNE {freq_hz} {round_to_hz}')

    def _update_trace_labels(self, center_hz, span_hz):
        # Same formatting as the corresponding ticks in
        # _update_frequency_ticks: the edges (i=-2/+2 there) use the
        # coarser rounding, the center uses format_freq_tick's default.
        left_hz = center_hz - span_hz / 2
        right_hz = center_hz + span_hz / 2
        self.trace_left_label.setText(format_freq_tick(left_hz, round_to=1000, drop_digits=3))
        self.trace_right_label.setText(format_freq_tick(right_hz, round_to=1000, drop_digits=3))
        self.trace_center_label.setText(format_freq_tick(center_hz))
        self._position_trace_labels()

    def push_minipan(self, center_hz, sample_rate, bins):
        # MINI-PAN carries the identical PAN sub-header as PAN frames
        # (confirmed against real hardware -- see parse_minipan_frame),
        # including its own RX field, so on_message() has already
        # routed this to the matching window same as push_frame's data.
        # Cropped to the mode-selected span around its own center_hz,
        # exactly like the main trace crops PAN data to display_span_hz
        # -- then displayed against the receiver's real tuned frequency
        # (see _rx_freq_hz), same as the frequency line, since that can
        # differ slightly from this frame's own center_hz.
        if not self.minipan_enabled:
            # Data keeps arriving from the K4 regardless of whether this
            # window's mini-pan is currently enabled (see
            # PanadapterProcess._update_dpm_state) -- ignored here so
            # the blanked-out state set_minipan_enabled(False) leaves
            # behind doesn't get immediately overwritten by the next
            # frame.
            return
        if len(bins) == 0:
            return
        # sample_rate is in kHz across the frame's full bin set, same as
        # push_frame's -- see the explanation there. The mini-pan's own
        # span is narrow enough (10 kHz, or 2 kHz in CW) that reading it
        # as Hz/bin was only ever off by ~120 Hz at the edges, which is
        # why the stretch showed up on the trace long before here.
        hz_per_bin = sample_rate * 1000 / len(bins)
        span_hz = 2000 if Panadapter.is_cw_mode(self.receiver) else 10000
        bins = self._crop_bins(bins, hz_per_bin, span_hz)
        data = numpy.array(bins, dtype=numpy.float32)
        bin_count = len(bins)
        actual_span_hz = hz_per_bin * bin_count

        freq_hz = self._rx_freq_hz()
        if freq_hz == None:
            freq_hz = center_hz

        axis_key = (freq_hz, actual_span_hz, bin_count)
        if axis_key != self.minipan_axis_key:
            self.minipan_axis_key = axis_key
            left_edge = freq_hz - actual_span_hz / 2
            right_edge = freq_hz + actual_span_hz / 2
            # Bin centers, same fix as push_frame's -- see its comment.
            self.minipan_xs = left_edge + (numpy.arange(bin_count) + 0.5) * hz_per_bin
            self.minipan_plot.setXRange(left_edge, right_edge, padding=0)
            self._update_minipan_labels(actual_span_hz)
            # bin_count changed (or this is the first frame since
            # set_minipan_enabled(True) forced axis_key to None), so any
            # frames already in minipan_history are the wrong shape --
            # or stale from before the mini-pan was disabled -- to
            # average against this one.
            self.minipan_history.clear()

        # Same 3-frame rolling per-bin average as the trace's own
        # display (see _trace_average) -- the Y-range below still uses
        # this frame's own raw data, same as the trace's waterfall/
        # vscale do.
        self.minipan_curve.setData(self.minipan_xs, self._minipan_average(data))
        self._update_minipan_yrange(data)
        self._update_minipan_freq_line(freq_hz)

    def _update_minipan_freq_line(self, freq_hz):
        if freq_hz == self.freq_line_minipan_hz:
            return
        self.freq_line_minipan_hz = freq_hz
        self.freq_line_minipan.setPos(freq_hz)

    def set_minipan_enabled(self, enabled):
        if enabled == self.minipan_enabled:
            return
        self.minipan_enabled = enabled
        self.freq_line_minipan.setVisible(enabled)
        self.minipan_bw_region.setVisible(enabled)
        if enabled:
            # Copy the trace's current shading across immediately (see
            # _update_bw_region) rather than waiting for the next
            # push_frame to recompute it, so it isn't blank for a frame
            # right after being (re-)enabled.
            self.minipan_bw_region.setRegion(self.bw_region.getRegion())
        if not enabled:
            # Leaves minipan_plot itself visible (still reserving its
            # layout space, so the Ref button doesn't shift -- see
            # __init__) but blank, rather than hiding the whole widget.
            self.minipan_curve.setData([], [])
            self.minipan_left_label.setText('')
            self.minipan_right_label.setText('')
            # Forces the axis/labels to be recomputed from scratch the
            # next time this is re-enabled, rather than skipping them
            # because nothing about the (frozen, stale) axis_key
            # actually changed since they were last set.
            self.minipan_axis_key = None

    def _update_minipan_labels(self, span_hz):
        # xs[0]/xs[-1] are always exactly freq_hz -+ span_hz/2 (see the
        # linspace above), so the deltas don't depend on freq_hz itself.
        half = span_hz / 2
        self.minipan_left_label.setText(self._format_delta_khz(-half))
        self.minipan_right_label.setText(self._format_delta_khz(half))
        self._position_minipan_labels()

    @staticmethod
    def _format_delta_khz(hz):
        khz = hz / 1000
        if khz == int(khz):
            return f'{int(khz)} kHz'
        return f'{khz:.1f} kHz'

    def _update_minipan_yrange(self, data):
        # Bottom fits the noise floor as usual; the range is 1.5x the
        # low-to-peak height a plain auto-range would use (which would
        # put the peak right at the top) -- from the same bottom, that
        # puts the peak 2/3 of the way up rather than pinned to the top:
        # peak_fraction = height / (height * 1.5) = 2/3.
        bottom = float(data.min())
        height = max(float(data.max()) - bottom, 1.0)
        top = bottom + height * 1.5
        self.minipan_plot.setYRange(bottom, top, padding=0)

    def _ensure_bin_count(self, count):
        if count != self.bin_count:
            self.bin_count = count
            # NaN, not 0: rows that haven't received data yet must not
            # take part in the level scaling below (0 is far above the
            # real dB range, so it would both wash out the color scale
            # and paint the not-yet-filled area the brightest color).
            # ImageItem renders NaN pixels transparent.
            self.waterfall_buf = numpy.full((Panadapter.waterfall_rows, count),
                numpy.nan, dtype=numpy.float32)

    def resize_waterfall(self):
        # Called when #FPS changes the derived row count. Keep the most
        # recent rows (the newest data is at the end) rather than
        # discarding the history built up so far.
        # "is None", not the "== None" used elsewhere in this file: on a
        # numpy array "== None" is an elementwise compare whose truth
        # value is ambiguous, and raises.
        if self.waterfall_buf is None:
            return
        rows = Panadapter.waterfall_rows
        resized = numpy.full((rows, self.bin_count), numpy.nan, dtype=numpy.float32)
        keep = min(rows, self.waterfall_buf.shape[0])
        resized[-keep:] = self.waterfall_buf[-keep:]
        self.waterfall_buf = resized

    def _push_waterfall_row(self, data):
        self.waterfall_buf = numpy.roll(self.waterfall_buf, -1, axis=0)
        self.waterfall_buf[-1, :] = data
        low = float(numpy.nanmin(self.waterfall_buf))
        high = float(numpy.nanmax(self.waterfall_buf))
        if high <= low:
            high = low + 1
        self.waterfall_img.setImage(self.waterfall_buf.T, autoLevels=False, levels=(low, high))

# Panadapter subprocess IPC.
#
# The panadapter is drawn in its own process because a pyqtgraph repaint
# holds the GIL on the main thread for ~5 ms typically and up to ~20 ms,
# while the audio output path tolerates only about 8 ms (the output
# device's low-latency figure) before it underruns. No amount of
# buffering fixes that in-process: during the stall the audio threads
# cannot run either, since they need the same GIL. A separate process
# has its own GIL, so its repaints cannot touch the audio path at all,
# and frames_per_buffer can stay at 2 for low transmit/tuning delay.
#
# The parent sends PAN/MINI-PAN payloads, the #SPN/#FPS/MD/BW/FA/FB
# responses, and whether this window's mini-pan currently has real data
# to show (see PanadapterProcess._update_dpm_state); the child sends
# back only its final window geometry. Messages are 4-byte big-endian
# length (of type + payload), then a type byte:
panadapter_msg_cat = 0
panadapter_msg_pan = 2
panadapter_msg_minipan = 3
panadapter_msg_minipan_enabled = 4  # payload: one byte, 0 or 1
panadapter_msg_raise = 5            # no payload -- see open_window

def panadapter_encode_msg(msg_type, payload):
    body = bytes((msg_type,)) + payload
    l = len(body)
    return bytes(((l>>24)&0xff, (l>>16)&0xff, (l>>8)&0xff, l&0xff)) + body

def panadapter_read_msg(stream):
    # Returns (type, payload), or None at end of stream.
    header = stream.read(4)
    if len(header) < 4:
        return None
    l = (header[0]<<24) | (header[1]<<16) | (header[2]<<8) | header[3]
    body = stream.read(l)
    if len(body) < l:
        return None
    return body[0], body[1:]

class PanadapterMonitorThread(QThread):
    # monitor_loop() emits queued cross-thread Qt signals (tuned/
    # centered/vfo_action/exited). A plain threading.Thread doing that
    # still works -- Qt auto-queues the delivery regardless of who
    # emitted it -- but Qt only registers/deregisters its internal
    # per-thread bookkeeping (QThreadStorage entries) in the right order
    # for threads it manages itself. A foreign thread's entries get torn
    # down via the OS's own TLS destructor ordering instead, which on
    # Windows produces "QThreadStorage: entry N destroyed before end of
    # thread" warnings when the thread exits (harmless, but noisy, and
    # not seen on Linux/macOS where the ordering happens to work out).
    # Running the same loop on a real QThread avoids it.
    def __init__(self, process):
        super().__init__()
        self.process = process

    def run(self):
        self.process.monitor_loop()

class PanadapterProcess(QObject):
    # Parent-side handle for one panadapter subprocess.
    processes = {}               # receiver ('main'/'sub') -> PanadapterProcess
    subscribed = False
    dpm_state = None             # last '#DPM' value sent to the radio
                                  # ('0' or '1'), or None -- see
                                  # _update_dpm_state/_send_dpm.
    minipan_enabled = {'main': False, 'sub': False}
                                  # Whether each window's mini-pan
                                  # currently has real data to show, per
                                  # _update_dpm_state. Relayed to the
                                  # window's subprocess on change.

    # Emitted by monitor_loop when the subprocess exits. A queued signal
    # hands it to the Qt thread: on_exited() touches the settings file
    # and the process table, and Poll.call() (used here originally)
    # builds a QTimer, which may only be created on a Qt thread.
    exited = pyqtSignal(object)

    # Emitted by monitor_loop as soon as a click-to-tune request line
    # arrives (unlike exited, this fires mid-session, not just once at
    # process exit) -- queued the same way, since on_tune_requested()
    # sends a CAT command through Server.k4_server, which must happen on
    # the Qt thread.
    tuned = pyqtSignal(str)

    # Emitted the same way as tuned, for the Center button (see
    # Panadapter.on_center_button/on_center_requested below).
    centered = pyqtSignal()

    # Emitted the same way as tuned, for the Autospot button (see
    # Panadapter.on_autospot_button/on_spot_requested below).
    spot_requested = pyqtSignal()

    # Emitted the same way as tuned, for arrow-key/mouse-wheel input in
    # the panadapter window (see Panadapter.request_vfo_action/
    # _PanControlFilter and on_vfo_action_requested below).
    vfo_action = pyqtSignal(str)

    # Emitted the same way as tuned, for the Span combobox (see
    # Panadapter.request_span and on_span_requested below).
    span_requested = pyqtSignal(str)

    # Emitted the same way as tuned, for the FPS combobox (see
    # Panadapter.request_fps and on_fps_requested below).
    fps_requested = pyqtSignal(str)

    # Emitted the same way as tuned, for the Freeze button (see
    # Panadapter.request_freeze and on_frz_requested below).
    frz_requested = pyqtSignal(str)

    # Emitted the same way as tuned, for the Fixed Tune combobox (see
    # Panadapter.request_fixed_tune and on_fxa_requested below).
    fxa_requested = pyqtSignal(str)

    # Emitted the same way as tuned, for the Scale combobox (see
    # Panadapter.request_scale and on_scale_requested below).
    scale_requested = pyqtSignal(str)

    # Relayed to a newly opened window below, from whatever's already
    # cached, since the subscriptions just below only ever fire their
    # "here's the current value" callback once, for the very first
    # window opened in the app's lifetime (see the cls.subscribed guard)
    # -- and even that one delivery is too early to help, since it runs
    # before this receiver has been added to cls.processes. Without this,
    # a window opened after the first one (or a window re-opened later)
    # started life with no BW/MD/FA/FB/etc of its own, and only found out
    # once the radio happened to spontaneously send a fresh one -- which,
    # for something like bandwidth, may not happen for the rest of the
    # session. Each subprocess keeps this state in its own memory (see
    # Panadapter.bandwidth_hz etc), so every newly opened window needs
    # its own explicit seed, not just the first one.
    relayed_cat_bases = ('#SPN', '#SPN$', '#FPS', '#FRZ', '#FXA', '#FXT', '#SCL', 'MD', 'MD$', 'BW', 'BW$', 'FA', 'FB', 'AR', 'AR$', 'AN', 'SB')

    @classmethod
    def open_window(cls, receiver):
        # Syncs the Main/Sub tab's Pan togglebutton to "On" -- the
        # counterpart of on_exited()'s "Off" sync, and needed for the
        # same reason: WPAN!/WPAN$! are purely local directives (see
        # directive()) that never arrive as a real response, so the
        # togglebutton has no other way to learn the window is open.
        # This is the one path both a user's click AND
        # restore_open_windows() (at app startup, restoring a window
        # left open from a previous session) funnel through, so it
        # covers both -- for the click, it is a harmless re-affirmation
        # of what next_selection() already set locally.
        wpan_base = 'WPAN$!' if receiver == 'sub' else 'WPAN!'
        Server.k4_server.update_k4_parameter(wpan_base, '1')
        if not cls.subscribed:
            cls.subscribed = True
            Server.k4_server.subscribe_response('#SPN;', cls.on_cat_response)
            Server.k4_server.subscribe_response('#SPN$;', cls.on_cat_response)
            Server.k4_server.subscribe_response('#FPS;', cls.on_cat_response)
            # #SCL (panadapter vertical scale) has no per-receiver ($)
            # variant, same as #FPS -- shared by both windows.
            Server.k4_server.subscribe_response('#SCL;', cls.on_cat_response)
            # #FRZ (panadapter/waterfall freeze) likewise has no
            # per-receiver ($) variant -- shared by both windows, for
            # the Freeze/Unfreeze button (see Panadapter.on_frz_changed).
            Server.k4_server.subscribe_response('#FRZ;', cls.on_cat_response)
            # #FXA/#FXT (DDC Fixed Tune mode/toggle) likewise have no
            # per-receiver ($) variant -- shared by both windows, for
            # the Fixed Tune combobox (see Panadapter.on_fxa_changed/
            # on_fxt_changed).
            Server.k4_server.subscribe_response('#FXA;', cls.on_cat_response)
            Server.k4_server.subscribe_response('#FXT;', cls.on_cat_response)
            # MD/MD$ (receiver mode) is relayed for the mini-pan's
            # bandwidth (2 kHz in CW mode, 10 kHz otherwise).
            Server.k4_server.subscribe_response('MD;', cls.on_cat_response)
            Server.k4_server.subscribe_response('MD$;', cls.on_cat_response)
            # BW/BW$ (receiver bandwidth) is relayed to shade the trace
            # around center_hz.
            Server.k4_server.subscribe_response('BW;', cls.on_cat_response)
            Server.k4_server.subscribe_response('BW$;', cls.on_cat_response)
            # FA/FB (VFO A/B -- main/sub receiver frequency) is relayed
            # for the frequency line and the mini-pan's centering,
            # neither of which can be trusted to always equal center_hz
            # (the PAN stream's own display center).
            Server.k4_server.subscribe_response('FA;', cls.on_cat_response)
            Server.k4_server.subscribe_response('FB;', cls.on_cat_response)
            # AR/AR$ (RX antenna) is relayed to trigger an automatic Ref
            # capture on change -- see Panadapter.on_antenna_changed. AN
            # (TX antenna) is relayed alongside it for the same reason
            # -- see Panadapter.on_tx_antenna_changed.
            Server.k4_server.subscribe_response('AR;', cls.on_cat_response)
            Server.k4_server.subscribe_response('AR$;', cls.on_cat_response)
            Server.k4_server.subscribe_response('AN;', cls.on_cat_response)
            # SB (sub receiver on/off) decides, together with which
            # panadapter windows are open, whether a window's mini-pan
            # has real data to show -- see _update_dpm_state. Also
            # relayed to trigger an automatic Ref capture on the sub
            # panadapter when the sub receiver is turned on/off -- see
            # Panadapter.on_sub_receiver_changed.
            Server.k4_server.subscribe_response('SB;', cls.on_sb_changed)
            Server.k4_server.subscribe_response('SB;', cls.on_cat_response)

        process = cls.processes.get(receiver)
        if process != None:
            # Already open -- the Pan button was clicked while the
            # window was up, most likely because it is buried behind
            # something else, so raise it rather than doing nothing.
            # The window belongs to the subprocess, so the parent can
            # only ask it to raise itself.
            process.send(panadapter_msg_raise, b'')
            return
        process = PanadapterProcess(receiver)
        cls.processes[receiver] = process
        for base in cls.relayed_cat_bases:
            value = Server.k4_server.k4_parameter(base)
            if value != None:
                process.send(panadapter_msg_cat, (base + value + ';').encode())
        Server.settings.put_save('Window', f'Panadapter.{receiver}.open', True)
        cls._update_dpm_state()

    @classmethod
    def close_window(cls, receiver):
        process = cls.processes.pop(receiver, None)
        if process != None:
            process.stop(user_closed=False)
        cls._update_dpm_state()

    @classmethod
    def on_sb_changed(cls, response):
        cls._update_dpm_state()

    @classmethod
    def _update_dpm_state(cls):
        # The K4 has only one mini-pan hardware stream, selected by
        # #DPM0;/#DPM1; (main/sub). With only the main panadapter open,
        # select main and its mini-pan always has data. With the sub
        # panadapter open, select sub -- but the mini-pan only has real
        # per-receiver data for both windows if the sub receiver itself
        # is actually on (SB1; most recently received from the radio);
        # if it's off (SB0;), disable both regardless of which windows
        # are open.
        main_open = 'main' in cls.processes
        sub_open = 'sub' in cls.processes

        if sub_open:
            cls._send_dpm('1')
            sb = Server.k4_server.k4_parameter('SB')
            if sb == '1':
                cls._set_minipan_enabled(main_open, True)
            elif sb == '0':
                cls._set_minipan_enabled(False, False)
            # else: SB state not known yet -- on_sb_changed reruns this
            # once the radio reports it.
        elif main_open:
            cls._send_dpm('0')
            cls._set_minipan_enabled(True, False)
        else:
            cls._set_minipan_enabled(False, False)

    @classmethod
    def _send_dpm(cls, value):
        if cls.dpm_state == value:
            return
        cls.dpm_state = value
        Server.k4_server.send_str(f'#DPM{value};')

    @classmethod
    def _set_minipan_enabled(cls, main, sub):
        for receiver, enabled in (('main', main), ('sub', sub)):
            if cls.minipan_enabled[receiver] == enabled:
                continue
            cls.minipan_enabled[receiver] = enabled
            process = cls.processes.get(receiver)
            if process != None:
                process.send(panadapter_msg_minipan_enabled, bytes((1 if enabled else 0,)))

    @classmethod
    def restore_open_windows(cls):
        for receiver in ('main', 'sub'):
            if Server.settings.getbool('Window', f'Panadapter.{receiver}.open', False):
                cls.open_window(receiver)

    @classmethod
    def close_all(cls):
        for receiver in list(cls.processes):
            cls.close_window(receiver)

    @classmethod
    def on_cat_response(cls, response):
        for process in cls.processes.values():
            process.send(panadapter_msg_cat, response.encode())

    @classmethod
    def received_pan(cls, receiver, payload):
        process = cls.processes.get(receiver)
        if process != None:
            process.send(panadapter_msg_pan, payload)

    @classmethod
    def received_minipan(cls, receiver, payload):
        process = cls.processes.get(receiver)
        if process != None:
            process.send(panadapter_msg_minipan, payload)

    def __init__(self, receiver):
        super().__init__()
        self.receiver = receiver
        self.stopping = False
        self.exited.connect(self.on_exited)
        self.tuned.connect(self.on_tune_requested)
        self.centered.connect(self.on_center_requested)
        self.spot_requested.connect(self.on_spot_requested)
        self.vfo_action.connect(self.on_vfo_action_requested)
        self.span_requested.connect(self.on_span_requested)
        self.fps_requested.connect(self.on_fps_requested)
        self.frz_requested.connect(self.on_frz_requested)
        self.fxa_requested.connect(self.on_fxa_requested)
        self.scale_requested.connect(self.on_scale_requested)

        if getattr(sys, 'frozen', False):
            argv = [sys.executable]
        else:
            argv = [sys.executable, os.path.abspath(__file__)]
        argv += ['--panadapter', receiver]

        self.process = subprocess.Popen(argv, stdin=subprocess.PIPE,
            stdout=subprocess.PIPE)

        # Bounded, and dropped rather than blocked on when full: writing
        # straight from received_pan() would put the pipe's flow control
        # on the main thread, which is exactly the stall this whole
        # arrangement exists to avoid. PAN frames are disposable.
        self.queue = queue.Queue(4)
        self.writer_thread = threading.Thread(target=self.writer_loop,
            name=f'panadapter_{receiver}_writer', daemon=True)
        self.writer_thread.start()
        self.monitor_thread = PanadapterMonitorThread(self)
        self.monitor_thread.start()

    def send(self, msg_type, payload):
        # PAN/MINI-PAN frames are the only high-frequency traffic here
        # (up to ~12/second) and are genuinely disposable -- another one
        # is always seconds away, which is the whole reason this queue
        # is small and drops rather than blocks (see its comment above).
        # Everything else (CAT relay, mini-pan enable/disable) is
        # low-frequency and one-shot: dropping e.g. a BW; relay because
        # a burst of other messages (open_window's seeding of a newly
        # opened window, in particular -- easily more than 4 messages at
        # once) happened to fill the queue first silently loses it for
        # good, since nothing will naturally resend it. Block briefly
        # for room instead; the writer thread only ever does a queue.get
        # plus a pipe write, so it drains fast enough that this is not a
        # real stall outside of a wedged child process, and even then is
        # capped rather than indefinite.
        encoded = panadapter_encode_msg(msg_type, payload)
        if msg_type in (panadapter_msg_pan, panadapter_msg_minipan):
            try:
                self.queue.put_nowait(encoded)
            except queue.Full:
                pass
            return
        try:
            self.queue.put(encoded, timeout=1)
        except queue.Full:
            pass

    def writer_loop(self):
        while True:
            msg = self.queue.get()
            if msg == None:
                return
            try:
                self.process.stdin.write(msg)
                self.process.stdin.flush()
            except (BrokenPipeError, ValueError, OSError):
                return

    def monitor_loop(self):
        # #PANTUNE/#PANCENTER/#PANVFO lines arrive throughout the
        # session (one per trace/mini-pan click, Center button press, or
        # arrow-key/wheel input) and are handled immediately;
        # #PANGEOM/#PANSPLIT are only ever written once, right before
        # the child exits, and are applied together when that exit is
        # finally seen below -- which is also how a user close of the
        # window gets back to us.
        geometry = None
        splitter_sizes = None
        try:
            for line in self.process.stdout:
                line = line.decode(errors='replace').strip()
                if line.startswith('#PANGEOM '):
                    geometry = line[len('#PANGEOM '):]
                elif line.startswith('#PANSPLIT '):
                    splitter_sizes = line[len('#PANSPLIT '):]
                elif line.startswith('#PANTUNE '):
                    self.tuned.emit(line[len('#PANTUNE '):])
                elif line == '#PANCENTER':
                    self.centered.emit()
                elif line == '#PANSPOT':
                    self.spot_requested.emit()
                elif line.startswith('#PANVFO '):
                    self.vfo_action.emit(line[len('#PANVFO '):])
                elif line.startswith('#PANSPAN '):
                    self.span_requested.emit(line[len('#PANSPAN '):])
                elif line.startswith('#PANFPS '):
                    self.fps_requested.emit(line[len('#PANFPS '):])
                elif line.startswith('#PANFRZ '):
                    self.frz_requested.emit(line[len('#PANFRZ '):])
                elif line.startswith('#PANFXA '):
                    self.fxa_requested.emit(line[len('#PANFXA '):])
                elif line.startswith('#PANSCL '):
                    self.scale_requested.emit(line[len('#PANSCL '):])
        except (ValueError, OSError):
            pass
        self.process.wait()
        self.exited.emit((geometry, splitter_sizes))

    def on_exited(self, state):
        # Back on the main thread (via Poll), so it is safe to touch the
        # settings file and the process table here.
        geometry, splitter_sizes = state
        if geometry != None:
            Server.settings.put_save('Window',
                f'Panadapter.{self.receiver}.geometry', geometry)
        if splitter_sizes != None:
            Server.settings.put_save('Window',
                f'Panadapter.{self.receiver}.splitter', splitter_sizes)
        # Syncs the Main/Sub tab's Pan togglebutton to "Off", the same
        # way a real K4 response would -- see main-pan-togglebutton /
        # sub-pan-togglebutton in the yaml, whose selections subscribe
        # to WPAN!/WPAN$! as their own "response" even though WPAN is a
        # purely local directive (see directive()) that never actually
        # arrives as one. Unconditional (runs before the stopping check
        # below) because the window is closed either way by this point,
        # whether the user closed it directly (self.stopping False) or
        # it was asked to close, e.g. by clicking the togglebutton
        # itself (self.stopping True, and already "Off" locally from
        # that click -- this just re-affirms the same state).
        wpan_base = 'WPAN$!' if self.receiver == 'sub' else 'WPAN!'
        Server.k4_server.update_k4_parameter(wpan_base, '0')
        if self.stopping:
            return
        # Not stopping, so the child went away on its own -- the user
        # closed the window. Mirror Panadapter.closeEvent's direct-close
        # behavior and clear the persisted "was open" flag.
        # _close_pipe() here matters as much as it does in stop(): without
        # it, writer_loop stays blocked forever on the now-pointless
        # queue, which (via its bound-method target) keeps this whole
        # object -- including the child's already-broken stdin pipe --
        # alive and unclosed until final interpreter teardown, when
        # closing/flushing it then raises BrokenPipeError from inside a
        # finalizer ("Exception ignored while finalizing file ...").
        self._close_pipe()
        PanadapterProcess.processes.pop(self.receiver, None)
        Server.settings.put_save('Window', f'Panadapter.{self.receiver}.open', False)
        # Same as close_window(): whether the other window's mini-pan
        # should now be enabled (e.g. the only other panadapter open is
        # main's, once this was the sub) depends on which windows are
        # open, so it needs recomputing here too -- this is the path a
        # user closing the window via its own close button takes, not
        # close_window() (that's only the parent-initiated path, e.g.
        # app shutdown).
        PanadapterProcess._update_dpm_state()

    def on_tune_requested(self, request):
        # "<freq> <round_to_hz>" -- see Panadapter.request_tune.
        fields = request.split()
        if len(fields) < 2:
            return
        try:
            freq_hz = float(fields[0])
            round_to_hz = int(fields[1])
        except ValueError:
            return
        if round_to_hz > 1:
            freq_hz = round(freq_hz / round_to_hz) * round_to_hz
        else:
            freq_hz = round(freq_hz)
        freq_hz = max(VFO.low_frequency_limit, min(VFO.high_frequency_limit, freq_hz))
        base = 'FA' if self.receiver == 'main' else 'FB'
        Server.k4_server.send_cmds(f'{base}{freq_hz:011.0f};')

    def on_center_requested(self):
        # FC;/FC$; (K4 Programmer's Reference: "Center Panadapter for
        # target VFO") re-centers the radio's own PAN stream on the
        # current VFO -- there is no way to do this from software alone
        # the way click-to-tune moves the VFO instead, since the trace's
        # displayed frequencies come from the PAN stream's own center_hz
        # (see push_frame), not from the VFO.
        base = 'FC' if self.receiver == 'main' else 'FC$'
        Server.k4_server.send_cmds(f'{base};')

    def on_spot_requested(self):
        # #PANSPOT -- see Panadapter.on_autospot_button. SP3;/SP$3;
        # (main/sub), same split as FC;/FC$; above -- matches the
        # existing Main/Sub Autospot buttons on the CW tab (CW class).
        base = 'SP$3' if self.receiver == 'sub' else 'SP3'
        Server.k4_server.send_cmds(f'{base};')

    def on_vfo_action_requested(self, action):
        # "nudge <delta_hz>", sent identically for a Left/Right key
        # press and a single wheel notch -- see
        # Panadapter.request_vfo_action/_PanControlFilter. Dispatched
        # straight to the real VFO widget for this receiver
        # (VFO.instances) -- rather than re-deriving the current
        # frequency here -- so this behaves exactly as if the same
        # input had landed on the VFO control itself, including things
        # like TX/split coloring that live only on that widget.
        vfo = VFO.instances.get('B' if self.receiver == 'sub' else 'A')
        if vfo is None:
            return
        fields = action.split()
        if len(fields) < 2:
            return
        kind, arg = fields[0], fields[1]
        if kind == 'nudge':
            try:
                delta_hz = int(arg)
            except ValueError:
                return
            vfo.nudge_frequency(delta_hz)

    def on_span_requested(self, arg):
        # "<span_khz>" -- see Panadapter.request_span/_PanControlFilter.
        try:
            span_khz = int(arg)
        except ValueError:
            return
        span_khz = max(Panadapter.span_min_khz, min(Panadapter.span_max_khz, span_khz))
        base = '#SPN$' if self.receiver == 'sub' else '#SPN'
        Server.k4_server.send_cmds(f'{base}{span_khz * 1000};')

    def on_fps_requested(self, arg):
        # "<fps>" -- see Panadapter.request_fps. #FPS has no per-receiver
        # ($) variant -- it's one shared setting -- so this doesn't
        # branch on self.receiver the way on_span_requested does.
        try:
            fps = int(arg)
        except ValueError:
            return
        fps = max(Panadapter.fps_min, min(Panadapter.fps_max, fps))
        Server.k4_server.send_cmds(f'#FPS{fps:02d};')

    def on_frz_requested(self, arg):
        # "0" or "1" -- see Panadapter.request_freeze. #FRZ has no
        # per-receiver ($) variant either, same reason.
        if arg not in ('0', '1'):
            return
        Server.k4_server.send_cmds(f'#FRZ{arg};')

    def on_fxa_requested(self, arg):
        # "<value>" (0-5) -- see Panadapter.request_fixed_tune. 0-4 pick
        # a DDC Fixed Tune mode and engage it (#FXA;/#FXT1;); 5
        # ("Track") disengages fixed tune (#FXT0;) instead, with no
        # #FXA needed for that direction. Neither has a per-receiver
        # ($) variant, same reason as #FRZ/#FPS.
        try:
            value = int(arg)
        except ValueError:
            return
        if value == 5:
            Server.k4_server.send_cmds('#FXT0;')
        elif 0 <= value <= 4:
            Server.k4_server.send_cmds(f'#FXA{value};#FXT1;')

    def on_scale_requested(self, arg):
        # "<scale_db>" -- see Panadapter.request_scale. #SCL has no
        # per-receiver ($) variant either, same reason as #FRZ/#FPS.
        try:
            scale_db = int(arg)
        except ValueError:
            return
        scale_db = max(Panadapter.scale_min, min(Panadapter.scale_max, scale_db))
        Server.k4_server.send_cmds(f'#SCL{scale_db};')

    def _close_pipe(self):
        try:
            self.queue.put_nowait(None)
        except queue.Full:
            pass
        try:
            self.process.stdin.close()
        except (BrokenPipeError, ValueError, OSError):
            pass

    def stop(self, user_closed=False):
        self.stopping = True
        self._close_pipe()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()

        # monitor_thread is what actually reads the child's final
        # #PANGEOM line off stdout and emits exited -- by the time the
        # process has exited above, that line is already fully written
        # and flushed (the child does so before its own os._exit()), so
        # this join is short. It matters because exited is a queued
        # cross-thread signal: on_exited() (which does the real
        # Server.settings.put_save() for the geometry) only runs once
        # the Qt event loop gets a turn to deliver it. Without joining
        # and pumping here, that delivery could still be pending when
        # the whole app quits right after this returns (see
        # clean_up()), silently dropping the geometry save on exit --
        # the most common time a window's final geometry needs saving.
        self.monitor_thread.wait(2000)
        app = QApplication.instance()
        if app != None:
            app.processEvents()

class PanadapterChannel(QObject):
    # Reads the parent's messages off stdin on a thread and hands them to
    # the Qt thread, which is the only one that may touch the widgets.
    message = pyqtSignal(int, bytes)
    finished = pyqtSignal()

    def __init__(self, window):
        super().__init__()
        self.window = window
        self.message.connect(self.on_message)
        # Both go through signals rather than being acted on in the
        # reader thread: a queued signal is delivered on the Qt thread,
        # which is the only one allowed to touch widgets or end the
        # event loop. Calling QApplication.quit() from the reader thread
        # directly did not reliably exit.
        self.finished.connect(QApplication.instance().quit)
        # A QThread rather than a plain threading.Thread: this thread's
        # only job is emitting queued cross-thread signals (message/
        # finished, above), and it runs right up until the moment this
        # process exits when the window closes -- exactly when a foreign
        # (non-QThread) thread's Qt-internal per-thread bookkeeping gets
        # torn down via the OS's own TLS destructor ordering instead of
        # Qt's, which is what produces the "QThreadStorage: entry N
        # destroyed before end of thread" warnings seen on Windows.
        self.thread = QThread()
        self.thread.run = self.reader_loop

    def start(self):
        self.thread.start()

    def reader_loop(self):
        stream = sys.stdin.buffer
        while True:
            try:
                msg = panadapter_read_msg(stream)
            except (ValueError, OSError):
                msg = None
            if msg == None:
                break
            self.message.emit(msg[0], msg[1])
        # Parent closed the pipe (it is shutting us down, or it died).
        self.finished.emit()

    def on_message(self, msg_type, payload):
        try:
            if msg_type == panadapter_msg_pan:
                parsed = parse_pan_frame(payload)
                if parsed == None:
                    return
                receiver, center_hz, sample_rate, noise_floor, bins = parsed
                if receiver == self.window.receiver:
                    self.window.push_frame(center_hz, sample_rate, bins)
            elif msg_type == panadapter_msg_minipan:
                parsed = parse_minipan_frame(payload)
                if parsed == None:
                    return
                receiver, center_hz, sample_rate, noise_floor, bins = parsed
                if receiver == self.window.receiver:
                    self.window.push_minipan(center_hz, sample_rate, bins)
            elif msg_type == panadapter_msg_minipan_enabled:
                self.window.set_minipan_enabled(payload[0] != 0)
            elif msg_type == panadapter_msg_raise:
                self.window.raise_to_front()
            elif msg_type == panadapter_msg_cat:
                response = payload.decode(errors='replace')
                base = cmd_base(response)
                if base == '#FPS':
                    Panadapter.on_fps_changed(response)
                elif base == '#FRZ':
                    Panadapter.on_frz_changed(response)
                elif base == '#FXA':
                    Panadapter.on_fxa_changed(response)
                elif base == '#FXT':
                    Panadapter.on_fxt_changed(response)
                elif base == '#SCL':
                    Panadapter.on_scale_changed(response)
                elif base in ('#SPN', '#SPN$'):
                    Panadapter.on_span_changed(response)
                elif base in ('MD', 'MD$'):
                    Panadapter.on_mode_changed(response)
                elif base in ('BW', 'BW$'):
                    Panadapter.on_bandwidth_changed(response)
                elif base in ('FA', 'FB'):
                    Panadapter.on_frequency_changed(response)
                elif base in ('AR', 'AR$'):
                    Panadapter.on_antenna_changed(response)
                elif base == 'AN':
                    Panadapter.on_tx_antenna_changed(response)
                elif base == 'SB':
                    Panadapter.on_sub_receiver_changed(response)
        except Exception:
            traceback.print_exc(file=stderr)

def panadapter_child_main(receiver):
    # Entry point for the panadapter subprocess (--panadapter RX).
    Panadapter.child_mode = True

    app = QApplication(sys.argv)
    app.setStyle(CompactStyle(app.style()))

    # Read-only here: set_geometry() wants the saved geometry, and only
    # the parent ever writes this file (see Panadapter.save_geometry).
    Server.settings = Settings()

    window = Panadapter(receiver)
    Panadapter.windows[receiver] = window
    window.show()
    # See the matching comment in main(): set_geometry()'s move(), run
    # from Panadapter.__init__ before this show(), targets the window's
    # undecorated content rect -- but the WM only attaches its frame
    # once actually mapped, and that reparenting happens asynchronously
    # after show() returns, so re-running set_geometry() immediately
    # still races it. Deferring it to the next event loop iteration
    # instead runs it after the frame has actually landed; harmless to
    # call twice, and one-time only (this function runs once per child
    # process).
    for geo_delay in (100, 250, 500, 1000):
        QTimer.singleShot(geo_delay, window.set_geometry)
    # As if Ref had just been clicked, the first time the panadapter is
    # displayed -- see on_ref_button/_trigger_auto_ref for the other
    # triggers (mode/antenna/span change).
    window.on_ref_button()

    channel = PanadapterChannel(window)
    channel.start()

    app.exec()

    if Panadapter.child_geometry != None:
        try:
            sys.stdout.write(f'#PANGEOM {Panadapter.child_geometry}\n')
        except (BrokenPipeError, ValueError, OSError):
            pass

    if Panadapter.child_splitter_sizes != None:
        try:
            sys.stdout.write(f'#PANSPLIT {Panadapter.child_splitter_sizes}\n')
        except (BrokenPipeError, ValueError, OSError):
            pass

    # os._exit(), not a plain return: when the window is closed by the
    # user (rather than by the parent closing the pipe) the reader thread
    # is still parked in a blocking read on stdin, holding that file's
    # lock. Normal interpreter finalization then tries to close stdin
    # under it and aborts the process with "_enter_buffered_busy: could
    # not acquire lock ... at interpreter shutdown, possibly due to
    # daemon threads". Qt has already shut down by here and the flushes
    # below are what the parent is waiting for, so there is nothing left
    # that finalization needs to do.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.flush()
        except (BrokenPipeError, ValueError, OSError):
            pass
    os._exit(0)

class Audio():
    singleton = None
    input_channels = 1
    k4_input_channels = 2       # The K4 requires stereo, even though it transmits mono
    input_frame_size = 240
    maximum_output_frame_size = 1440
    output_channels = 2
    k4_sample_rate = 12000
    k4_frames_per_millisecond = k4_sample_rate // 1000
    k4_sample_rate_code = 0
    max_input_sample_rate = 48000
    max_output_sample_rate = 48000
    encode_mode_raw32 = 0
    encode_mode_raw16 = 1
    encode_mode_opus = 2
    encode_mode_opus_float = 3
    input_encode_mode = encode_mode_opus_float
    k4_muted = False
    server = None

    output_packet_counter = 0
    output_packet_qlen = 0
    output_dequeueing_packets = False

    receive_latency = None
    milliseconds_per_packet = 40        # default

    sidetone_min_packet_time = .003     # minimum packet time sending with straight key
    sidetone_rise_time = .005           # 5 ms rise time
    sidetone_fall_time = .033           # 33 ms fall time
    sidetone_rise_packet_perceived_ratio = .5
    sidetone_fall_packet_perceived_ratio = .5
    sidetone_enabled = True
    sidetone_stopped_time = time.perf_counter() - 1

    @classmethod
    def get_singleton(cls):
        if cls.singleton == None:
            cls.singleton = Audio()

        return cls.singleton

    @classmethod
    def close(cls):
        if cls.singleton == None:
            return

        self = cls.singleton

        Server.k4_server.unsubscribe_response('CW;', self.on_cw_pitch_change)
        Server.k4_server.unsubscribe_response('ML0;', self.on_sidetone_volume_change)

        self.transmit_audio = False
        if self.input_thread != None:
            self.input_thread.join()

        if self.straight_key_sidetone_thread != None:
            self.enable_straight_key_sidetone_loop = False
            self.sidetone_event.set()
            self.straight_key_sidetone_thread.join()

        if self.keyer_sidetone_thread != None:
            self.enable_keyer_sidetone_loop = False
            self.keyer_output_queue.put(None)
            self.keyer_sidetone_thread.join()

        if self.output_thread != None:
            self.server.output_audio_queue.put([])
            self.output_thread.join()

        if self.output_device_thread != None:
            self.output_device_queue.put([])
            self.output_device_thread.join()

    @classmethod
    def set_input_device_name(cls, name):
        self = cls.get_singleton()
        dev_info = self.input_device_info_by_name(name)
        if dev_info != None:
            self.input_device_index = dev_info['index']

    @classmethod
    def set_output_device_name(cls, name):
        self = cls.get_singleton()
        dev_info = self.output_device_info_by_name(name)
        if dev_info != None:
            self.output_device_index = dev_info['index']

    @classmethod
    def input_device_name(cls):
        self = cls.get_singleton()
        if self.input_device_index < 0:
            return "None available"
        dev_info = self.input_device_infos[self.input_device_index]
        return dev_info['name']

    @classmethod
    def output_device_name(cls):
        self = cls.get_singleton()
        if self.output_device_index < 0:
            return "None available"
        dev_info = self.output_device_infos[self.output_device_index]
        return dev_info['name']

    @classmethod
    def input_device_info(cls):
        self = cls.get_singleton()
        if self.input_device_index < 0:
            return None
        return self.input_device_infos[self.input_device_index]

    @classmethod
    def output_device_info(cls):
        self = cls.get_singleton()
        if self.output_device_index < 0:
            return None
        return self.output_device_infos[self.output_device_index]

    @classmethod
    def input_device_index(cls):
        self = cls.get_singleton()
        return self.input_device_index

    @classmethod
    def output_device_index(cls):
        self = cls.get_singleton()
        return self.output_device_index

    @classmethod
    def input_device_names(cls):
        self = cls.get_singleton()
        names = []
        for index in self.input_device_infos:
            device_info = self.input_device_infos[index]
            names.append(device_info['name'])
        return names

    @classmethod
    def output_device_names(cls):
        self = cls.get_singleton()
        names = []
        for index in self.output_device_infos:
            device_info = self.output_device_infos[index]
            names.append(device_info['name'])
        return names

    @classmethod
    def input_device_sample_rate(cls):
        self = cls.get_singleton()
        if self.input_device_index < 0:
            return None
        info = self.input_device_infos[self.input_device_index]
        return info['input_sample_rate']

    @classmethod
    def output_device_sample_rate(cls):
        self = cls.get_singleton()
        if self.output_device_index < 0:
            return None
        info = self.output_device_infos[self.output_device_index]
        return info['output_sample_rate']

    @classmethod
    def control_k4_cmd(cls, base, cmd):
        self = cls.get_singleton()
        cmd = cmd[len(base):]

        if base == 'AG':
            Server.settings.put_save('Audio', 'main_volume', cmd)
            self.a_volume = float(cmd) / 60.0
        elif base == 'AG$':
            Server.settings.put_save('Audio', 'sub_volume', cmd)
            self.b_volume = float(cmd) / 60.0
        elif base == 'MG':
            Server.settings.put_save('Audio', 'mic_gain', cmd)
            self.mic_gain = float(cmd) / 80.0
        elif base == 'SB':
            self.sub_on = cmd != '0'

        self.generate_sidetone_packets()

    @classmethod
    def local_audio_responses(cls):
        a_volume = Server.settings.get('Audio', 'main_volume')
        if a_volume == None:
            a_volume = '000'
        responses = 'AG' + a_volume + ';'

        b_volume = Server.settings.get('Audio', 'sub_volume')
        if b_volume == None:
            b_volume = '000'
        responses += 'AG$' + b_volume + ';'

        mic_gain = Server.settings.get('Audio', 'mic_gain')
        if mic_gain == None:
            mic_gain = '020'
        responses += 'MG' + mic_gain + ';'

        return responses

    @classmethod
    def server_connected(cls, server):
        self = cls.get_singleton()
        cls.server = server
        server.subscribe_responses('TR;', lambda response: self.on_transmit_changed(server, response), send=False)
        server.subscribe_response('MX;', lambda response: self.on_mx_changed(server, response), send=False)
        server.subscribe_received_initial_parameters(cls.on_received_initial_parameters)

    @classmethod
    def on_received_initial_parameters(cls, server):
        self = cls.get_singleton()
        latency = Server.settings.getint('Audio', 'remote_audio_latency', 3, minimum=0, maximum=7)
        cls.set_remote_audio_latency(latency)
        self.start_output_thread()

    @classmethod
    def set_remote_audio_latency(cls, latency):
        self = cls.get_singleton()
        if self.server and self.server.connected:
            self.server.send_str(f'SL{latency};')

    @classmethod
    def reset_output_packet_counter(cls):
        cls.output_dequeueing_packets = False
        cls.output_packet_counter = 1

    @classmethod
    def set_receive_latency(cls, latency):
        cls.receive_latency = latency
        cls.reset_output_packet_counter()

    @classmethod
    def start_sidetone(cls):
        if cls.singleton == None:
            return

        if not cls.sidetone_enabled:
            return

        self = cls.singleton
        self.starting_sidetone = True
        self.sidetone_event.set()

    @classmethod
    def stop_sidetone(cls):
        if cls.singleton == None:
            return

        if not cls.sidetone_enabled:
            return

        self = cls.singleton
        self.ending_sidetone = True
        cls.sidetone_stopped_time = time.perf_counter()
        self.sidetone_event.clear()

    @classmethod
    def drain_audio_queues(cls):
        self = cls.singleton

        while True:
            try:
                 self.output_device_queue.get_nowait()
            except queue.Empty:
                break
        while True:
            try:
                self.server.recv_queue.get_nowait()
            except queue.Empty:
                break

    @classmethod
    def mute_k4(cls):
        if cls.k4_muted:
            return

        cls.k4_muted = True
        while True:
            try:
                cls.server.output_audio_queue.get_nowait()
            except queue.Empty:
                break

        # Wait for any K4 audio packets to drain
        time.sleep(.0015)

    @classmethod
    def unmute_k4(cls):
        self = cls.singleton
        while True:
            try:
                 self.output_device_queue.get_nowait()
            except queue.Empty:
                break
        cls.k4_muted = False

    @classmethod
    def k4_is_muted(cls):
        if cls.k4_muted:
            return True
        if not Keyer.straight_keying:
            return False
        # if straight keying, mute for 100 ms, after sideton stops
        if (time.perf_counter() - cls.sidetone_stopped_time) < .1:
            return True
        return False

    @classmethod
    def enable_sidetone(cls, enable):
        cls.sidetone_enabled = enable

    @classmethod
    def send_sidetone_rise_packet(cls):
        self = cls.singleton
        self.keyer_output_queue.put(self.sidetone_rise_packet)
        rise_secs = self.seconds_per_sidetone_rise_packet
        delay = rise_secs * self.sidetone_rise_packet_perceived_ratio
        len = rise_secs * (1 -  self.sidetone_rise_packet_perceived_ratio)
        return delay, len

    @classmethod
    def send_sidetone_fall_packet(cls):
        self = cls.singleton
        self.keyer_output_queue.put(self.sidetone_fall_packet)
        len = self.seconds_per_sidetone_fall_packet * self.sidetone_fall_packet_perceived_ratio
        return len

    @classmethod
    def send_sidetone_cycle_packets(cls, seconds):
        self = cls.singleton
        seconds -= self.seconds_per_sidetone_rise_packet * self.sidetone_rise_packet_perceived_ratio
        seconds -= self.seconds_per_sidetone_fall_packet * self.sidetone_fall_packet_perceived_ratio
        cycles = round(seconds / self.seconds_per_sidetone_cycle)
        if Options.debug >= 1 and cycles < 1:
            dprint('element_lengthened')
        for i in range(cycles):
            self.keyer_output_queue.put(self.sidetone_cycle_packet)
        len = cycles * self.seconds_per_sidetone_cycle
        return len

    def pyaudio(cls):
        fd = os.dup(2)
        os.close(2)              # Close stderr because pyaudio outputs a lot of disquieting messages
        pa = pyaudio.PyAudio()
        os.dup2(fd, 2)           # restore stderr
        os.close(fd)
        return pa

    def pa_get_host_api_info_by_index(cls, pa, index):
        fd = os.dup(2)
        os.close(2)              # Close stderr because pyaudio outputs a lot of disquieting messages
        info = pa.get_host_api_info_by_index(index)
        os.dup2(fd, 2)           # restore stderr
        os.close(fd)
        return info

    def pa_is_format_supported(cls, pa, sample_rate, **kwargs):
        supported = False
        fd = os.dup(2)
        os.close(2)              # Close stderr because pyaudio outputs a lot of disquieting messages
        try:
            supported = pa.is_format_supported(sample_rate, **kwargs)
        except:
            pass
        os.dup2(fd, 2)           # restore stderr
        os.close(fd)
        return supported

    def __init__(self):
        self.input_stream = None
        self.output_stream = None
        self.input_thread = None
        self.output_thread = None
        self.output_device_thread = None
        # Deliberately shallow, to minimize audio delay when changing
        # frequency or going into transmit. Deepening this does not fix
        # panadapter-induced dropouts: during a main-thread stall
        # output_device_loop cannot run to drain the queue either, so
        # only PortAudio's own buffer (frames_per_buffer) keeps playing.
        self.output_device_queue = queue.Queue(2)
        self.keyer_output_queue = queue.Queue()
        self.input_device_index = -1
        self.output_device_index = -1
        self.input_device_infos = {}
        self.output_device_infos = {}
        self.sub_on = True
        self.ab = 'a.b'
        self.transmit_audio = False
        self.cw_pitch = 600
        self.sidetone_volume = 30
        self.straight_key_sidetone_thread = None
        self.keyer_sidetone_thread = None
        self.enable_straight_key_sidetone_loop = True
        self.enable_keyer_sidetone_loop = True
        self.sidetone_event = threading.Event()
        self.starting_sidetone = False
        self.ending_sidetone = False

        Server.k4_server.subscribe_response('CW;', self.on_cw_pitch_change)
        Server.k4_server.subscribe_response('ML0;', self.on_sidetone_volume_change)

        a_volume = Server.settings.get('Audio', 'main_volume')
        if a_volume == None:
            a_volume = '015'
        self.a_volume = float(a_volume) / 60.0

        b_volume = Server.settings.get('Audio', 'sub_volume')
        if b_volume == None:
            b_volume = '010'
        self.b_volume = float(b_volume) / 60.0

        mic_gain = Server.settings.get('Audio', 'mic_gain')
        if mic_gain == None:
            mic_gain = '040'
        self.mic_gain = float(mic_gain) / 80.0

        pa = self.pyaudio()
        info = self.pa_get_host_api_info_by_index(pa, 0)

        numdevices = info.get('deviceCount')

        try:
            default_input_device_index = pa.get_default_input_device_info()['index']
        except:
            default_input_device_index = None
        try:
            default_output_device_index = pa.get_default_output_device_info()['index']
        except:
            default_output_device_index = None

        for i in range(0, numdevices):
            info = pa.get_device_info_by_host_api_device_index(0, i)
            if info['name'] in [ 'dmix', 'lavrate', 'samplerate', 'speexrate', 'pulse', 'speex', 'upmix', 'vdownmix' ]:
                continue
            default_sample_rate = info['defaultSampleRate']

            input_device_info = { 'default_sample_rate': int(default_sample_rate), 'input_channels': 0 }

            begin_rate = Audio.k4_sample_rate
            end_rate = Audio.max_input_sample_rate + begin_rate
            step = begin_rate
            for input_sample_rate in range(begin_rate, end_rate, step):
                if self.pa_is_format_supported(pa, input_sample_rate,
                               input_device=info['index'],
                               input_channels=Audio.input_channels,
                               input_format=pyaudio.paFloat32):
                    input_device_info['index'] = info['index']
                    input_device_info['name'] = info['name']
                    input_device_info['input_channels'] = info['maxInputChannels']
                    input_device_info['input_sample_rate'] = input_sample_rate
                    if info['index'] == default_input_device_index or default_input_device_index == None:
                        self.input_device_index = info['index']
                    break

            if 'index' in input_device_info:
                self.input_device_infos[input_device_info['index']] = input_device_info
            elif Options.debug > 0:
                if self.pa_is_format_supported(pa, default_sample_rate,
                             input_device=info['index'],
                             input_channels=Audio.input_channels,
                             input_format=pyaudio.paFloat32):
                    dprint('Info:', info['name'], 'does not support multiple of K4 sample rate. supported rate:', default_sample_rate)

            output_device_info = { 'default_sample_rate': int(default_sample_rate), 'output_channels': 0 }

            begin_rate = Audio.k4_sample_rate
            end_rate = Audio.max_output_sample_rate + begin_rate
            step = begin_rate
            for output_sample_rate in range(begin_rate, end_rate, step):
                if self.pa_is_format_supported(pa, output_sample_rate,
                                   output_device=info['index'],
                                   output_channels=Audio.output_channels,
                                   output_format=pyaudio.paFloat32):
                    output_device_info['index'] = info['index']
                    output_device_info['name'] = info['name']
                    output_device_info['output_channels'] = info['maxOutputChannels']
                    output_device_info['output_sample_rate'] = output_sample_rate
                    if info['index'] == default_output_device_index or default_output_device_index == None:
                        self.output_device_index = info['index']
                    break

            if 'index' in output_device_info:
                self.output_device_infos[output_device_info['index']] = output_device_info
            elif Options.debug > 0:
                if self.pa_is_format_supported(pa, default_sample_rate,
                             output_device=info['index'],
                             output_channels=Audio.output_channels,
                             output_format=pyaudio.paFloat32):
                    dprint('Info:', info['name'], 'does not support multiple of K4 sample rate. supported rate:', default_sample_rate)

    def input_device_info_by_name(self, name):
        for index in self.input_device_infos:
            dev_info = self.input_device_infos[index]
            if dev_info['name'] == name:
                return dev_info
        return None

    def output_device_info_by_name(self, name):
        for index in self.output_device_infos:
            dev_info = self.output_device_infos[index]
            if dev_info['name'] == name:
                return dev_info
        return None

    def start_output_thread(self):
        if self.output_device_index < 0:
            return

        self.output_device_thread = threading.Thread(target=self.output_device_loop, name='audio_output_device_thread')
        self.output_device_thread.start()

        self.straight_key_sidetone_thread = threading.Thread(target=self.straight_key_sidetone_loop, name='audio_straight_key_sidetone_thread')
        self.straight_key_sidetone_thread.start()

        self.keyer_sidetone_thread = threading.Thread(target=self.keyer_sidetone_loop, name='audio_keyer_sidetone_thread')
        self.keyer_sidetone_thread.start()

        self.output_thread = threading.Thread(target=self.output_loop, name='audio_output_thread')
        self.output_thread.start()

    def output_loop(self):
        cls = self.__class__
        self.output_stream = None
        current_index = None
        warned = False

        while True:
            if not cls.output_dequeueing_packets and cls.output_packet_counter < cls.output_packet_qlen:
                time.sleep(.01)
                continue

            cls.output_dequeueing_packets = True
            packet = cls.server.output_audio_queue.get()
            if len(packet) == 0:
                return

            frame_size = packet[2] << 8 | packet[1]
            cls.milliseconds_per_packet = frame_size // self.k4_frames_per_millisecond
            cls.output_packet_qlen = cls.receive_latency // cls.milliseconds_per_packet

            if self.k4_is_muted():
                continue

            if current_index != self.output_device_index:
                current_index = self.output_device_index
                encode_mode = packet[0]
                if encode_mode != cls.encode_mode_opus_float:
                    raise Exception('Unsupported audio encode mode:', encode_mode)

                sample_rate = packet[3]
                if sample_rate != 0:
                    raise Exception('Unsupported audio sample rate:', sample_rate)

                opus = opuslib.Decoder(cls.k4_sample_rate, cls.output_channels)

                pa = self.pyaudio()

                if self.output_stream != None:
                    self.output_stream.close()
                    self.output_stream = None

                resample_ratio = int(cls.output_device_sample_rate() / cls.k4_sample_rate)

                retries = 2
                for retry in range(retries+1):
                    try:
                        self.output_stream = pa.open(format=pyaudio.paFloat32,
                                                channels=cls.output_channels,
                                                rate=cls.output_device_sample_rate(),
                                                frames_per_buffer=2,
                                                output=True,
                                                output_device_index=self.output_device_index,
                                                )
                        warned = False
                        break
                    except:
                        if retry >= retries:
                            if not warned:
                                Popup.warning('Failed to open: ' + self.output_device_name())
                                warned = True
                        continue

                current_value = Server.settings.getint('Audio', 'remote_audio_latency', 3, minimum=0, maximum=7)

            pcm = opus.decode_float(bytes(packet[4:]), self.maximum_output_frame_size)

            stereo = numpy.frombuffer(pcm, dtype=numpy.float32)
            a = stereo[0::2]                    # even samples are from the main receiver
            b = stereo[1::2]                    # odd samples are from the sub receiver

            a = a * self.a_volume * 32          # apply some amplification
            b = b * self.b_volume * 32

            if not self.sub_on:
                b = a                           # take all audio from main

                                                # Possible self.ab settings
                                                # a.b
                                                # ab.ab
                                                # a.-a
                                                # a.ab
                                                # ab.b
                                                # ab.a
                                                # b.ab
                                                # b.b
                                                # b.a
                                                # a.a
            leftsel, rightsel = self.ab.split('.')

            if leftsel == 'a':
                left = a
            elif leftsel == 'b':
                left = b
            elif leftsel == 'ab':
                left = (a + b) / 2

            if rightsel == 'b':
                right = b
            elif rightsel == 'a':
                right = a
            elif rightsel == 'ab':
                right = (a + b) / 2
            elif rightsel == '-a':
                right = -a

            if resample_ratio > 1:
                left = left.repeat(resample_ratio)
                right = right.repeat(resample_ratio)

            stereo = numpy.empty((left.size + right.size,), dtype=numpy.float32)
            stereo[0::2] = left
            stereo[1::2] = right
#            if Server.k4_server.k4_parameter('TR') == 'T':
#                log_packet('tx_output_left', left)
#                print_packet('received monitor', stereo)
            # send 1 ms at a time to permit timely sidetone generation
            millisecond_len = len(stereo) // self.milliseconds_per_packet
            for i in range(0, len(stereo), millisecond_len):
                if self.k4_is_muted():
                    break
                else:
                    ms_samples = stereo[i:i+millisecond_len]
                    self.output_device_queue.put(ms_samples.tobytes())

    def averaged_left_right_volume(self):
            a = self.a_volume
            b = self.b_volume

            if not self.sub_on:
                b = a                           # take all audio from main

                                                # Possible self.ab settings
                                                # a.b
                                                # ab.ab
                                                # a.-a
                                                # a.ab
                                                # ab.b
                                                # ab.a
                                                # b.ab
                                                # b.b
                                                # b.a
                                                # a.a
            leftsel, rightsel = self.ab.split('.')

            if leftsel == 'a':
                left = a
            elif leftsel == 'b':
                left = b
            elif leftsel == 'ab':
                left = (a + b) / 2

            if rightsel == 'b':
                right = b
            elif rightsel == 'a':
                right = a
            elif rightsel == 'ab':
                right = (a + b) / 2
            elif rightsel == '-a':
                right = a

            averaged_left_right_volume = (left + right) / 2
            return averaged_left_right_volume

    def straight_key_sidetone_loop(self):
        self.generate_sidetone_packets()
        elt_cycles = math.ceil(self.sidetone_min_packet_time / self.seconds_per_sidetone_cycle)

        while self.enable_straight_key_sidetone_loop:
            if not self.sidetone_event.is_set():
                if self.ending_sidetone:
                    self.output_device_queue.put(self.sidetone_fall_packet)
#                    log_packet('sidetone', self.sidetone_fall_packet)
#                    print_packet('fall', self.sidetone_fall_packet)
                    while not self.output_device_queue.empty():
                        time.sleep(.01)
                    self.ending_sidetone = False
                    Audio.unmute_k4()
                self.sidetone_event.wait()
            if self.starting_sidetone:
                Audio.drain_audio_queues()
                Audio.mute_k4()
                self.output_device_queue.put(self.sidetone_rise_packet)
#                log_packet('sidetone', self.sidetone_rise_packet)
#                print_packet('rise', self.sidetone_rise_packet)
                self.starting_sidetone = False
            elif self.enable_straight_key_sidetone_loop:
                elt_packet = self.sidetone_cycle_packet * elt_cycles
                self.output_device_queue.put(elt_packet)
#                log_packet('sidetone', elt_packet)
#                print_packet('elt', elt_packet)

    def keyer_sidetone_loop(self):
        while self.enable_keyer_sidetone_loop:
            packet = self.keyer_output_queue.get()
            if packet:
                self.output_device_queue.put(packet)

    def output_device_loop(self):
        while True:
            samples = self.output_device_queue.get()
            if len(samples) == 0:
                return
            if self.output_stream:
                self.output_stream.write(samples)

    def on_transmit_changed(self, server, response):
        transmit = server.k4_parameters.get('TR') == 'T'
        tune = server.k4_parameters.get('TU', "0") != '0'
        if transmit and not tune:
            split = server.k4_parameters.get('FT') == '1'
            if split:
                mode = server.k4_parameters.get('MD$')
            else:
                mode = server.k4_parameters.get('MD')

            if mode in ("1", "2", "4", "5"):        # LSB, USB, FM, AM
                # Discard queued audio
                while self.server.output_audio_queue.qsize() > 2:
                    self.server.output_audio_queue.get_nowait()

                if not self.transmit_audio:
                    self.transmit_audio = True
                    self.start_input_thread(server)

                return

        self.transmit_audio = False
        if self.input_thread != None:
            self.input_thread.join()
            self.input_thread = None

    def on_mx_changed(self, server, response):
        self.ab = response[2:].lower().rstrip(';')
        self.generate_sidetone_packets()

    def start_input_thread(self, server):
        if self.input_device_index < 0:
            return
        self.input_thread = threading.Thread(target=lambda: self.input_loop(server), name='audio_input_thread')
        self.input_thread.start()

    def input_loop(self, server):
        input_stream = None
        current_index = None
        warned = False

        while True:
            if current_index != self.input_device_index:
                current_index = self.input_device_index

                opus = opuslib.Encoder(Audio.k4_sample_rate, Audio.k4_input_channels, 'audio')

                pa = self.pyaudio()

                if input_stream != None:
                    input_stream.close()
                    input_stream = None

                retries = 2
                for retry in range(retries+1):
                    try:
                        input_stream = pa.open(format=pyaudio.paFloat32,
                                                channels=Audio.input_channels,
                                                rate=Audio.input_device_sample_rate(),
                                                frames_per_buffer=Audio.input_frame_size,
                                                input=True,
                                                input_device_index=self.input_device_index,
                                                )
                        warned = False
                        break
                    except:
                        if retry >= retries:
                            if not warned:
                                Popup.warning('Failed to open: ' + self.input_device_name())
                                warned = True
                        continue

                tries = 10
                for i in range(tries):
                    sampled = input_stream.read(Audio.input_frame_size, exception_on_overflow=False)
                    sampled = numpy.frombuffer(sampled, dtype=numpy.float32)
                    average = sum(numpy.abs(sampled)) / len(sampled)
                    if average != 0.0:
                        break
                    if i == tries-1:
                        Popup.warning("No input from audio device:\n  {name}".format(name=Audio.input_device_name()))
                        return

                resample_ratio = int(Audio.input_device_sample_rate() / Audio.k4_sample_rate)

            sampled = input_stream.read(Audio.input_frame_size * resample_ratio, exception_on_overflow=False)
            sampled = numpy.frombuffer(sampled, dtype=numpy.float32)

            if resample_ratio == 1:
                resampled = sampled
            elif resample_ratio == 2:
                s0 = sampled[0::2]
                s1 = sampled[1::2]
                resampled = (s0 + s1) / 2

            elif resample_ratio == 3:
                s0 = sampled[0::3]
                s1 = sampled[1::3]
                s2 = sampled[2::3]
                resampled = sum((s0, s1, s2)) / 3

            elif resample_ratio == 4:
                s0 = sampled[0::4]
                s1 = sampled[1::4]
                s2 = sampled[2::4]
                s3 = sampled[3::4]
                resampled = sum((s0, s1, s2, s3)) / 4

            resampled = resampled * self.mic_gain / 8  # apply some attenuation

            resampled = resampled.repeat(2)             # double-up samples. I consider this a K4 bug
            resampled_bytes = resampled.tobytes()

            frame_size = Audio.input_frame_size
            audio_packet = opus.encode_float(resampled_bytes, frame_size)

            if not self.transmit_audio:
                if input_stream != None:
                    input_stream.close()
                    input_stream = None
                return

            server.send_audio_packet(audio_packet, self.input_encode_mode, frame_size)

    def generate_sidetone_packets(self):
        sample_rate = Audio.output_device_sample_rate()
        samples_per_cycle = round(sample_rate / self.cw_pitch)
        seconds_per_cycle = samples_per_cycle / sample_rate
        samples_per_rise_time = math.ceil(sample_rate * self.sidetone_rise_time)
        samples_per_fall_time = math.ceil(sample_rate * self.sidetone_fall_time)
        cycles_per_rise_packet = math.ceil(samples_per_rise_time / samples_per_cycle)
        cycles_per_fall_packet = math.ceil(samples_per_fall_time / samples_per_cycle)
        samples_per_rise_packet = cycles_per_rise_packet * samples_per_cycle
        samples_per_fall_packet =  cycles_per_fall_packet * samples_per_cycle
        volume = self.sidetone_volume / 135 * self.averaged_left_right_volume()

        steps = numpy.linspace(0, 1, samples_per_cycle, endpoint=False, dtype=numpy.float32)
        cycle = numpy.sin(2 * numpy.pi * steps) * volume
        self.sidetone_cycle_packet = cycle.repeat(2).tobytes()

        rise_steps = numpy.linspace(0, 1, samples_per_rise_packet, dtype=numpy.float32)
        fall_steps = numpy.linspace(1, 0, samples_per_fall_packet, dtype=numpy.float32)
        rise_sin_samples = numpy.tile(cycle, cycles_per_rise_packet)
        fall_sin_samples = numpy.tile(cycle, cycles_per_fall_packet)
        rise_envelope = .5 * (1 - numpy.cos(numpy.pi * rise_steps))
        fall_envelope = .5 * (1 - numpy.cos(numpy.pi * fall_steps))
        rise_samples = (rise_sin_samples * rise_envelope).repeat(2)
        fall_samples = (fall_sin_samples * fall_envelope).repeat(2)
        self.sidetone_rise_packet = rise_samples.tobytes()
        self.sidetone_fall_packet = fall_samples.tobytes()

        self.sidetone_space_cycle = numpy.zeros(samples_per_cycle * 2, dtype=numpy.float32).tobytes()

        self.seconds_per_sidetone_cycle = seconds_per_cycle
        self.seconds_per_sidetone_rise_packet = seconds_per_cycle * cycles_per_rise_packet
        self.seconds_per_sidetone_fall_packet = seconds_per_cycle * cycles_per_fall_packet

    def on_cw_pitch_change(self, response):
        self.cw_pitch = int(response[2:].rstrip(';')) * 10
        self.generate_sidetone_packets()
        VailAdapter.send_pitch()

    def on_sidetone_volume_change(self, response):
        self.sidetone_volume = int(response[3:].rstrip(';'))
        self.generate_sidetone_packets()

class Settings():
    max_servers = 25

    cached_server_index = None
    cached_main_settings = None
    cached_platform_settings_dirname = None

    cached_reverse_mouse_wheel = None

    restart = False

    @classmethod
    def server_count(cls):
        return len(cls.k4_names())

    @classmethod
    def server_index(cls, index=None):
        if index != None:
            cls.cached_server_index = index
            return

        if cls.cached_server_index == None:
            cls.cached_server_index = cls.main().getint('Remote', 'server_index', 0)
        return cls.cached_server_index

    @classmethod
    def main(cls):
        if cls.cached_main_settings == None:
            cls.cached_main_settings = Settings('main')
        return cls.cached_main_settings

    @classmethod
    def k4_names(cls):
        names = []
        active_indexes = []
        for i in range(cls.max_servers):
            settings = Settings(i)
            name = settings.get(Server.k4_section, 'name', '')
            if name != '':
                names.append(name)
                active_indexes.append(i)
        if len(active_indexes) > 0 and len(names) != active_indexes[-1] + 1:
            cls.rename_files(active_indexes)
            return cls.k4_names()
        return names

    @classmethod
    def rename_files(cls, active_indexes):
        for i, index in enumerate(active_indexes):
            if i != index:
                os.rename(cls.settings_pathname(index), cls.settings_pathname(i))
                if cls.server_index() > i:
                    cls.server_index(cls.server_index()-1)
                    cls.main().put_save('Remote', 'server_index', Server.index)

    @classmethod
    def restarting(cls, restart=None):
        if restart != None:
            Settings.restart = restart
            return
        return Settings.restart

    @classmethod
    def platform_settings_dirname(cls):
        if cls.cached_platform_settings_dirname != None:
            return cls.cached_platform_settings_dirname

        if sys.platform == 'darwin':
            from AppKit import NSSearchPathForDirectoriesInDomains
            # http://developer.apple.com/DOCUMENTATION/Cocoa/Reference/Foundation/Miscellaneous/Foundation_Functions/Reference/reference.html#//apple_ref/c/func/NSSearchPathForDirectoriesInDomains
            # NSApplicationSupportDirectory = 14
            # NSUserDomainMask = 1
            # True for expanding the tilde into a fully qualified path
            config_dir = os.path.join(NSSearchPathForDirectoriesInDomains(14, 1, True)[0], appname)
        elif sys.platform == 'win32':
            config_dir = os.path.join(os.environ['APPDATA'], appname)
        elif sys.platform == 'linux':
            home_dir = os.path.expanduser('~')
            config_dir = os.path.join(home_dir, '.config')
            if os.path.isdir(config_dir):
                config_dir = os.path.join(config_dir, appname)
            else:
                config_dir = os.path.join(home_dir, '.' + appname)
        else:
            raise exception(f'{sys.platform} not supported.')

        if not os.path.isdir(config_dir):
            os.mkdir(config_dir, 0o755)

        cls.cached_platform_settings_dirname = config_dir
        return config_dir

    @classmethod
    def settings_pathname(cls, index):
        config_dir = cls.platform_settings_dirname()
        if index == 'main':
            suffix = ''
        else:
            suffix = f'-{index+1}'
        return os.path.join(config_dir,f'settings{suffix}.ini')

    @classmethod
    def reverse_mouse_wheel(cls):
        if cls.cached_reverse_mouse_wheel == None:
            cls.cached_reverse_mouse_wheel = Settings.main().getbool('Client', 'reverse_mouse_wheel', False)
        return cls.cached_reverse_mouse_wheel

    def __init__(self, index=None):
        self.settings = configparser.RawConfigParser()
        self.settings.optionxform = str
        self.settings_loaded = False
        self.settings_changed = False

        main_pathname = Settings.settings_pathname('main')
        if index == 'main':
            self.pathname = main_pathname
        else:
            main_settings = Settings.main()
            if index == None:
                index = main_settings.getint('Remote', 'server_index', 0)
                if index > Settings.server_count() or index >= Settings.max_servers:
                    index = 0
                    main_settings.put_save('Remote', 'server_index', index)
                Settings.server_index(index)
            self.pathname = Settings.settings_pathname(index)
            if index == 0:
                # Check for old settings.ini format
                if os.path.isfile(main_pathname) and not os.path.isfile(self.pathname):
                    if main_settings.settings.has_section('Elecraft K4'):
                        os.rename(main_pathname, self.pathname)
                        main_settings.clear()
                        main_settings.put_save('Remote', 'server_index', index)
        self.index = index
        self.load()

    def put(self, section, setting, value):
        if not self.settings_loaded and os.path.isfile(self.pathname):
            self.load()
        value = str(value)
        if not section in self.settings:
            self.settings[section] = {}
        previous_value = self.settings[section].get(setting, None)
        if value != previous_value:
            self.settings[section][setting] = value
            self.settings_changed = True

    def put_save(self, section, setting, value):
        self.put(section, setting, value)
        self.save()

    def get(self, section, setting, default=None):
        self.load()
        if section not in self.settings:
            return default
        if setting not in self.settings[section]:
            return default
        return self.settings[section][setting]

    def getbool(self, section, setting, default=None):
        return true_values(self.get(section, setting, default))

    def getint(self, section, setting, default=None, minimum=None, maximum=None):
        val = self.get(section, setting, default)
        if val != None:
            val = int(val)
            if minimum != None and val < minimum:
                val = minimum
            if maximum != None and val > maximum:
                val = maximum
        return val

    def getfloat(self, section, setting, default=None, minimum=None, maximum=None):
        val = self.get(section, setting, default)
        if val != None:
            val = float(val)
            if minimum != None and val < minimum:
                val = minimum
            if maximum != None and val > maximum:
                val = maximum
        return val

    def get_section(self, section):
        self.load()
        settings = {}
        try:
            for k, v in self.settings[section].items():
                settings[k] = v
        except:
            pass
        return settings

    def clear(self):
        for section in self.settings.sections():
            self.settings.remove_section(section)

    def clear_section(self, section):
        self.settings.remove_section(section)

    def save(self):
        if not self.settings_changed:
            return

        with open(self.pathname, 'w') as settingsfile:
            self.settings.write(settingsfile)
        self.settings_changed = False

    def load(self):
        if self.settings_loaded:
            return
        if self.index == 'main' and not os.path.isfile(self.pathname):
            self.put_save('Remote', 'server_index', 0)
        self.settings.read(self.pathname)
        self.settings_loaded = True

        # rename or remove obsolete options
        if self.index != 'main':
            main = Settings.main()
            name =  self.get('Audio', 'output_device_name')
            if name != None and not main.settings.has_option('Client', 'audio_output_device_name'):
                main.put_save('Client', 'audio_output_device_name', name)
            name =  self.get('Audio', 'input_device_name')
            if name != None and not main.settings.has_option('Client', 'audio_input_device_name'):
                main.put_save('Client', 'audio_input_device_name', name)

        if self.settings.has_option('Audio', 'output_device_name'):
            self.settings.remove_option('Audio', 'output_device_name')
            self.settings_changed = True
        if self.settings.has_option('Audio', 'input_device_name'):
            self.settings.remove_option('Audio', 'input_device_name')
            self.settings_changed = True
        if self.settings.has_option('Remote', 'restart'):
            self.settings.remove_option('Remote', 'restart')
            self.settings_changed = True
        if self.settings.has_section('command'):
            for option in self.settings.options('command'):
                value = self.get('command', option)
                if value != None:
                    self.put('Commands', option, value)

        # clean up obsolete categories
        if self.settings.remove_section('command'):
            self.settings_changed = True

        self.save()

    def unique_name(self, orig_name, new=False):
        names = list(Settings.k4_names())
        if not new and self.index < len(names):
            del names[self.index]
        name = orig_name
        for i in range(2, Settings.max_servers+1):
            if name not in names:
                break
            match = re.search(r'(.*) #\d+$', orig_name)
            if match != None:
                orig_name = match.group(1)
            name = f'{orig_name} #{i}'
        return name

    def remove_file(self):
        if os.path.exists(self.pathname):
            os.remove(self.pathname)

