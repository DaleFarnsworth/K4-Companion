class _DisplayOnlyLineEdit(QLineEdit):
    # A readonly QComboBox always ties its displayed text to an item in
    # its list -- but the Antenna widget needs to display strings (e.g.
    # its "=TX ANT" substitution) that aren't necessarily one of the
    # selectable options, the way ttk.Combobox.set() let the tkinter
    # version do. Making the combobox editable with this widget as its
    # line edit decouples the two: setCurrentText() (with insertPolicy
    # NoInsert) can show arbitrary text without adding a selectable item,
    # while read-only blocks typing. The one thing that costs is Qt's
    # normal readonly-combobox behavior of opening the popup on a click
    # anywhere in the box, rather than just on the arrow -- restored here
    # by forwarding a click to showPopup().
    def __init__(self, combobox):
        super().__init__(combobox)
        self.combobox = combobox
        self.setReadOnly(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.combobox.showPopup()
            event.accept()
            return
        super().mousePressEvent(event)

class Dropdown_Widget():
    def __init__(self, parent_frame, height=10, bd=2, padx=0, justify='left',
        font=None, fg=Default.fg, bg=Default.bg, abg=Default.abg,
        afg=Default.afg, selectbg=None, selectfg=None, state='readonly',
        display_only=False):
        if afg == None:
            afg = fg
        if selectbg == None:
            selectbg = bg
        if selectfg == None:
            selectfg = fg
        if font == None:
            font = qt_font(Default.label_font['family'], Default.label_font['size'], Default.label_font['weight'])

        self.justify = justify
        self.state = state
        self.parent_frame = parent_frame

        self.combobox = QComboBox()
        self.combobox.setFont(font)
        self.combobox.view().setFont(font)
        if display_only:
            self.combobox.setEditable(True)
            self.combobox.setLineEdit(_DisplayOnlyLineEdit(self.combobox))
            self.combobox.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)
        else:
            self.combobox.setEditable(state != 'readonly')
        self.combobox.setMaxVisibleItems(max(height, 10))
        self.combobox.setStyleSheet(
            f'QComboBox {{ background-color: {bg}; color: {fg}; }}'
            f'QComboBox QAbstractItemView {{ background-color: {selectbg}; color: {selectfg}; }}')
        qt_tighten_combobox_popup(self.combobox)
        if self.combobox.isEditable():
            self.combobox.lineEdit().setAlignment(qt_justify(justify))

    def value(self, value=None):
        if value != None:
            self.combobox.setCurrentText(str(value))
        return self.combobox.currentText()

    def index(self, index=None):
        if index != None:
            self.combobox.setCurrentIndex(index)
        return self.combobox.currentIndex()

    def values(self, values=None):
        if values != None:
            self.config(values=values)
        return [self.combobox.itemText(i) for i in range(self.combobox.count())]

    def select_callback(self, callback):
        self.combobox.activated.connect(lambda index: callback(None))
        if self.state != 'readonly' and self.combobox.lineEdit() != None:
            self.combobox.lineEdit().editingFinished.connect(lambda: callback(None))

    def grid(self, row=0, column=0, **opts):
        self.parent_frame.layout().addWidget(self.combobox, row, column,
            Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

    def config(self, **opts):
        if 'values' in opts:
            values = list(opts['values'])
            current = self.combobox.currentText()
            self.combobox.blockSignals(True)
            self.combobox.clear()
            self.combobox.addItems(values)
            # ttk.Combobox's displayed text is independent of its 'values'
            # option -- repopulating values never touched it in the
            # tkinter version. Restore it here too rather than only when
            # it happens to match a new item: a display_only combobox
            # (e.g. Antenna's "=TX ANT" substitution) shows text that's
            # never a real item by design, and would otherwise get
            # silently reset to whatever item addItems() auto-selects
            # every time its config is re-read (e.g. on 'ACM'/'ACS'
            # arriving right after 'AR'/'AR$' during startup).
            if current != '':
                self.combobox.setCurrentText(current)
            self.combobox.blockSignals(False)

class Antenna(Widget):
    def __init__(self, config_info, container):
        self.ar_names = ('None', 'RX2', '=TX ANT', 'x', 'RX1', 'ANT1', 'ANT2', 'ANT3')
        self.rx_names = ('None', 'ANT1', 'ANT2', 'ANT3', 'RX1', 'RX2', '=TX ANT')
        self.tx_names = ('x', 'ANT1', 'ANT2', 'ANT3')
        self.rx_select_bases = {'main':'AR', 'sub':'AR$'}

        required = ['item', 'type']
        optional = ['bd', 'bg', 'fg', 'selectbg', 'selectfg', 'justify', 'height',
            'font', 'label', 'leading', 'padx', 'pady']
        validate_options(config_info, required, optional)

        super().__init__(config_info, container)

        bd = config_info.get('bd', 2)
        selectbg = config_info.get('selectbg', self.bg)
        selectfg = config_info.get('selectfg', self.fg)
        justify = config_info.get('justify', 'left')
        height = config_info.get('height', 10)
        self.kind = config_info['type']

        if self.kind in ('main', 'sub', 'tx'):
            # 'main'/'sub' can display a value (the "=TX ANT" substitution
            # in on_k4_select_rx) that isn't one of their own selectable
            # items -- see _DisplayOnlyLineEdit.
            self.dropdown = Dropdown_Widget(self.frame, bd=bd, bg=self.bg,
                fg=self.fg, abg=self.abg, selectbg=selectbg, selectfg=selectfg,
                font=self.font(), justify=justify, height=height,
                display_only=self.kind in ('main', 'sub'))
            self.dropdown.grid(row=0, column=0)
        else:
            raise Exception(f'unknown type: {self.kind} in item antenna.')

        self.server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def on_received_initial_parameters(self, response):
        self.server.subscribe_responses('ACN1;ACN2;ACN3;ACN4;ACN5;', self.on_received_name)
        self.dropdown.select_callback(self.on_select)
        self.server.subscribe_response('AN;', self.on_k4_select_tx)

        if self.kind == 'tx':
            self.set_values_tx()
            self.server.subscribe_response('ACT;', self.on_k4_config_tx)
        elif self.kind == 'main':
            self.set_values_rx()
            self.server.subscribe_response('AR;', self.on_k4_select_rx)
            self.server.subscribe_response('ACM;', self.on_k4_config_rx)
        elif self.kind == 'sub':
            self.set_values_rx()
            self.server.subscribe_response('AR$;', self.on_k4_select_rx)
            self.server.subscribe_response('ACS;', self.on_k4_config_rx)

    def on_select(self, event):
        value = self.dropdown.value()
        if self.kind == 'tx':
            index = self.tx_short_names.index(value)
            cmd = f'AN{index};'
        else:
            index = self.rx_short_names.index(value)
            name = self.rx_names[index]
            ar_index = self.ar_names.index(name)
            cmd = f'{self.rx_select_bases[self.kind]}{ar_index};'
        self.server.send_cmds(cmd)

    def on_k4_select_rx(self, response):
        base = self.rx_select_bases[self.kind]
        ar_index = int(self.k4param(base))
        name = self.ar_names[ar_index]
        index = self.rx_names.index(name)
        value = self.rx_short_names[index]
        tx_index = int(self.k4param('AN'))

        if index == tx_index or value == '=TX ANT':
            value = self.tx_short_names[tx_index]

        self.dropdown.value(value)

    def on_k4_select_tx(self, response):
        if self.kind == 'tx':
            tx_index = int(self.k4param('AN'))
            value = self.tx_short_names[tx_index]
            self.dropdown.value(value)
        else:
            self.set_names()

    def on_k4_config_rx(self, response):
        self.set_values_rx()

    def on_k4_config_tx(self, response):
        self.set_values_tx()

    def set_names(self):
        self.tx_short_names = list(self.tx_names)
        for i in range(1, 4):
            name = self.k4param(f'ACN{i}')
            if name != '' and name != self.tx_names[i]:
                self.tx_short_names[i] = f'{i}:{name}'
            else:
                self.tx_short_names[i] = f'{self.rx_names[i]}'

        tx_index = int(self.k4param('AN'))
        self.rx_short_names = list(self.rx_names)

        for i in range(1, 6):
            tx = ' (TX)' if i == tx_index else ''
            name = self.k4param(f'ACN{i}')
            if name != '' and name != self.rx_names[i]:
                self.rx_short_names[i] = f'{i}:{name}{tx}'
            else:
                self.rx_short_names[i] = f'{i}:{self.rx_names[i]}{tx}'

        if self.kind == 'tx':
            self.set_values_tx()
        else:
            self.set_values_rx()

    def on_received_name(self, response):
        self.set_names()

    def set_values_rx(self):
        has_ATU = 'A' in self.k4param('OM')
        tx_ant = int(self.k4param('AN'))

        values = list(self.rx_short_names)
        if self.kind == 'main':
            mask = self.k4param('ACM')
        else:
            mask = self.k4param('ACS')
        if mask[0] == '0':
            for i in range(6, 0, -1):
                if not has_ATU and (i == 2 or i == 3) or mask[i] == '0':
                    values.pop(i)

        self.dropdown.values(values)

    def set_values_tx(self):
        has_ATU = 'A' in self.k4param('OM')
        if has_ATU:
            values = self.tx_short_names[1:]
            mask = self.k4param('ACT')
            if mask[0] == '0':
                for i in range(3, 0, -1):
                    if mask[i] == '0':
                        values.pop(i-1)
        else:
            values = self.tx_short_names[1:2]

        self.dropdown.values(values)

class TextButtons(Widget):
    def __init__(self, config_info, container):
        super().__init__(config_info, container)

        self.bd = config_info.get('bd', 2)
        # The OS's own default monospace font, rather than a specific
        # family name (e.g. "DejaVu Sans Mono") that may not be
        # installed on every platform.
        monospace_family = QFontDatabase.systemFont(QFontDatabase.SystemFont.FixedFont).family()
        self.monospaced_font = qt_font(monospace_family, self.font().pointSize())

        self.buttons = []
        self.config_buttons = []
        self.button_values = []
        self.button_labels = []
        self.button_width = None
        self.rows = None
        self.columns = None
        self.valid_characters = None

    def add_buttons(self, buttons, parent_frame, edit):
        layout = parent_frame.layout()
        while layout.count():
            item = layout.takeAt(0)
            widget = item.widget()
            if widget != None:
                widget.deleteLater()

        buttons_frame, buttons_grid = qt_group_box('', self.label_font())
        layout.addWidget(buttons_frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        for i in range(len(self.button_values), self.rows*self.columns):
            self.button_values.append('')
            self.button_labels.append('')

        buttons.clear()
        row = 0
        column = 0
        for i, value in enumerate(self.button_values):
            if row >= self.rows:
                break
            if i < 12:
                text = f'F{i+1}'
            else:
                text = ''
            small_font = scale_font(self.label_font(), 0.7)
            label_frame, label_grid = qt_group_box(text, small_font)
            buttons_grid.addWidget(label_frame, row, column, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
            button = QLineEdit()
            button.setFont(self.monospaced_font)
            button.setFixedWidth(self.button_width * QFontMetrics(self.monospaced_font).averageCharWidth())
            label_grid.addWidget(button, 0, 0)
            buttons.append(button)
            self.load_button_value(buttons, i, edit=edit)
            column += 1
            if column >= self.columns:
                row += 1
                column = 0

    def _show(self, parent, widget, row, col):
        parent.layout().addWidget(widget, row, col, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        widget.show()

    def _hide(self, parent, widget):
        parent.layout().removeWidget(widget)
        widget.hide()

    def _labeled_entry(self, parent_grid, row, col, label_text, value, width=2):
        frame = QWidget()
        frame_grid = QGridLayout(frame)
        frame_grid.setContentsMargins(0, 0, 0, 0)
        parent_grid.addWidget(frame, row, col, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        label = QLabel(label_text)
        label.setFont(self.font())
        label.setStyleSheet(f'background-color: {self.bg};')
        frame_grid.addWidget(label, 0, 0, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignTop)
        entry = QLineEdit(str(value))
        entry.setFont(self.font())
        entry.setStyleSheet('background-color: yellow;')
        entry.setFixedWidth(width * QFontMetrics(self.font()).averageCharWidth() + 12)
        frame_grid.addWidget(entry, 0, 1, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        return entry

    def add_config_vars(self, parent_frame):
        grid = parent_frame.layout()
        self.rows_entry = self._labeled_entry(grid, 0, 0, 'Button Rows:', self.rows)
        self.columns_entry = self._labeled_entry(grid, 0, 1, 'Button Columns:', self.columns)
        self.button_width_entry = self._labeled_entry(grid, 1, 0, 'Button Width:', self.button_width)

    def load_button_value(self, buttons, index, edit=False):
        value = self.button_values[index]
        label = self.button_labels[index]
        if label != '':
            value = f'{label} & {value}' if edit else label
        button = buttons[index]
        button.setText(value)
        if edit:
            button.setStyleSheet('background-color: yellow;')
            button.setReadOnly(False)
            button.setCursor(Qt.CursorShape.IBeamCursor)
        else:
            button.setStyleSheet(f'background-color: {self.bg};')
            button.setReadOnly(True)
            button.setCursor(Qt.CursorShape.PointingHandCursor)

    def button_label_value(self, button):
        value = button.text().strip()
        fields = value.split('&', 1)
        if len(fields) == 2:
            label, value = fields
            label = label.strip()
            value = value.strip()
        else:
            label = ''
        return label, value

    def store_button_value(self, buttons, index):
        button = buttons[index]
        label, value = self.button_label_value(button)
        self.button_labels[index] = label
        self.button_values[index] = value
        if label != '':
            value = label
        button.setReadOnly(False)
        button.setText(value)
        button.setStyleSheet(f'background-color: {self.bg};')
        button.setReadOnly(True)
        button.setCursor(Qt.CursorShape.PointingHandCursor)
        self.save_settings()

    def valid_button_value(self, buttons, i):
        button = buttons[i]
        label, value = self.button_label_value(button)
        for c in value:
            if c.upper() not in self.valid_characters:
                Popup.warning(f'Character "{c}" not allowed in Button {i+1}')
                self.load_button_value(buttons, i, edit=True)
                return False
        return True

    def valid_button_values(self, buttons):
        for i, button in enumerate(buttons):
            if not self.valid_button_value(buttons, i):
                return False
        return True

    def on_save_button(self):
        if not self.valid_button_values(self.config_buttons):
            return
        for i, button in enumerate(self.config_buttons):
            self.store_button_value(self.config_buttons, i)
        try:
            self.rows = int(self.rows_entry.text())
        except:
            self.rows_entry.setText(str(self.rows))
        try:
            self.columns = int(self.columns_entry.text())
        except:
            self.columns_entry.setText(str(self.columns))
        try:
            self.button_width = int(self.button_width_entry.text())
        except:
            self.button_width_entry.setText(str(self.button_width))

        self.add_buttons(self.buttons, self.buttons_frame, edit=False)
        self.add_buttons(self.config_buttons, self.config_buttons_frame, edit=True)

    def on_cancel_button(self):
        for i, button in enumerate(self.config_buttons):
            self.load_button_value(self.config_buttons, i, edit=True)
        self.rows_entry.setText(str(self.rows))
        self.columns_entry.setText(str(self.columns))
        self.button_width_entry.setText(str(self.button_width))
        self.add_buttons(self.buttons, self.buttons_frame, edit=False)
        self.add_buttons(self.config_buttons, self.config_buttons_frame, edit=True)

class CWText(QPlainTextEdit):
    # A scrolling, line-wrapping text buffer for CW send/decode display.
    # The tkinter version subclassed tk.Text directly and had to fight its
    # API: a 'disabled' widget blocks even *programmatic* insert/delete,
    # so every mutation had to save/restore the state around itself, and
    # trimming overflowed lines required a manual binary search over
    # bbox()/dlineinfo() to find where the first wrapped line ended.
    # QPlainTextEdit's readOnly only blocks *user* typing (programmatic
    # API calls always work), and QTextLayout already knows where each
    # visual line breaks, so both of those problems disappear.
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setLineWrapMode(QPlainTextEdit.LineWrapMode.WidgetWidth)

    def append(self, value):
        cursor = self.textCursor()
        cursor.movePosition(QTextCursor.MoveOperation.End)
        cursor.insertText(value)
        self.setTextCursor(cursor)
        self.ensureCursorVisible()

    def scroll_up(self):
        block = self.document().firstBlock()
        layout = block.layout()
        if layout != None and layout.lineCount() > 1:
            count = layout.lineAt(0).textLength()
        else:
            count = block.length()   # includes the block's trailing newline
        cursor = QTextCursor(self.document())
        cursor.setPosition(0)
        cursor.setPosition(count, QTextCursor.MoveMode.KeepAnchor)
        cursor.removeSelectedText()
        return count

    def text(self, clear=False):
        text = self.toPlainText()
        if clear:
            self.clear()
        return text

    def set(self, value):
        self.setPlainText(value)

class _CWKeyFilter(QObject):
    # CW's tkinter version routed *any* keypress within the window (while
    # the CW tab is active) to either the delayed-tx entry field or
    # straight to immediate keying, regardless of which widget visually
    # had focus -- achieved via a window-level <Key> binding. Qt delivers
    # key events only to the focused widget, so an application-wide event
    # filter is used here instead to reproduce the same "type anywhere to
    # key CW" behavior.
    def __init__(self, cw):
        super().__init__()
        self.cw = cw

    def eventFilter(self, obj, event):
        if event.type() != QEvent.Type.KeyPress:
            return False
        cw = self.cw
        if not cw.is_open or not cw.top_level.isVisible():
            return False
        # An application-wide filter sees events for every QObject, not
        # just QWidgets -- e.g. the QWindow backing a top-level widget --
        # and QWidget.isAncestorOf() only accepts a QWidget argument.
        if not isinstance(obj, QWidget):
            return False
        if not (obj is cw.top_level or cw.top_level.isAncestorOf(obj)):
            return False
        if cw.current_tabname != 'CW':
            return False
        if not cw.top_level.isActiveWindow():
            return False

        key = event.key()
        if Qt.Key.Key_F1 <= key <= Qt.Key.Key_F12:
            index = key - Qt.Key.Key_F1
            cw.send_button(index)
            return True

        if QApplication.focusWidget() == cw.entry_text:
            return cw.on_entry_text_modified(event)
        else:
            return cw.on_tx_text_modified(event)

class CW(TextButtons):
    tx_queue_max = 9
    tx_queue_low = 8
    singleton = None

    @classmethod
    def close_window(cls):
        if cls.singleton != None:
            cls.singleton.close()

    def __init__(self, config_info, container):
        required = ['item']
        optional = ['bd', 'bg', 'fg', 'font', 'label', 'leading', 'padx', 'pady',
                    'selectbg', 'selectfg']
        validate_options(config_info, required, optional)

        super().__init__(config_info, container)

        self.valid_characters = ' ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890-_,./?(+=%*!'

        self.load_settings()

        # Real value comes from the K4's reported keyer speed
        # (on_keyer_speed_change), but that arrives asynchronously -- a
        # user typing or sending a macro before it's received must not
        # crash Poll.call() with a None interval, so start with a sane
        # default instead of None.
        self.tx_poll_interval = 50

        self.tx_line_len = self.text_width
        self.tx_send_offset = 0
        self.tx_remaining_count = 0
        self.sending = False

        CW.singleton = self
        self.is_open = False
        self._key_filter = None

        self.delay_frame = None
        server = self.server
        server.subscribe_response('SDC;', self.on_qsk_changed)

        server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def open(self):
        if self.is_open:
            return
        self.is_open = True
        # Qt.WindowType.Window overrides QDialog's default Dialog type,
        # which most window managers treat as transient-for-parent and
        # force to stay above Page.top -- this lets the main window come
        # to the front instead. On Windows, though, giving it a parent at
        # all makes it a native "owned window", which Windows always
        # keeps above its owner in Z-order regardless of Qt window type
        # -- so there, only dropping the parent avoids the same
        # always-on-top behavior.
        self.top_level = QDialog(qt_top_level_parent(), Qt.WindowType.Window)
        self.top_level.setWindowTitle(Page.top.windowTitle() + ' CW')

        def _close_event(event):
            self.hide()
            event.ignore()
        self.top_level.closeEvent = _close_event

        self.frame = QWidget()
        frame_grid = QGridLayout(self.frame)
        dialog_layout = QVBoxLayout(self.top_level)
        dialog_layout.setContentsMargins(4, 4, 4, 4)
        dialog_layout.setSizeConstraint(QLayout.SizeConstraint.SetFixedSize)
        dialog_layout.addWidget(self.frame)

        self.notebook = self.notebook_frame(self.frame)
        frame_grid.addWidget(self.notebook, 0, 0)

        self.add_cw_tab()
        self.add_config_tab()

        self._key_filter = _CWKeyFilter(self)
        QApplication.instance().installEventFilter(self._key_filter)

        self.set_geometry()
        self.top_level.show()
        # See the matching comment in main(): move()/resize() before
        # show() targets the window's undecorated content rect, but the
        # WM only attaches its frame once the window is actually mapped
        # -- and that reparenting happens asynchronously, after show()
        # returns, so a move() issued immediately still races it. Redo
        # it deferred to the next event loop iteration instead, once
        # the frame has actually landed; harmless to call twice since it
        # just re-reads the same persisted geometry. One-time only
        # (open() itself is guarded by is_open), so this doesn't fight a
        # later user-dragged position.
        for geo_delay in (100, 250, 500, 1000):
            QTimer.singleShot(geo_delay, self.set_geometry)

    def add_cw_tab(self):
        self.cw_frame = QWidget()
        cw_grid = QGridLayout(self.cw_frame)
        self.add_tab(self.cw_frame, 'CW')

        self.main_enabled = False
        self.sub_enabled = False

        self.cw_controls_frame = QWidget()
        controls_grid = QGridLayout(self.cw_controls_frame)
        controls_grid.setContentsMargins(0, 0, 0, 0)
        cw_grid.addWidget(self.cw_controls_frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        self.add_cw_controls(self.cw_controls_frame)

        self.add_more_widgets(cw_grid)

        self.buttons_and_text_frame = QWidget()
        bat_grid = QGridLayout(self.buttons_and_text_frame)
        bat_grid.setContentsMargins(0, 0, 0, 0)
        cw_grid.addWidget(self.buttons_and_text_frame, 4, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)

        self.buttons_frame = QWidget()
        buttons_grid = QGridLayout(self.buttons_frame)
        buttons_grid.setContentsMargins(0, 0, 0, 0)
        bat_grid.addWidget(self.buttons_frame, 0, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        self.add_buttons(self.buttons, self.buttons_frame, edit=False)

        self.text_fields_frame = QWidget()
        text_fields_grid = QGridLayout(self.text_fields_frame)
        text_fields_grid.setContentsMargins(0, 0, 0, 0)
        bat_grid.addWidget(self.text_fields_frame, 1, 0, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
        self.add_text_fields(self.text_fields_frame)

        self.tx_send_offset = 0
        self.tx_remaining_count = 0
        self.sending = False

        self.server.subscribe_response('TD;', self.on_main_text_decode)
        self.server.subscribe_response('TD$;', self.on_sub_text_decode)
        self.server.subscribe_response('TB;', self.on_main_text_buffer)
        self.server.subscribe_response('TB$;', self.on_sub_text_buffer)
        self.server.subscribe_response('ACN1;', self.on_transmit_ack)
        self.server.subscribe_response('KS;', self.on_keyer_speed_change)

