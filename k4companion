        self.cmds = Server.settings.get(Server.k4_section, self.settings_key)
        if self.cmds == None:
            self.cmds = 'TS1;'
        self.entry.value(self.cmds)
        self.got_cmds()

    def save_settings(self):
        Server.settings.put_save(Server.k4_section, self.settings_key, self.cmds)

