class Poll():
    # callback -> QTimer. QTimer natively supports repeating/single-shot
    # intervals, so (unlike the old tkinter after()/after_cancel() version)
    # there's no need to manually reschedule from inside the callback.
    infos = {}
    top = None

    def set_top(top):
        # Kept for API compatibility with call sites written against the
        # tkinter-based Poll; QTimer no longer needs a root widget.
        Poll.top = top

    def add(interval, callback, repeat=True):
        Poll.remove(callback)
        timer = QTimer()
        timer.setSingleShot(not repeat)
        timer.timeout.connect(callback)
        timer.start(interval)
        Poll.infos[callback] = timer

    def remove(callback):
        timer = Poll.infos.pop(callback, None)
        if timer != None:
            timer.stop()

    def remove_all():
        for callback in list(Poll.infos):
            try:
                Poll.remove(callback)
            except:
                pass

    def call(interval, callback):
        Poll.add(interval, callback, repeat=False)

class MyOptionParser(optparse.OptionParser):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        super().set_usage(optparse.SUPPRESS_USAGE)

    def error(self, str):
        print('Usage: k4companion [options]\n')
        self.print_help()
        print()
        super().error(str)

class Options():
    config_file = None
    verbose = 0
    debug = 0
    yaml_file = None
    panadapter_receiver = None

    @staticmethod
    def Parse():
        parser = MyOptionParser(version=version)
        parser.add_option('-c', '--config', dest='config_file', default=None,
                          help="use config file FILE", metavar="FILE")
        parser.add_option('-v', '--verbose', action='count', dest='verbose', default = 0,
                          help="output additional status messages")
        parser.add_option('-d', '--debug', action='count', dest='debug', default=0,
                          help="output debugging messages")
        parser.add_option('--yaml', dest='yaml_file', default=None,
                          help="output YAML config to FILE", metavar="FILE")
        # Internal: how the main process starts a panadapter subprocess
        # (see PanadapterProcess). Not meant to be run by hand.
        parser.add_option('--panadapter', dest='panadapter_receiver', default=None,
                          help=optparse.SUPPRESS_HELP)
        (options, args) = parser.parse_args()

        Options.panadapter_receiver = options.panadapter_receiver

        Options.config_file = options.config_file
        Options.verbose = options.verbose
        Options.debug = options.debug
        Options.yaml_file = options.yaml_file

        if Options.debug > 0 and Options.verbose == 0:
            Options.verbose = Options.debug

        if len(args) != 0:
            parser.error("Unexpected argument '{arg}'".format(arg=args[0]))

        if Options.config_file == None and len(config_data.rstrip()) == 0:
            Options.config_file = 'k4companion.yaml'

def clean_up(exit=False):
    save_geometry()
    # CW/Macros close *before* the server is disconnected, not after --
    # CW.close() may still need to send a real command (stop_sending()'s
    # 'KY @;', if CW text was actively being sent when the main window
    # closed). Doing that after server.close()/exit() already set
    # self.connected = False made send_cmds() see a "disconnected" state
    # that was only ever true because clean_up() itself just forced it,
    # not a real connectivity problem -- which made warn_if_not_connected()
    # pop up a spurious "not connected" warning in the middle of shutting
    # down.
    CW.close_window()
    Macros.close_window()
    # Both of the above end with top_level.deleteLater(), which only
    # *schedules* the actual C++ destruction for the next event-loop
    # pass -- it does not run immediately. quit() (see exit(), below)
    # stops the loop right after this function returns, which can leave
    # that deferred deletion permanently pending. Forcing it to run now,
    # while the loop is still very much alive, avoids that race -- same
    # reasoning as PanadapterProcess.stop()'s own processEvents() call.
    # A plain processEvents() alone does NOT do this -- DeferredDelete
    # events are deliberately excluded from its normal event processing,
    # so they must be flushed explicitly via sendPostedEvents() first.
    QCoreApplication.sendPostedEvents(None, QEvent.Type.DeferredDelete)
    QApplication.instance().processEvents()

    server = Server.k4_server
    server.cancel_k4_subscriptions()
    if exit:
        server.exit()
    else:
        server.close()

    # Shut the panadapter subprocesses down explicitly, so their exit is
    # recorded as parent-driven rather than as the user closing the
    # window -- otherwise exiting would clear the persisted "was open"
    # flag that restore_open_windows() relies on next launch.
    PanadapterProcess.close_all()
    Audio.close()
    Poll.remove_all()

def exit():
    clean_up(exit=True)
    QApplication.instance().quit()

def save_geometry():
    top = Page.top
    geometry = f'{top.width()}x{top.height()}{top.x():+}{top.y():+}'
    Server.settings.put_save('Window', 'root.geometry', geometry)

class Popup(QDialog):
    queue = queue.Queue()
    poll_interval = 200          # 200 ms
    previous_popup = None

    @classmethod
    def show_popup(cls, msg, title, prefix, timeout, font, color, modal=False):
        if isinstance(msg, str):
            msg = [ prefix + msg ]
        else:
            msg[0] = prefix + msg[0]
        log_prefix = ''
        if prefix == '':
            log_prefix = 'Popup: '
        dprint(log_prefix + ' '.join(msg))
        msg = "\n\n".join(msg)
        popup = cls(title=title, timeout=timeout, font=font, color=color)
        label = QLabel(msg)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        label.setStyleSheet(f'QLabel {{ background-color: {color}; }}')
        label.setFont(popup.font_)
        popup.frame.addWidget(label, 0, 0)
        if modal:
            popup.show_and_wait()
        else:
            popup.show_popup_window()

    @classmethod
    def show_popups(cls):
        cls.remove_previous()
        cls.dequeue_popups()

    @classmethod
    def dequeue_popups(cls):
        while True:
            try:
                msg, title, prefix, timeout, font, color, modal = cls.queue.get_nowait()
                cls.show_popup(msg, title, prefix, timeout, font, color, modal)
            except queue.Empty:
                break

        Poll.call(cls.poll_interval, cls.dequeue_popups)

    @classmethod
    def popup(cls, msg='', title='', prefix='', timeout=None, font=None, color='yellow', modal=False):
        if threading.current_thread() == threading.main_thread():
            cls.show_popup(msg, title, prefix, timeout, font, color, modal)
        else:
            cls.queue.put((msg, title, prefix, timeout, font, color, modal))

    @classmethod
    def warning(cls, msg, timeout=2000, modal=False):
        cls.popup(msg=msg, title='Warning', prefix='Warning: ', timeout=timeout, font=None, color='yellow', modal=modal)

    @classmethod
    def error(cls, msg, timeout=5000, modal=False, font=None):
        cls.popup(msg=msg, title='Error', prefix='Error: ', timeout=timeout, font=font, color='yellow', modal=modal)

    @classmethod
    def modal(cls, msg, timeout=None, color='yellow'):
        cls.popup(msg=msg, title='K4-Companion', timeout=timeout, font=None, color=color, modal=True)

    @classmethod
    def remove_previous(cls):
        if cls.previous_popup != None:
            try:
                cls.previous_popup.close()
            except:
                pass
            cls.previous_popup = None

    def __init__(self, title='', timeout=None, font=None, color='yellow', modal=False):
        super().__init__(Page.top)
        self.__class__.remove_previous()
        if timeout == 0:
            timeout = None
        self.timeout = timeout
        self.setWindowTitle(title)
        if font == None:
            font = Page.main().font()
        self.font_ = font
        size = font.pointSize()
        self.frame = QGridLayout(self)
        self.frame.setContentsMargins(size * 2, size * 2, size * 2, size * 2)
        self.setStyleSheet(f'QDialog {{ background-color: {color}; }}')
        self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, True)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
        self.__class__.previous_popup = self

    def show_popup_window(self):
        self.show()
        if self.timeout != None:
            Poll.call(self.timeout, self.close)

    def show_and_wait(self):
        if self.timeout != None:
            Poll.call(self.timeout, self.close)
        self.exec()

    def password(msg='', title='', font=None, color='yellow'):
        if isinstance(msg, str):
            msg = [ msg ]
        msg = "\n\n".join(msg)
        popup = Popup(title=title, font=font, color=color, modal=True)
        if font == None:
            font = popup.font_

        label = QLabel(msg)
        label.setFont(font)
        label.setStyleSheet(f'QLabel {{ background-color: {color}; }}')
        popup.frame.addWidget(label, 0, 0, Qt.AlignmentFlag.AlignLeft)

        entry_frame = QWidget()
        entry_frame.setStyleSheet(f'background-color: {color};')
        entry_layout = QGridLayout(entry_frame)
        entry_layout.setContentsMargins(0, 0, 0, 0)
        popup.frame.addWidget(entry_frame, 1, 0, Qt.AlignmentFlag.AlignLeft)

        entry = QLineEdit()
        entry.setEchoMode(QLineEdit.EchoMode.Password)
        entry.setFont(font)

        # WA_DeleteOnClose means entry itself won't survive popup.close(),
        # so the result must be captured into this closure at submit time,
        # not read back from the (by-then-destroyed) widget afterward.
        result = ['']

        def password_entered():
            if entry.text() != '':
                result[0] = entry.text()
                popup.close()
        entry.returnPressed.connect(password_entered)
        entry_layout.addWidget(entry, 0, 0)

        show_button = QPushButton('Show')
        show_button.setFont(font)
        def password_button_clicked():
            if show_button.text() == 'Show':
                show_button.setText('Hide')
                entry.setEchoMode(QLineEdit.EchoMode.Normal)
            else:
                show_button.setText('Show')
                entry.setEchoMode(QLineEdit.EchoMode.Password)
        show_button.clicked.connect(password_button_clicked)
        entry_layout.addWidget(show_button, 0, 1)

        def submit_clicked():
            result[0] = entry.text()
            popup.close()
        submit_button = QPushButton('Submit')
        submit_button.setFont(font)
        submit_button.clicked.connect(submit_clicked)
        popup.frame.addWidget(submit_button, 2, 0, Qt.AlignmentFlag.AlignLeft)

