class NoSpaceValidator(QValidator):
    def validate(self, text, pos):
        if ' ' in text:
            return (QValidator.State.Invalid, text, pos)
        return (QValidator.State.Acceptable, text, pos)

class SteppedComboBox(QComboBox):
    # A plain DropdownWidget can't be installed as a Qt event filter (it's
    # not a QObject), so Up/Down-key stepping and (optionally) mouse-wheel
    # stepping are handled here instead by overriding keyPressEvent/
    # wheelEvent on the combobox itself.
    def __init__(self, on_step=None, on_wheel=None, parent=None):
        super().__init__(parent)
        self.on_step = on_step
        self.on_wheel = on_wheel

    def keyPressEvent(self, event):
        if self.on_step != None and event.key() in (Qt.Key.Key_Up, Qt.Key.Key_Down):
            self.on_step(event.key())
            return
        super().keyPressEvent(event)

    def wheelEvent(self, event):
        if self.on_wheel != None:
            self.on_wheel(event)
            return
        super().wheelEvent(event)

class DropdownWidget():
    def __init__(self, caller, frame, options):
        self.caller = caller
        self.server = caller.server

        texts = []
        self.text_to_index = {}

        self.index = 0

        self.selections = []

        self.bg = options['bg']
        self.fg = options['fg']

        font = options['font']
        justify = options.get('justify', 'right')
        height = options.get('height', 0)
        self.from_ = options.get('from', None)
        self.to = options.get('to', None)
        self.evalincrement = options.get('evalincrement', None)
        self.evalcmd = options.get('evalcmd', None)

        self.unexpected_response = options.get('unexpectedresponse', '')

        width = 0

        selection_options = options.get('selections', None)
        for index, sel_opt in enumerate(selection_options):
            index = len(self.selections)
            selection = {}

            required = []
            optional = ['text', 'cmd', 'evalcmd', 'response', 'evalresponse', 'bg']
            validate_options(sel_opt, required, optional, name='dropdownbutton.selection')

            text = sel_opt.get('text', '')
            selection['text'] = text
            texts.append(text)
            self.text_to_index[text] = index
            twidth = QFontMetrics(font).horizontalAdvance(text)
            if twidth > width:
                width = twidth

            cmd = sel_opt.get('cmd', None)
            orig_response = sel_opt.get('response', cmd)
            selection['response'] = orig_response

            selection['parameters'] = {}
            responses = self.server.expand_server_cmds(orig_response)
            for response in responses:
                base = cmd_base(response)
                response = response[len(base):]
                selection['parameters'][base] = response

            selection['cmd'] = cmd
            evalcmd = sel_opt.get('evalcmd', None)
            selection['evalcmd'] = evalcmd
            selection['evalresponse'] = sel_opt.get('evalresponse', None)
            bg = sel_opt.get('bg', None)
            if bg == None:
                bg = self.bg
            selection['bg'] = bg
            self.selections.append(selection)
        if sys.platform == 'win32':
            width += 5 * QFontMetrics(font).averageCharWidth()
        else:
            width += 3 * QFontMetrics(font).averageCharWidth()
            


        if height == 0:
            height = len(texts)

        self.defer_selections = False
        self.deferred_selection = False

        editable = self.evalcmd != None

        self.combobox = SteppedComboBox(
            on_step=self.on_increment if self.evalincrement != None else None,
            on_wheel=self.on_wheel_increment if self.evalincrement != None else None)
        self.combobox.addItems(texts)
        self.combobox.setFont(font)
        self.combobox.view().setFont(font)
        self.combobox.setEditable(editable)
        self.combobox.setMaxVisibleItems(max(height, 1))
        self.combobox.setMinimumWidth(width)
        self.set_bg(self.bg)
        qt_tighten_combobox_popup(self.combobox)

        if editable:
            line_edit = self.combobox.lineEdit()
            line_edit.setValidator(NoSpaceValidator(line_edit))
            line_edit.setAlignment(qt_justify(justify))
            line_edit.editingFinished.connect(self.update_value)

        self.combobox.activated.connect(self.on_combobox_selected)

        frame.layout().addWidget(self.combobox, 0, 0, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignTop)

        self.server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def set_bg(self, bg):
        # The native style's default QComboBox padding + drop-down arrow
        # width add a lot of blank horizontal space beyond what the text
        # itself needs (this is on top of setMinimumWidth() above, which
        # only sets a floor -- the box's actual width is whichever is
        # larger, and the native chrome alone was already bigger than
        # that floor). Tightening both here shrinks the visible padding.
        self.combobox.setStyleSheet(
            f'QComboBox {{ background-color: {bg}; color: {self.fg}; padding: 0px 1px 0px 2px; }}'
            'QComboBox::drop-down { width: 12px; }'
            f'QComboBox QAbstractItemView {{ background-color: {self.bg}; color: {self.fg}; }}')

    def on_received_initial_parameters(self, response):
        for selection in self.selections:
            self.server.subscribe_responses(selection['response'], self.on_response_received)

    def on_increment(self, key):
        value = float(self.combobox.currentText())
        if key == Qt.Key.Key_Down:
            value -= .00000000001       # account for incr vs decr
        else:
            value += .00000000001
        incr = float(self.caller.eval_value(self.evalincrement, value))
        if key == Qt.Key.Key_Down:
            incr = -incr
        value += incr
        self.set_value(value)

    def on_wheel_increment(self, event):
        # Same continuous stepping as the Up/Down keys (on_increment),
        # one on_increment step per wheel notch, rather than the
        # combobox's own default wheel behavior of cycling through only
        # the enumerated selections.
        mult = mouse_wheel_mult(event)
        if mult > 0:
            self.on_increment(Qt.Key.Key_Up)
        elif mult < 0:
            self.on_increment(Qt.Key.Key_Down)

    def set_value(self, value):
        if self.server.warn_if_not_connected():
            return

        if value < self.from_:
            value = self.from_
        elif value > self.to:
            value = self.to
        if self.evalcmd != None:
            cmd = self.caller.eval_value(self.evalcmd, value)
        # Updated locally right away, formatted the same way a real
        # response would be (reusing unexpected_response), rather than
        # waiting entirely on the radio's own echo to move the display
        # -- otherwise Up/Down/wheel stepping can visibly lag behind or
        # appear to do nothing between presses.
        if self.unexpected_response != '':
            self.set_val(str(self.caller.eval_value(self.unexpected_response, cmd)))
        self.server.expand_and_send_cmds(cmd)

    def update_value(self):
        text = self.combobox.currentText().strip()
        try:
            value = float(text)
        except:
            return

        self.set_value(value)

    def set_val(self, value):
        self.combobox.setCurrentText(str(value))

    def undefer_selections(self):
        self.defer_selections = False
        if self.deferred_selection:
            self.on_combobox_selected()

    def on_combobox_selected(self, index=None):
        if self.server.warn_if_not_connected():
            return

        text = self.combobox.currentText()
        if text == '':
            return

        if self.defer_selections:
            self.deferred_selection = True
            Poll.call(1500, self.undefer_selections)
            return

        self.deferred_selection = False

        index = self.text_to_index.get(text, None)
        if index != None:
            self.index = index
            selection = self.selections[self.index]
            cmd = selection['cmd']
            evalcmd = selection['evalcmd']
            if evalcmd != None:
                cmd = self.caller.eval_value(evalcmd)
            if cmd != None:
                self.server.expand_and_send_cmds(cmd)

        self.defer_selections = True
        Poll.call(1500, self.undefer_selections)

    def compare_parameters(self, selection, response):
        response = response.rstrip(';')
        response_base = cmd_base(response)
        response_parameter = cmd_parameter(response)

        text = selection['text']
        parameters = selection['parameters']
        for base in parameters.keys():
            if base == response_base:
                k4_parameter = response_parameter
            else:
                k4_parameter = self.server.k4_parameter(base)
            if selection['evalresponse'] != None and k4_parameter != None:
                k4_parameter = self.caller.eval_value(selection['evalresponse'], base + k4_parameter + ';')[len(base):].rstrip(';')
            dprint3('compare :{text} s: {s}, b: {b}'.format(text=text, s=k4_parameter, b=parameters[base]))
            if parameters[base] != k4_parameter:
                dprint3(text, 'No match')
                return False
        dprint3(text, 'Match')
        return True

    def on_response_received(self, response):
        found = False
        for index, selection in enumerate(self.selections):
            if self.compare_parameters(selection, response):
                self.index = index
                self.set_val(selection['text'])
                self.set_bg(selection['bg'])
                found = True
                return
        if not found:
            if self.unexpected_response != '':
                text = self.caller.eval_value(self.unexpected_response, response)
                text = str(self.caller.eval_value(self.unexpected_response, response))
            else:
                text = ''

            self.set_val(text)

