    @classmethod
    def set_dit_paddle_signal(cls, signal):
        cls.dit_paddle_signal = signal

    @classmethod
    def set_dah_paddle_signal(cls, signal):
        cls.dah_paddle_signal = signal

    @classmethod
    def set_dit_down_memory_delay(cls, seconds):
        cls.dit_down_memory_delay = seconds

    @classmethod
    def set_dit_up_memory_delay_percent(cls, percent):
        cls.dit_up_memory_delay_percent = percent

    @classmethod
    def set_dah_up_memory_delay_percent(cls, percent):
        cls.dah_up_memory_delay_percent = percent

    @classmethod
    def set_auto_char_space(cls, val):
        self = cls.singleton
        self.auto_char_space = val

    @classmethod
    def set_auto_word_space(cls, val):
        self = cls.singleton
        self.auto_word_space = val

    @classmethod
    def set_weighting(cls, val):
        self = cls.singleton
        if not self:
            return
        self.weighting = val
        self.on_speed_change()
        kp = Server.k4_server.k4_parameter('KP')
        Server.k4_server.send_str(f'KP{kp[0:2]}{round(self.weighting*100):03d};')

    def __init__(self):
        self.DIT_DOWN_EVENT = 'dit_down'
        self.DIT_UP_EVENT = 'dit_up'
        self.DAH_DOWN_EVENT = 'dah_down'
        self.DAH_UP_EVENT = 'dah_up'
        self.STRAIGHT_KEY_DOWN_EVENT = self.DIT_DOWN_EVENT
        self.STRAIGHT_KEY_UP_EVENT = self.DIT_UP_EVENT
        self.CLOSE_EVENT = 'close'

        self.delta = 0
        self.dit_was_down = False
        self.dah_was_down = False

        self.auto_char_space = Server.settings.getbool('CW', 'auto_char_space', False)
        self.auto_word_space = Server.settings.getbool('CW', 'auto_word_space', False)
        self.auto_char_space_dits = 2
        self.auto_word_space_dits = 5
        self.weighting = 1

        # for straight_key handling
        self.paddle_event_queue = queue.Queue()
        self.previous_key_down_timestamp = 0
        self.previous_key_up_timestamp = 0

        # for keyer handling
        self.paddle_timestamp = 0
        self.dit_down_timestamp = 0
        self.dit_up_timestamp = 0
        self.dah_down_timestamp = 0
        self.dah_up_timestamp = 0
        self.element_timestamp = 0
        self.end_element_timestamp = 0

        if self.keyer_thread:
            self.keyer_thread.join()

        self.keyer_thread = threading.Thread(target=self.keyer_loop, name='keyer_thread')
        self.keyer_thread.start()
        Server.k4_server.subscribe_received_initial_parameters(self.on_received_initial_parameters)

    def on_received_initial_parameters(self, response):
        self.weighting = Server.settings.getfloat('CW', 'weighting', 1.0)
        self.on_speed_change()

    def midi_message_callback(self, event, data=None):
        message, midi_delta_time = event
        event, status_byte, velocity = message
        dprint1(f'MIDI {event=:02x} status_byte={status_byte} {velocity=}')

        if midi_delta_time >= 0.001:
            self.midi_delta_time = midi_delta_time

        # 0xb0 is for the older MoMIDI spec, control change
        # 0xa0 is for the MoMIDI spec v0.1, polyphonic aftertouch
        if event == 0xb0 or event == 0xa0:
            self.delta = (velocity * 126) / 1000
            return

        if velocity == 0 or velocity == 127:    # No embedded time, use Midi delta time
            self.delta = midi_delta_time
            dprint1(f'midi delta={round(self.delta, 3)}')
        else:
            self.delta += velocity / 1000
            dprint1(f'event delta={round(self.delta, 3)}, midi delta={round(self.midi_delta_time, 3)}')

        if event == 0x90:                       # key down
            if status_byte in self.dit_paddle_notes:
                self.dit_was_down = True
                self.send_paddle_event(self.DIT_DOWN_EVENT, self.delta)
            elif status_byte in self.dah_paddle_notes:
                self.dah_was_down = True
                self.send_paddle_event(self.DAH_DOWN_EVENT, self.delta)
        elif event == 0x80:                     # key up
            if status_byte in self.dit_paddle_notes:
                if self.dit_was_down:
                    self.dit_was_down = False
                    self.send_paddle_event(self.DIT_UP_EVENT, self.delta)
            elif status_byte in self.dah_paddle_notes:
                if self.dah_was_down:
                    self.dah_was_down = False
                    self.send_paddle_event(self.DAH_UP_EVENT, self.delta)
        else:
            dprint1("unexpected event 0x%2x" % event)

        self.delta = 0

    def serial_message_callback(self, event):
        message, delta_time = event
        signal, asserted = message

        if signal == self.dit_paddle_signal:
            if asserted:
                self.send_paddle_event(self.DIT_DOWN_EVENT, delta_time)
            else:
                self.send_paddle_event(self.DIT_UP_EVENT, delta_time)

        if signal == self.dah_paddle_signal and not self.straight_keying:
            if asserted:
                self.send_paddle_event(self.DAH_DOWN_EVENT, delta_time)
            else:
                self.send_paddle_event(self.DAH_UP_EVENT, delta_time)

    def send_paddle_event(self, event, delta_time):
        if self.straight_keying:
            self.paddle_timestamp += delta_time
            timestamp = self.paddle_timestamp
        else:
            timestamp = time.perf_counter()
            if event == self.DIT_DOWN_EVENT:
                self.dit_down_timestamp = timestamp
            elif event == self.DIT_UP_EVENT:
                self.dit_up_timestamp = timestamp
            elif event == self.DAH_DOWN_EVENT:
                self.dah_down_timestamp = timestamp
            elif event == self.DAH_UP_EVENT:
                self.dah_up_timestamp = timestamp
        paddle_event = PaddleEvent(event, timestamp)
        self.paddle_event_queue.put(paddle_event)

    def keyer_loop(self):
        event = None
        while event != self.CLOSE_EVENT:
            if self.straight_keying:
                event = self.send_straight_key()
            elif self.keyer_mode == self.MODE_ULTIMATIC:
                event = self.send_ultimatic()
            else:
                event = self.send_iambic()

    def send_straight_key(self):
        paddle_event = self.paddle_event_queue.get()
        event = paddle_event.event
        if not self.straight_keying or event == self.CLOSE_EVENT:
            return event

        timestamp = paddle_event.timestamp

        if event == self.STRAIGHT_KEY_DOWN_EVENT:
            self.previous_key_down_timestamp = timestamp
            up_duration = timestamp - self.previous_key_up_timestamp
            milliseconds = round(up_duration * 1000)
            if milliseconds > 2500:
                milliseconds = 0
            Server.k4_server.send_str(f'KZD{milliseconds:04d};')
            Audio.start_sidetone()
        elif event == self.STRAIGHT_KEY_UP_EVENT:
            self.previous_key_up_timestamp = timestamp
            down_duration = timestamp - self.previous_key_down_timestamp
            milliseconds = round(down_duration * 1000)
            if milliseconds > 2500:
                milliseconds = 0
            elif milliseconds < 20:
# Very short key down times cause ADC overload
# I've seen it (rarely) at 40 ms, which is 30 WPM
# 20 milliseconds is approximately 60 WPM
                milliseconds = 20;
            Server.k4_server.send_str(f'KZU{milliseconds:04d};')
            Audio.stop_sidetone()

        return event

    def send_iambic(self):
        paddle_event = self.paddle_event_queue.get()
        event = paddle_event.event
        if (self.keyer_mode != self.MODE_IAMBIC and
            self.keyer_mode != self.MODE_IAMBIC_A and
            self.keyer_mode != self.MODE_IAMBIC_B) or event == self.CLOSE_EVENT:
            return event

        dit_up_memory_delay = (self.dit_up_memory_delay_percent / 100 *
                               (self.dah_seconds + self.inter_element_seconds))
        dah_up_memory_delay = (self.dah_up_memory_delay_percent / 100 *
                               (self.dit_seconds + self.inter_element_seconds))

        previous_elt = None

        while True:
            if (previous_elt == None or self.keyer_mode == self.MODE_IAMBIC):
                dit_mem = False
                dah_mem = False
            else:
                dit_mem = (previous_elt == '-' and
                           (self.dit_down_timestamp - previous_elt_timestamp) >
                           self.dit_down_memory_delay)
                dah_mem = False
                if self.keyer_mode == self.MODE_IAMBIC_B:
                    dit_mem = dit_mem or ((previous_elt == '-' and
                               (self.dit_up_timestamp - previous_elt_timestamp) >
                               dit_up_memory_delay))
                    dah_mem = dah_mem or ((previous_elt == '.' and
                               (self.dah_up_timestamp - previous_elt_timestamp) >
                               dah_up_memory_delay))
            previous_elt_timestamp = time.perf_counter()

            dit_now = self.dit_down_timestamp > self.dit_up_timestamp
            dah_now =  self.dah_down_timestamp > self.dah_up_timestamp
            dit = dit_now or dit_mem
            dah = dah_now or dah_mem

            first_element = previous_elt == None
            if not dit and not dah:
                self.send_element(None)
                return paddle_event.event

            if dit and dah:
                elt = '-' if previous_elt == '.' else '.'
            elif dit:
                elt = '.'
            elif dah:
                elt = '-'

            self.send_element(elt, first_element)

            previous_elt = elt

    def send_ultimatic(self):
        paddle_event = self.paddle_event_queue.get()
        event = paddle_event.event
        if self.keyer_mode != self.MODE_ULTIMATIC or event == self.CLOSE_EVENT:
            return event

        first_element = True
        while True:
            dit = self.dit_down_timestamp > self.dit_up_timestamp
            dah =  self.dah_down_timestamp > self.dah_up_timestamp
            if not dit and not dah:
                self.send_element(None)
                return paddle_event.event

            if dit and dah:
                dah_down_last = self.dah_down_timestamp > self.dit_down_timestamp
                elt = '-' if dah_down_last else '.'
            elif dit:
                elt = '.'
            elif dah:
                elt = '-'

            self.send_element(elt, first_element)
            first_element = False

    def send_element(self, elt, first_element=False):
        if elt:
            Audio.mute_k4()
        else:
            Audio.unmute_k4()
            return

        if (self.auto_char_space or self.auto_word_space) and first_element:
            time_since_last_char = time.perf_counter() - self.end_element_timestamp
            aws_min_seconds = self.auto_word_space_dits * self.dit_seconds
            acs_min_seconds = self.auto_char_space_dits * self.dit_seconds
            acs_time_remaining = self.inter_character_seconds - time_since_last_char
            aws_time_remaining = self.inter_word_seconds - time_since_last_char
            time_remaining = 0

            if self.auto_word_space and (time_since_last_char > aws_min_seconds):
                # wait an inter-character interval
                time_remaining = self.inter_word_seconds - time_since_last_char
            elif self.auto_char_space and (time_since_last_char > acs_min_seconds):
                # wait an inter-word interval
                time_remaining = self.inter_character_seconds - time_since_last_char
            if time_remaining > 0:
                time.sleep(time_remaining)

        if first_element:
            # Establish a baseline for timing later elements
            # to avoid cumulative errors
            self.element_timestamp = time.perf_counter()

        # queue sidetone element to output device
        rise_delay, rise_len = Audio.send_sidetone_rise_packet()
        element_seconds = self.dah_seconds if elt == '-' else self.dit_seconds
        cycles_len = Audio.send_sidetone_cycle_packets(element_seconds)
        fall_len = Audio.send_sidetone_fall_packet()

        if first_element:
            # The first element sent to the K4 is delayed so that each successive
            # element will be queued at the K4 before the previous element finishes
            time.sleep(.010)
        Server.k4_server.send_str(f'KZ{elt};')

        # calculate the time at which the sidetone ends
        element_end_delta = rise_delay + rise_len + cycles_len + fall_len
        self.end_element_timestamp = self.element_timestamp + element_end_delta

        # calculate the time to send the next element
        self.element_timestamp += element_seconds + self.inter_element_seconds
        element_sleep = self.element_timestamp - time.perf_counter()
        if element_sleep > 0:
            time.sleep(element_sleep)
        else:
            Popup.warning(msg='Keyer error')

    def on_speed_change(self, response=None):
        # The length of a dit in seconds is 1.2 / wpm,
        wpm = int(Server.k4_server.k4_parameter('KS'))
        delta = (1 - self.weighting) / (1 + self.weighting)
        elt_mult = 1 - delta
        space_mult = 1 + delta
        orig_dit_seconds = 1.2/wpm
        orig_dah_seconds = orig_dit_seconds * 3

        self.dit_seconds = orig_dit_seconds * elt_mult
        self.dah_seconds = orig_dah_seconds * elt_mult
        self.inter_element_seconds = orig_dit_seconds * space_mult
        self.inter_character_seconds = orig_dit_seconds * 3
        self.inter_word_seconds = orig_dit_seconds * 7

# A simple reversable string hash function
# Not in any way cryptographically secure
class Reversable_hash():
    @classmethod
    def rhash(cls, n):
        return "%08x" % (n * 387420489 % 4000000000)

    @classmethod
    def un_rhash(cls, h):
        return int(h, 16) * 3513180409 % 4000000000

    @classmethod
    def hash(cls, s):
        hashes = []
        for c in s:
            hashes.append(cls.rhash(ord(c)))
        return ''.join(hashes)

    @classmethod
    def unhash(cls, s):
        i = 0
        chars = []
        for i in range(0, len(s), 8):
            h = s[i:i+8]
            chars.append(chr(cls.un_rhash(h)))
        return ''.join(chars)

class Config():
    main_block_name = ' main'

    @staticmethod
    def preprocess(filename):
        self = Config()
        return self.process(filename)

    def process(self, filename):
        self.filename = filename
        self.blocks = {}
        self.errors = 0

        block_stack = []
        current_block = { 'name':Config.main_block_name, 'lines':[] }
        self.blocks[Config.main_block_name] = current_block
        in_block = False
        line_count = 0
        if filename != None:
            stream = open(filename)
        else:
            filename = 'variable:config_data'
            stream = io.StringIO(config_data)

        while True:
            line = stream.readline()
            if line == '':
                break
            line_count += 1
            match = re.search("^([ \t]*)#(define|end|include)([ \t]+([_A-Za-z][-_A-Za-z0-9]*)([ \t]*)(.*)$)?", line)
            if not match:
                current_block['lines'].append(line)
            else:
                indent = match.group(1)
                directive = match.group(2)
                after_directive = match.group(3)
                block_name = match.group(4)
                trailing = match.group(6)
                if directive == 'define':
                    if indent != '':
                        dprint('Error ({filename}:{line_count}): #define must be in column 1'.format(filename=filename, line_count=line_count))
                        self.errors += 1
                        continue
                    elif block_name == None:
                        dprint('Error ({filename}:{line_count}): Invalid block name after #define'.format(filename=filename, line_count=line_count))
                        self.errors += 1
                        continue
                    elif trailing != '':
                        dprint('Error ({filename}:{line_count}): unexpected characters after #define {name}'.format(filename=filename, line_count=line_count, name=block_name))
                        self.errors += 1
                        continue
                    elif in_block:
                        pname = current_block['name']
                        dprint('Error ({filename}:{line_count}): #define {name}, encountered while defining {pname}'.format(filename=filename, line_count=line_count, name=block_name, pname=pname))
                        self.errors += 1
                        continue
                    elif block_name in self.blocks:
                        dprint('Error ({filename}:{line_count}): #define {name}, redefined. Previously defined at line {pline_count}'.format(filename=filename, line_count=line_count, name=block_name, pline_count=self.blocks[block_name]['line_count']))
                        self.errors += 1
                        continue

                    block_stack.append(current_block)
                    current_block = { 'name':block_name, 'lines':[], 'line_count':line_count }
                    self.blocks[block_name] = current_block
                    in_block = True
                elif directive == 'end':
                    if not in_block:
                        dprint('Error ({filename}:{line_count}): #end encountered while not defining a block'.format(filename=filename, line_count=line_count))
                        self.errors += 1
                        continue
                    elif after_directive != None:
                        dprint('Error ({filename}:{line_count}): extra characters found after #end'.format(filename=filename, line_count=line_count))
                        self.errors += 1
                        continue
                    current_block = block_stack.pop()
                    if current_block['name']:
                        in_block = False
                elif directive == 'include':
                    if block_name == None:
                        dprint('Error ({filename}:{line_count}): Invalid block name after #include'.format(filename=filename, line_count=line_count))
                        self.errors += 1
                        continue
                    elif trailing != '':
                        dprint('Error ({filename}:{line_count}): unexpected characters after #include {name}'.format(filename=filename, line_count=line_count, name=block_name))
                        self.errors += 1
                        continue
                    line = { 'indent':indent, 'block_name':block_name, 'line_count':line_count }
                    current_block['lines'].append(line)

        stream.close()

        if in_block:
            block_name = current_block['name']
            dprint('Error ({filename}:{line_count}): End of file while defining block {block_name}'.format(filename=filename, line_count=line_count, block_name=block_name))
            self.errors += 1

        self.writing_blocks = {}
        indents = []

        if Options.yaml_file != None:
            with open(Options.yaml_file, 'w') as stream:
                if Options.config_file == None:
                    # Write out the internally-contained yaml file
                    stream.write(config_data)
                else:
                    # Write out the preprocessed yaml file
                    self.write_block(stream, Config.main_block_name, '', 1)
        else:
            tmpfile = tempfile.TemporaryFile(mode='w+')
            self.write_block(tmpfile, Config.main_block_name, '', 1)

        if self.errors > 0:
            sys.exit()

        if Options.yaml_file != None:
            sys.exit()

        tmpfile.seek(0)
        return tmpfile

    def write_block(self, file, block_name, indent, line_count):
        if block_name in self.writing_blocks:
            previous_line_count = self.writing_blocks[block_name]
            dprint('Error ({filename}:{line_count}): #include {block_name}, recursively included, previously at {previous_line_count}'.format(filename=self.filename, line_count=line_count, block_name=block_name, previous_line_count=previous_line_count))
            self.errors += 1
            sys.exit()

        self.writing_blocks[block_name] = line_count

        block = self.blocks[block_name]
        for line in block['lines']:
            if isinstance(line, str):
                if line != "\n":
                    line = indent + line
                file.write(line)
            else:
                block_name = line['block_name']
                if block_name not in self.blocks:
                    line_count = line['line_count']
                    dprint('Error ({filename}:{line_count}): #include of undefined block {block_name}.'.format(filename=self.filename, line_count=line_count, block_name=block_name))
                    self.errors += 1
                    continue

                self.write_block(file, block_name, indent + line['indent'], line_count)

        del self.writing_blocks[block['name']]

def read_config(config_file_name):
    with Config.preprocess(config_file_name) as stream:
        try:
            config = yaml.safe_load(stream)
        except yaml.YAMLError as exc:
            dprint(exc)

        for config_info in config:
            item = config_info['item']
            if item == 'page':
                Page(config_info)
            elif item == 'server':
                Server(config_info)
            elif item == 'defaults':
                Default(config_info)
            else:
                raise Exception("Unexpected top level item '{item}' in '{filename}'.".format(item=item, filename=config_file_name))

